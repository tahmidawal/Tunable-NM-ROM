    30	def transition(eX, eY, eps, eligible=None, qualified=(True, True)):
    31	    """6.1a (AM-7): X -> Y improves / does not improve / inconclusive (precedence: unqualified, empty, resolution)."""
    32	    if not all(qualified):
    33	        return 'inconclusive (unqualified cell)', None
    34	    p = paired(eX, eY, eps, eligible)
    35	    if p['n_eligible'] == 0:
    36	        return 'inconclusive (no eligible cases)', p
    37	    if p['n_resolved'] < 0.5 * p['n_eligible']:
    38	        return 'inconclusive (resolution)', p
    39	    if p['improve'] > 0.5 * p['n_resolved'] and p['median_change'] < 0:
    40	        return 'improves', p
    41	    return 'does not improve', p
