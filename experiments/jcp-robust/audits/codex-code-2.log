   219	
   220	def pinned_sha(src):
   221	    """sha256 pinned by the owning lane's own listing: ('p1', mesh, name) or ('qualify', job, name)."""
   222	    lane, job, name = src
   223	    if lane == 'p1':
   224	        lst, key = P1RUNS / job / 'archive' / 'OUTPUTS.sha256', f'output/p1acc_{job}/{name}'
   225	    else:
   226	        lst, key = QLIST / job / 'archive.sha256-listing', f'./output/qacc_{job}/{name}'
   227	    for line in lst.read_text().splitlines():
   228	        h, f = line.split(None, 1)
   229	        if f.strip() == key:
   230	            return h
   231	    raise KeyError(src)
   232	
   233	
   234	def source_path(src, fetched):
   235	    lane, job, name = src
   236	    if lane == 'p1':
   237	        return P1RUNS / job / 'archive' / 'output' / f'p1acc_{job}' / name
   238	    return Path(fetched) / job / 'output' / f'qacc_{job}' / name if fetched else None
   239	
   240	
   241	def e1_sources(mesh, arm):
   242	    """A2.1 archive map for draw 0 of the R128 fib4181 arms."""
   243	    if arm in ('LSPG_BE_1', 'LSPG_CNR_1'):
   244	        nm = 'R_R128_BE.npz' if arm == 'LSPG_BE_1' else 'R_R128_CNR.npz'
   245	        src = [('p1', f'acc{mesh}', nm)]
   246	        if mesh == 4096:
   247	            src.append(('qualify', 'acc4096', f'R_R128_{arm}.npz'))
   248	        return src
   249	    return [('qualify', f'acc{mesh}', f'R_R128_{arm}.npz')]
   250	
   251	
   252	def reproduce(W_new, ids, sources, fetched, want_ids):
   253	    """Per case relative max-norm of W_new vs the archived production W (<= 1e-10); every expected case present; each
   254	    archive file's sha256 equals its owning lane's pin; finite, nonzero archives."""
   255	    if list(ids) != list(want_ids):
   256	        return dict(passed=False, reason='new output does not hold the registered population')
   257	    got, files = {}, []
   258	    for src in sources:
   259	        fp = source_path(src, fetched)
   260	        if fp is None or not fp.exists():
   261	            return dict(passed=False, reason=f'archive file unavailable: {src}')
   262	        h = hashlib.sha256(fp.read_bytes()).hexdigest()
   263	        if h != pinned_sha(src):
   264	            return dict(passed=False, reason=f'archive hash differs from the pin: {src}')
   265	        files.append(dict(src=list(src), sha256=h))
   266	        a = np.load(fp)
   267	        for j, cid in enumerate(a['case_ids']):
   268	            got.setdefault(str(cid), np.asarray(a['W'][j]))
   269	    rows = []
   270	    for j, cid in enumerate(ids):
   271	        if cid not in got:
   272	            return dict(passed=False, reason=f'case {cid} missing from the archives', files=files)
   273	        Wa, Wn = got[cid], np.asarray(W_new[j])
   274	        den = float(np.max(np.abs(Wa))) if np.isfinite(Wa).all() else 0.
   275	        if den == 0 or Wa.shape != Wn.shape:
   276	            return dict(passed=False, reason=f'zero, non-finite or mis-shaped archive at {cid}', files=files)
   277	        rows.append(float(np.max(np.abs(Wn - Wa)) / den) if np.isfinite(Wn).all() else math.inf)
   278	    return dict(passed=bool(rows and max(rows) <= 1e-10), worst=max(rows), n=len(rows), files=files)
   279	
   280	
   281	def controls(res, g, mesh):
   282	    import rules2d
   283	    gname = g['name']
   284	    c = res['groups'][gname].get('controls', {})
   285	    meta = res['groups'][gname]['rules']
   286	    r = {}
   287	    if 'd0' in meta and 'd1' in meta:                              # G-E1.1
   288	        X0, w0 = rules2d.points('fib4181')
   289	        Xs, ws = rules2d.points('fib4181s0')
   290	        X1, _ = rules2d.points('fib4181s1')
   291	        sh = (X1 - X0) % 1.0
   292	        dep = hashlib.sha256(np.ascontiguousarray(np.concatenate([X0.ravel(), w0])).tobytes()).hexdigest()
   293	        r['G-E1.1'] = dict(s0_equals_deployed=bool(np.array_equal(X0, Xs) and np.array_equal(w0, ws)),
   294	                           job_sha_equals_deployed=bool(meta['d0']['meta']['rule_sha256'] == dep),
   295	                           s1_pure_shift=bool(np.ptp((sh - sh[0] + .5) % 1.0, axis=0).max() < 1e-12),
   296	                           s1_differs=bool(not np.array_equal(X1, X0)))
   297	        r['G-E1.1']['passed'] = all(r['G-E1.1'].values())
   298	    if g.get('permute'):
   299	        p = c.get('permute')
   300	        r['G-E1.3'] = dict(p, passed=bool(p and p.get('passed'))) if p else dict(passed=False, reason='missing')
   301	    if g.get('identity'):
   302	        i_ = c.get('identity')
   303	        r['C-E1.2'] = dict(i_, fired=bool(i_ and i_.get('raised'))) if i_ else dict(fired=False, reason='missing')
   304	    if g.get('fixture'):
   305	        ef = HERE / 'checks' / 'establish-e1.json'
   306	        pans = [p for p in json.loads(ef.read_text())['panels'] if p['panel'].startswith('2d|')] if ef.exists() else []
   307	        job = c.get('fixture', {}).get('bad', {}).get('rho_tgt')
   308	        if not pans:
   309	            r['C-E1.1'] = dict(admitted=False, fired=False, reason='establishment missing (control unavailable)')
   310	        else:
   311	            r['C-E1.1'] = E.fixture_fired(pans[0]['states'], job)
   312	            r['C-E1.1'].update(cpu=[s_['rho_tgt'] for s_ in pans[0]['states']], job=job,
   313	                               deployed_draw_rho_tgt=c.get('fixture', {}).get('d0', {}).get('rho_tgt'))
   314	    return r
   315	
