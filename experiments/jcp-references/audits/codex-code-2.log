   276	def u_transforms():
   277	    """Mode-by-mode check of pscore's synthesis/analysis against direct O(n^2) NumPy sums (independent of the FFT path)."""
   278	    rng = np.random.default_rng(3)
   279	    worst = 0.0
   280	    for M in (6, 12, 17):
   281	        b = rng.standard_normal(M - 1)
   282	        j = np.arange(1, M)
   283	        k = np.arange(1, M)
   284	        Sd = np.sin(np.pi * np.outer(j, k) / M) @ b
   285	        Cd = np.cos(np.pi * np.outer(j, k) / M) @ b
   286	        Ad = (2.0 / M) * np.sin(np.pi * np.outer(k, j) / M) @ b
   287	        Sp = np.asarray(PS.sine_synth_last(jnp.asarray(b), M))
   288	        Cp = np.asarray(PS.cos_synth_last(jnp.asarray(b), M))
   289	        Ap = np.asarray(PS.analysis(jnp.asarray(b), M))
   290	        worst = max(worst, *(float(np.max(np.abs(x - y)) / np.max(np.abs(y))) for x, y in ((Sp, Sd), (Cp, Cd), (Ap, Ad))))
   291	    # 2D derivative synthesis and lattice synthesis against direct sums
   292	    N, M = 6, 9
   293	    bb = rng.standard_normal((N - 1, N - 1))
   294	    k = np.arange(1, N)
   295	    x = np.arange(1, M) / M
   296	    S, Cx = np.sin(np.pi * np.outer(x, k)), np.cos(np.pi * np.outer(x, k))
   297	    u_d = S @ bb @ S.T
   298	    g_d = (Cx * (np.pi * k)) @ bb @ S.T + S @ bb @ (Cx * (np.pi * k)).T
   299	    nb, _ = PS.nonlinear(jnp.asarray(bb), N, 2)
   300	    f = u_d * g_d
   301	    A = (2.0 / M) * np.sin(np.pi * np.outer(k, np.arange(1, M)) / M)
   302	    nb_d = -(A @ f @ A.T)
   303	    worst = max(worst, float(np.max(np.abs(np.asarray(nb) - nb_d)) / np.max(np.abs(nb_d))))
   304	    Sl = np.asarray(PS.lattice_S(N, 8))
   305	    lat = np.asarray(PS.synth_lattice(jnp.asarray(bb), jnp.asarray(Sl), 2))
   306	    xl = np.arange(1, 8) / 8
   307	    Sx = np.sin(np.pi * np.outer(xl, k))
   308	    worst = max(worst, float(np.max(np.abs(lat[1:-1, 1:-1] - Sx @ bb @ Sx.T))))
   309	    return dict(gate='Utransforms', worst_rel=worst, **{'pass': worst <= 1e-12})
   310	
