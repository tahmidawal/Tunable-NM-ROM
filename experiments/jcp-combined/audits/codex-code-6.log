    59	def validate_entry(name):
    60	    """Registry contract (code audit 4 item 14): kind supported; required fields present; the coordinate / time /
    61	    normalisation contract equals the one this scorer implements (any change is rejected, not silently ignored);
    62	    reference files authenticated by sha256."""
    63	    ent = REG[name]
    64	    if ent.get('kind') not in KINDS:
    65	        raise ValueError(f'unsupported registry kind {ent.get("kind")!r}')
    66	    miss = [k for k in REQUIRED[ent['kind']] if k not in ent]
    67	    if miss:
    68	        raise ValueError(f'registry entry {name} lacks {miss}')
    69	    for k, v in CONTRACT[ent['kind']].items():
    70	        if ent[k] != v:
    71	            raise ValueError(f'registry {name}: unsupported {k} {ent[k]!r} (this scorer implements {v!r})')
    72	    if ent['kind'] == '2d_f257':
    73	        assert sha_file(Path(ent['dir']) / ent['manifest']) == ent['manifest_sha256'], 'reference manifest sha256'
    74	    else:
    75	        assert sha_file(ent['file']) == ent['sha256'], '3D reference sha256'
    76	    return ent
