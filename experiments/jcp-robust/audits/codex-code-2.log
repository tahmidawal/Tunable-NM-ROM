    44	def rank_interval(v, delta):
    45	    """A2.2: v = values per draw (index 0 = deployed; +inf = failed), lower is better. Returns (k_lo, k_hi, label)."""
    46	    v = [float(x) for x in v]
    47	    n = len(v)
    48	    if n < 2 or any(math.isnan(x) for x in v):
    49	        return None, None, 'unavailable'
    50	    v0 = v[0]
    51	    lo = 1 + sum(1 for s in range(1, n) if v[s] < v0 - delta)      # IEEE: inf compares correctly on both sides
    52	    hi = n - sum(1 for s in range(1, n) if v[s] > v0 + delta)
    53	    if lo == 1 and hi == n:
    54	        lab = 'insensitive'
    55	    elif hi <= 2:
    56	        lab = 'favourable'
    57	    elif lo >= n - 1:
    58	        lab = 'unfavourable'
    59	    elif lo >= 3 and hi <= n - 2:
    60	        lab = 'typical'
    61	    else:
    62	        lab = 'indeterminate'
    63	    return lo, hi, lab
