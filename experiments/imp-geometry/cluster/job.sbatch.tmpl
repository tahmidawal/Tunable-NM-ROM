#!/bin/bash
#SBATCH --job-name=igeo-__NAME__
#SBATCH --partition=gpu
#SBATCH --gres=gpu:__GPU__:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=__MEM__
#SBATCH --time=__TIME__
#SBATCH --output=__DIR__/slurm-%j.out
set -u
cd __DIR__/code
source /cluster/tufts/paralab/tawal01/ae-research/venv/bin/activate
export JAX_DEFAULT_MATMUL_PRECISION=highest
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export LANE_COMMIT=__COMMIT__
PY=/cluster/tufts/paralab/tawal01/ae-research/venv/bin/python
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
$PY -c "import jax,sys; b=jax.default_backend(); print(f'jax_backend={b}'); sys.exit(0 if b == 'gpu' else 42)" || exit 42
df -h /cluster/tufts/paralab | tail -1
__BODY__
echo "JOB DONE"
