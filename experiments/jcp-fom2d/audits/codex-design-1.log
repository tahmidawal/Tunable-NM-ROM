   137	    is_xc = cohort == CROSSCHECK[dim][0] and case in CROSSCHECK[dim][1]
   138	    xc = st['crosscheck'].get(str(dim), {}).get(f'{cohort}/{case}') if is_xc else None
   139	    eligible = bool(meta['outcome'] == 'accepted' and dstat == 'validated' and (not is_xc or xc == 'PASS'))
   140	    return dict(accepted=meta['outcome'] == 'accepted', outcome=meta['outcome'], eps_ref=meta['judge']['eps_ref'],
   141	                dimension_status=dstat, crosscheck=xc, eligible=eligible)
