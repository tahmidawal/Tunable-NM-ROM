    79	# ------------------------------------------------------------------------------------------------ 2D
    80	def bank2d(Rp_max, shift=0):
    81	    import t2core as T2
    82	    Q = T2.load_qcore()
    83	    import jax.numpy as jnp
    84	    mdl = Q.Model(ckpt=T2.CKPT)
    85	    x = (np.arange(1, 256) + shift) / 256
    86	    xy = np.stack(np.meshgrid(x, x, indexing='ij'), -1).reshape(-1, 2)
    87	    G = np.asarray(mdl.base.at(xy, chunk=8192) @ jnp.asarray(mdl.T[:, :Rp_max]))       # (255^2, R')
    88	    return Q, G
    89	
