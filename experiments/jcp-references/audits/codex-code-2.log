     1	"""jcp-references: cooperative (unenforced) sealing helpers (DESIGN A1.11, A2.9).
     2	
     3	AES-256-CBC via the system `openssl enc -aes-256-cbc -pbkdf2 -md sha256 -salt -pass file:<key>`, piped from memory
     4	(no plaintext file is ever written). The key file holds one 64-character hex line. CBC is unauthenticated, so callers
     5	record sha256 of every plaintext (inside the encrypted manifest) and of every ciphertext (in git), and verify both.
     6	On a shared cluster account this protects against accidental reading only.
     7	"""
     8	from __future__ import annotations
     9	
    10	import hashlib
    11	import io
    12	import json
    13	import subprocess
    14	from pathlib import Path
    15	
    16	import numpy as np
    17	
    18	CMD = ['openssl', 'enc', '-aes-256-cbc', '-pbkdf2', '-md', 'sha256', '-salt']
    19	
    20	
    21	def _check_key(key):
    22	    s = Path(key).read_text().strip()
    23	    assert len(s) == 64 and all(c in '0123456789abcdef' for c in s), 'key must be one 64-char lowercase hex line'
    24	
    25	
    26	def encrypt(data: bytes, key) -> bytes:
    27	    _check_key(key)
    28	    return subprocess.run(CMD + ['-pass', f'file:{key}'], input=data, capture_output=True, check=True).stdout
    29	
    30	
    31	def decrypt(blob: bytes, key) -> bytes:
    32	    _check_key(key)
    33	    return subprocess.run(CMD + ['-d', '-pass', f'file:{key}'], input=blob, capture_output=True, check=True).stdout
    34	
    35	
    36	def sha(b: bytes) -> str:
    37	    return hashlib.sha256(b).hexdigest()
    38	
    39	
    40	def npz_bytes(**arrays) -> bytes:
    41	    buf = io.BytesIO()
    42	    np.savez(buf, **arrays)
    43	    return buf.getvalue()
    44	
    45	
    46	def write_sealed(path, data: bytes, key):
    47	    """Encrypt and write atomically, read-only; returns (plaintext sha256, ciphertext sha256)."""
    48	    import os
    49	    blob = encrypt(data, key)
    50	    assert decrypt(blob, key) == data
    51	    tmp = Path(str(path) + '.tmp')
    52	    tmp.write_bytes(blob)
    53	    os.replace(tmp, path)
    54	    os.chmod(path, 0o444)
    55	    return sha(data), sha(blob)
    56	
    57	
    58	def read_seeds(path, key, expect_plain_sha, expect_cipher_sha):
    59	    """Decrypt the secret seed file, verifying the committed ciphertext hash BEFORE and the plaintext hash AFTER."""
    60	    blob = Path(path).read_bytes()
    61	    if sha(blob) != expect_cipher_sha:
    62	        raise ValueError('seed file ciphertext hash mismatch')
    63	    data = decrypt(blob, key)
    64	    if sha(data) != expect_plain_sha:
    65	        raise ValueError('seed file plaintext hash mismatch (wrong key?)')
    66	    return json.loads(data)

