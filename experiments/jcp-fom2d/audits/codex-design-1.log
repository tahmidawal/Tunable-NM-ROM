   101	        return dict(status='no joint median-and-worst match in the ladder', matched=None, admissible=[c['key'] for c in real_adm])
   102	    best = min(ok, key=lambda c: c['cost'])
   103	    cheapest = min(real_adm, key=lambda c: c['cost'])
   104	    ef, er, eta, ids = aligned(rom, best)
   105	    return dict(status='matched', matched=best['key'], cost_screen=best['cost'], median=float(np.median(ef)),
   106	                worst=float(np.max(ef)), ranked_cases=len(ids), boundary=best['key'] == cheapest['key'], upper_bound=True,
   107	                n_admissible=len(real_adm), n_matching=len(ok))
   108	
