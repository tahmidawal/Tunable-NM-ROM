    50	def gather():
    51	    """Link every pulled non-sealed FD / PS file of complete, gate-passing jobs into the store, after verifying each
    52	    against the job's own OUTPUTS.sha256. Returns ({attempt: result.json}, {attempt: reason refused})."""
    53	    results, refused = {}, {}
    54	    if list(RUNS.glob('*/output/**/*.enc')):
    55	        raise RuntimeError('encrypted (sealed) artifacts found in a local run directory: they must stay on the cluster')
    56	    for rd in sorted(RUNS.glob('*/')):
    57	        rj = rd / 'output' / 'result.json'
    58	        if not rj.exists():
    59	            continue
    60	        r = json.loads(rj.read_text())
    61	        if r.get('SMOKE_OVERRIDE'):
    62	            refused[rd.name] = 'smoke override'        # A4.4(v): never collected, never summarised
    63	            continue
    64	        if not (r.get('complete') and r.get('gates_all_pass')):
    65	            refused[rd.name] = 'incomplete or gate failure'
    66	            continue
    67	        sums = {}
    68	        for line in (rd / 'OUTPUTS.sha256').read_text().splitlines():
    69	            h, f = line.split(None, 1)
    70	            sums[f.strip()] = h
    71	        results[rd.name] = r
    72	        out = rd / 'output'
    73	        for f in sorted(out.glob('*d/*/*/c*.*')):
    74	            if f.suffix in ('.npz', '.json') and not f.name.endswith('.tmp'):
    75	                dim, coh = int(f.parts[-4][0]), f.parts[-3]
    76	                if CH.is_sealed(dim, coh):
    77	                    raise RuntimeError(f'sealed file pulled locally: {f}')
    78	                rel = str(f.relative_to(rd))
    79	                if sums.get(rel) != sha(f):
    80	                    raise RuntimeError(f'{rel}: does not match the job OUTPUTS.sha256')
    81	                link(f, STORE / f.relative_to(out))
    82	    return results, refused
