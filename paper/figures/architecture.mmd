%% Conceptual source. architecture.tex is the matching print layout.
flowchart TB
  subgraph OFF["OFFLINE: train and prepare"]
    direction LR
    TRAIN["Learn from training snapshots<br/>Spatial bank model, neural head h, training codes"]
    PREP["Prepare selected configuration<br/>Bank G, correction directions C_q, weak operators"]
    TRAIN --> PREP
  end
  subgraph ON["ONLINE: prepared components remain frozen"]
    direction LR
    INPUT["PDE inputs<br/>Source or initial field; parameters"]
    INIT["Initialize<br/>Initial reduced coordinates z_0, y_0"]
    SOLVE["Reduced solve<br/>Weak residual minimization<br/>Adjust z and y"]
    OUTPUT["Reconstruct<br/>u = G[h(z) + C_q y]<br/>Requested solution fields"]
    INPUT --> INIT --> SOLVE --> OUTPUT
    INPUT -->|"inputs also enter the weak residual directly<br/>source f, PDE parameters, boundary data"| SOLVE
  end
  PREP -.-> INIT
  PREP -.-> SOLVE
  PREP -.-> OUTPUT
  EQ["Residual evaluation: dense or optional EQ<br/>Stored quadrature points and weights"] --> SOLVE
  classDef frozen fill:#edf3fa,stroke:#315b85,color:#17212b;
  classDef online fill:#fff0df,stroke:#966323,color:#17212b;
  classDef neutral fill:#f5f5f5,stroke:#666,color:#17212b;
  class TRAIN,PREP frozen;
  class INIT,SOLVE,OUTPUT online;
  class INPUT,EQ neutral;
%% The PDE inputs feed the solve twice: through the initial coordinates and directly through the residual.
%% z: nonlinear coordinates; y: correction coefficients; q: correction count.
%% Linear-PDE correction coefficients may be eliminated analytically.
%% Time-dependent problems repeat the reduced step; reconstruction is at requested times.
%% EQ is used in Burgers2D panels; current 3D and wave panels do not use EQ.
%% Baselines are independent comparison methods, never downstream pipeline stages.
