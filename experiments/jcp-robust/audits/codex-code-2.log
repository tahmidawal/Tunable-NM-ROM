   119	  env N=$NB K=16 R=512 "${EX_ENV[@]}" T_EARLY=5 SEED0=0 LOOSE=1 EXTRA_SEED=1000 GEN_CHUNK=64 PROJ_CHUNK=256 \
   120	    IDENT_ROWS=64 CKPT="$CK" OUT_PREFIX="$B/" \
   121	    "$PY" -u sep_coeff_extract.py 2>&1 | tee "$B/extract.log"
   122	  NPZ="$B/sep_coeff_N${NB}_K16_R512.npz"
   123	  [ -s "$NPZ" ] || { echo "EXTRACT FAILED (no $NPZ)" >&2; exit 5; }
   124	  log "Stage B head fit (full call, SEED0=$SEED_S)"
   125	  env NPZ="$NPZ" CKPT="$CK" OUT="$B/hfit_full.json" ARMS=mid,wide,k32 "${HF_ENV[@]}" BATCH=4096 LR=1e-3 \
   126	    TIME_CAP=1500 SEED0="$SEED_S" EMIT=mid EMIT_PATH="$B/sep_hfit_dense_mid_N${NB}_dense.pkl" \
   127	    "$PY" -u sep_hfit_run.py 2>&1 | tee "$B/hfit.log"
   128	  cd "$OUTDIR"
   129	  "$PY" -I - "$B" "$NB" "$SEED_S" <<'EOF'
   130	import json, sys
   131	from pathlib import Path
   132	b, nb, s = Path(sys.argv[1]), sys.argv[2], int(sys.argv[3])
   133	ex = json.load(open(b / f'sep_coeff_N{nb}_K16_R512.json'))
   134	hf = json.load(open(b / 'hfit_full.json'))
   135	assert ex['complete'] is True and hf['complete'] is True and hf['config']['seed'] == s
   136	assert Path(hf['emitted']).name == f'sep_hfit_dense_mid_N{nb}_dense.pkl', hf['emitted']
   137	t = hf['arms']['mid']['train']
