    56	    for ci in range(len(W)):
    57	        for kk in range(6):
    58	            c_ = jnp.asarray(W[ci, kk])
    59	            out[ci, kk] = P1rho(C3.nl3(c_, da), C3.nl3(c_, db))
    60	    return out
