   158	def resolved(sa, sb):
   159	    """Pairwise ranking rule (A2.10/A3.7): True iff |e_a - e_b| > 2 eps_ref. Raises unless both scores are eligible and
   160	    refer to the same (dim, cohort, case, kind, metric_id, store_version); eps_ref is re-read from the store."""
   161	    keys = ('dim', 'cohort', 'case', 'kind', 'metric_id', 'store_version')
   162	    if any(sa[k] != sb[k] for k in keys):
   163	        raise ValueError('scores refer to different cases, kinds, metrics or store versions')
   164	    if sa['store_version'] != store_version():
   165	        raise ValueError('scores were computed against another store version')
   166	    st = reference_status(sa['dim'], sa['cohort'], sa['case'], sa['kind'])
   167	    if not (st['eligible'] and sa['eligible'] and sb['eligible']):
   168	        raise ValueError(f"case not eligible for ranking (outcome {st['outcome']}, dimension {st['dimension_status']}, "
   169	                         f"cross-check {st['crosscheck']})")
   170	    eps = st['eps_ref']
   171	    if eps is None or not np.isfinite(eps) or eps < 0:
   172	        raise ValueError('invalid eps_ref')
   173	    return bool(abs(sa['e'] - sb['e']) > 2 * eps)
