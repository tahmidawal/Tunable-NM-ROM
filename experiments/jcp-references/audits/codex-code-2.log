   321	def u_crypto():
   322	    import sealio as SI
   323	    with tempfile.TemporaryDirectory() as td:
   324	        k = Path(td) / 'k'
   325	        k.write_text(os.urandom(32).hex() + '\n')
   326	        k2 = Path(td) / 'k2'
   327	        k2.write_text(os.urandom(32).hex() + '\n')
   328	        data = SI.npz_bytes(a=np.arange(10.0))
   329	        blob = SI.encrypt(data, k)
   330	        ok_round = SI.decrypt(blob, k) == data
   331	        try:
   332	            wrong = SI.decrypt(blob, k2)
   333	            wrong_detected = SI.sha(wrong) != SI.sha(data)
   334	        except Exception:
   335	            wrong_detected = True
   336	    return dict(gate='Ucrypto', round_trip=bool(ok_round), wrong_key_detected=bool(wrong_detected),
   337	                **{'pass': bool(ok_round and wrong_detected)})
