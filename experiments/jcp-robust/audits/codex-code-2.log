   222	def P1rho(a, b):
   223	    a, b = np.asarray(a), np.asarray(b)
   224	    if not (np.isfinite(a).all() and np.isfinite(b).all()):
   225	        return float('inf')
   226	    nb = float(np.linalg.norm(b))
   227	    if nb == 0.:
   228	        return float('nan') if float(np.linalg.norm(a)) == 0. else float('inf')
   229	    return float(np.linalg.norm(a - b) / nb)
