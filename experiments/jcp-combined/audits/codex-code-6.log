    91	def decode2d(G, W):
    92	    U = np.zeros((W.shape[0], 257, 257))
    93	    U[:, 1:-1, 1:-1] = (W @ G[:, :W.shape[1]].T).reshape(-1, 255, 255)
    94	    return U
