   220	# ------------------------------------------------------------------------------------------------ lattices ----
   221	
   222	LATTICE = {2: 256, 3: 64}       # scoring lattice: intervals per axis (2D 257^2 incl. walls; 3D 63^3 interior)
   223	
   224	
   225	def to_lattice(out, L, d):
   226	    """(6, (L-1)^d) flat interior outputs -> scoring lattice: 2D (6, 257, 257) with zero walls; 3D (6, 63^3) flat."""
   227	    m = LATTICE[d]
   228	    s = L // m
   229	    assert s * m == L, (L, m)
   230	    out = out.reshape((6,) + (L - 1,) * d)
   231	    if d == 2:
   232	        a = jnp.pad(out, ((0, 0), (1, 1), (1, 1)))
   233	        return np.asarray(a[:, ::s, ::s])
   234	    idx = jnp.arange(1, m) * s - 1
   235	    a = out[:, idx][:, :, idx][:, :, :, idx]
   236	    return np.asarray(a.reshape(6, -1))
