   398	def ps_case(coh, j, Ns, dt, attempt_no, purpose_tag, dt_base, ps_gates_ok):
   399	    d = coh.dim
   400	    m = RC.LATTICE[d]
   401	    runs = []
   402	    for N in Ns:
   403	        for dtx, purpose in [(dt, purpose_tag)] + ([(dt / 2, 'half')] if N == Ns[-1] else []):
   404	            t = time.perf_counter()
   405	            b0 = PS.ic_coefs_2d(coh.D[j], N) if d == 2 else PS.ic_coefs_3d(coh.T, j, N)
   406	            b0b = PS.ic_coefs_2d(coh.D[j], N, 512) if d == 2 else PS.ic_coefs_3d(coh.T, j, N, 512)
   407	            ic_rel = float(np.linalg.norm(b0 - b0b) / np.linalg.norm(b0b))
   408	            ic_max = float(np.max(np.abs(b0 - b0b)))
   409	            Lk = jnp.asarray(PS.lin_eig(N, d, coh.nu(j)))
   410	            c32, c64 = PS.etdrk4_coefs(Lk, dtx, 32), PS.etdrk4_coefs(Lk, dtx, 64)
   411	            contour = max(float(jnp.max(jnp.abs(c32[k] - c64[k])) / jnp.max(jnp.abs(c64[k])))
   412	                          for k in ('Q', 'f1', 'f2', 'f3'))
   413	            del c32, c64, Lk, b0b
   414	            S = PS.lattice_S(N, m)
   415	            if (N, d) not in _PS:
   416	                _PS[(N, d)] = PS.make_ps(N, d)
   417	            r = _PS[(N, d)](jnp.asarray(b0), coh.nu(j), dtx, S)
   418	            kexp = int(round(np.log2(dt_base / dtx)))
   419	            checks_ok = bool(ic_rel <= 1e-12 and ic_max <= 1e-13 and contour <= 1e-10 and ps_gates_ok)
   420	            runs.append(dict(id=f'N{N}_dt{kexp}_a{attempt_no}', N=N, dt=dtx, attempt=attempt_no, purpose=purpose,
   421	                             umax=r['umax'], finite=r['finite'], ic_quad_rel=ic_rel, ic_quad_max=ic_max,
   422	                             contour_rel=contour, job_gates_ok=ps_gates_ok, checks_ok=checks_ok, lat=r['lat'],
   423	                             seconds=time.perf_counter() - t, peak_bytes=RC.peak_bytes()))
   424	            log(f"  PS {coh.name} c{j} {runs[-1]['id']} umax={r['umax']:.3f} finite={r['finite']} checks={checks_ok} "
   425	                f"{runs[-1]['seconds']:.0f}s peak={runs[-1]['peak_bytes']}")
   426	            del r
   427	    return runs
   428	
   429	
   430	def stability_ok(runs, d, dt, N3):
   431	    umax = max(r['umax'] for r in runs)
   432	    return bool(np.isfinite(umax) and dt <= 0.66 * 2.8 / (2 * d * np.pi * N3 * umax))
   433	
   434	
   435	def mode_ps(cfg, outdir, rep):
   436	    d = int(cfg['dim'])
   437	    coh = CH.Cohort(d, cfg['cohort'])
   438	    att = int(cfg.get('attempt', 0))
   439	    Ns = cfg.get('Ns') or (PS_CFG[d]['Ns'] if att == 0 else PS_CFG[d]['esc'])
   440	    dt_base = PS_CFG[d]['dt']
   441	    for j in cfg['cases']:
   442	        stem = outdir / f'{d}d' / coh.name / 'PS' / f'c{j:03d}_a{att}'
   443	        if Path(str(stem) + '.json').exists():
   444	            continue
   445	        dt = dt_base
   446	        runs = ps_case(coh, j, Ns, dt, 2 * att, 'spatial', dt_base, rep['gates_all_pass'])
   447	        stab = stability_ok(runs, d, dt, Ns[-1])
   448	        if not stab:
   449	            dt = dt / 2
   450	            runs += ps_case(coh, j, Ns, dt, 2 * att + 1, 'stability', dt_base, rep['gates_all_pass'])
   451	            stab = stability_ok([r for r in runs if r['attempt'] == 2 * att + 1], d, dt, Ns[-1])
   452	        sel_att = max(r['attempt'] for r in runs)
   453	        sel = [r for r in runs if r['attempt'] == sel_att]
   454	        spatial = [next(r['id'] for r in sel if r['N'] == N and r['dt'] == dt) for N in Ns]
   455	        half = next(r['id'] for r in sel if r['N'] == Ns[-1] and r['dt'] == dt / 2)
   456	        arrays = {r['id']: r['lat'] for r in runs}
   457	        arrays['t0_ps'] = next(r['lat'] for r in sel if r['id'] == half)[0]
   458	        arrays['t0'] = RC.ic_lattice(coh, j)
   459	        meta = dict(dim=d, cohort=coh.name, case=j, desc=coh.desc(j), Ns=Ns, dt_base=dt_base, ladder_attempt=att,
   460	                    runs=[{k: v for k, v in r.items() if k != 'lat'} for r in runs], selected_spatial=spatial,
   461	                    selected_half=half, stability_ok=stab, gates_ok=bool(all(r['checks_ok'] for r in sel)),
   462	                    finite=bool(all(r['finite'] for r in sel)), job=job_info())
   463	        stem.parent.mkdir(parents=True, exist_ok=True)
   464	        atomic_write(str(stem) + '.npz', SI.npz_bytes(**arrays))
   465	        atomic_write(str(stem) + '.json', json.dumps(V_clean(meta), indent=1).encode())
   466	        rep.setdefault('ps_cases', []).append(dict(case=j, attempt=att, stability_ok=stab, finite=meta['finite'],
   467	                                                   gates_ok=meta['gates_ok']))
   468	        save(outdir, rep)
   469	
   470	
   471	def save(outdir, rep):
   472	    tmp = outdir / 'result.json.tmp'
   473	    tmp.write_text(json.dumps(V_clean(rep), indent=1))
   474	    tmp.replace(outdir / 'result.json')
