+    fp, _ = OM.point_blocks(model['bank'], model['T'], Xg + h)
+    fm, _ = OM.point_blocks(model['bank'], model['T'], Xg - h)
+    rep['gates']['G1_derivative_vs_fd'] = rel_max((fp - fm) / (2 * h), Dg)
