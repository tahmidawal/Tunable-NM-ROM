   234	        ctrl['coordinate_shift_field_t005'] = float(np.linalg.norm(decode2d(Gs, W[ci0, k0])[1] - U[1])) / n0
   235	        ctrl['all_break'] = bool(other is not None and all(v is not None and v > 1e-6 for v in ctrl.values()))
