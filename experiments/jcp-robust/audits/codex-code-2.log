    50	def h_acc_n(C, r, kind, scheme):
    51	    e = {m: C[m]['cfg'].get((r, kind, f'LSPG_{scheme}_1')) if C.get(m) else None for m in MESHES}
    52	    if e[256] is None or e[1024] is None:
    53	        return dict(outcome='verdict not reached', reason='missing 256^2 or 1024^2 configuration')
    54	    sub16 = set(PS.case_set('sub16'))
    55	    ep = e[1024]['eps']
    56	    pairs = {}
    57	    for m, tag in ((256, 'P256'), (4096, 'P4096')):
    58	        if e[m] is None:
    59	            continue
    60	        cs = [c for c in e[m]['e'] if c in e[1024]['e'] and e[m]['eligible'][c] and e[1024]['eligible'][c] and (m != 4096 or c in sub16)]
    61	        pairs[tag] = (np.array([e[m]['e'][c] for c in cs]), np.array([e[1024]['e'][c] for c in cs]), np.array([ep[c] for c in cs]))
    62	    slopes = None
    63	    if e[4096] is not None:
    64	        cs = [c for c in e[4096]['e'] if c in sub16 and all(c in e[m]['e'] and e[m]['eligible'][c] for m in MESHES)]
    65	        slopes = [np.polyfit(np.log2(MESHES), [e[m]['e'][c] for m in MESHES], 1)[0] for c in cs]
    66	    qual = all(e[m]['qualified'] is True for m in MESHES if e[m] is not None)
    67	    out = S.h_acc_n(pairs, slopes, qualified=qual)
    68	    out['qualified'] = {m: e[m]['qualified'] for m in MESHES if e[m] is not None}
    69	    out['rule'] = {m: e[m]['rule'] for m in MESHES if e[m] is not None}
    70	    out['median_e'] = {m: float(np.median(list(e[m]['e'].values()))) for m in MESHES if e[m] is not None}
    71	    out['worst_e'] = {m: float(np.max(list(e[m]['e'].values()))) for m in MESHES if e[m] is not None}
    72	    return out
