    95	# ---------------------------------------------------------------------------------------------------------- 3D --
    96	
    97	def _draw3d_table(seed, m, kind):
    98	    """b3d_common.draw_param_table with the kind's ranges (identical draw order; prefix-stable)."""
    99	    if kind == 'family':
   100	        return b3.draw_param_table(seed, m)
   101	    rng = np.random.default_rng(seed)
   102	    B = np.zeros(m, dtype=np.int64)
   103	    c = np.zeros((m, 3, 3))
   104	    w = np.zeros((m, 3))
   105	    rho = np.zeros((m, 3))
   106	    A = np.zeros(m)
   107	    nu = np.zeros(m)
   108	    for j in range(m):
   109	        B[j] = rng.integers(1, 4)
   110	        for b in range(3):
   111	            c[j, b] = rng.uniform(0.2, 0.8, 3)
   112	            w[j, b] = rng.uniform(0.07, 0.10)
   113	            rho[j, b] = rng.uniform(0.5, 1.0)
   114	        A[j] = rng.uniform(0.5, 2.0)
   115	        nu[j] = np.exp(rng.uniform(*LOGNU_OOD))
   116	    overlap = np.full(m, np.inf)
   117	    for j in range(m):
   118	        if B[j] > 1:
   119	            dmin = min(np.linalg.norm(c[j, a] - c[j, b_]) for a in range(B[j]) for b_ in range(a + 1, B[j]))
   120	            overlap[j] = dmin / np.mean(w[j, :B[j]])
   121	    return dict(B=B, c=c, w=w, rho=rho, A=A, nu=nu, overlap=overlap, seed=int(seed), m=int(m))
