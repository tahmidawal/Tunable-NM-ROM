    92	                                 # the dims (3M) predicate); no rho against the target is registered, so it is not tested
    93	                                 target=d_tgt, rho_tgt=[0.] * len(cases), nonst_frac=nonst),
    94	                            (None if tgt_ok is None or tgt_ok is False else bool(all(g['gl64']['valid']))),
    95	                            len(cases), len(x['adt_tight_tighter']))
    96	                        cells[rl] = dict(qualified=qual, own=own, status=status, m=x.get('m'),
    97	                                         dist_next_max=max(d_next), dist_tgt_max=max(d_tgt) if d_tgt else None)
    98	                    key = 'qualified' if tgt_ok else 'own'
    99	                    pick, outcome = None, 'none within ladder'
   100	                    for rl in cand:
   101	                        v = cells[rl][key]
   102	                        if v is True:
