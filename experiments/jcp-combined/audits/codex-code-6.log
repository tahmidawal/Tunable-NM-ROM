   116	def score2d(ent, run, check):
   117	    res = json.loads((run / 'result.json').read_text())
   118	    import t2core as T2
   119	    Q_ = T2.load_qcore()
   120	    assert res['checkpoint_sha256'] == ent['bank_sha256'] == sha_file(T2.CKPT), 'bank checkpoint differs from the registry'
   121	    assert sha_file(Q_.ROTATION) == ent['rotation_sha256'], 'rotation differs from the registry'
   122	    man = json.loads((Path(ent['dir']) / ent['manifest']).read_text())
   123	    for coh, v in res['cohorts'].items():           # descriptors authenticated: hash of the ACTUAL array used for n0
   124	        h = sha(np.asarray(v['physical'], dtype=np.float64))
   125	        assert h == v['physical_sha256'] == man['cohort_sha256'][coh], ('case descriptors differ from the reference cohort', coh)
   126	    cohorts = res['cohorts']
   127	    Rps = [res['setup'][s['name']]['Rp'] for s in res['config']['settings']]
   128	    Q, G = bank2d(max(Rps))
   129	    n0c = {}
   130	    out, gate = {}, dict(status='unchecked', compared=0, expected=0, worst=0., nonfinite=0)
   131	    inrow = {(r['setting'], r['run'], r['cohort'], r['case']): r for r in res['rows']}
   132	    tags = list(ent['tags']) + list(ent.get('derived', {}))
   133	    for s in res['config']['settings']:
   134	        z = np.load(run / f"W_{s['name']}.npz")
   135	        W, keys, cases = z['W'], [str(k) for k in z['runs']], [str(c) for c in z['cases']]
   136	        for ci, ck in enumerate(cases):
   137	            coh, c = ck.split('|')
   138	            c = int(c)
   139	            if (coh, c) not in n0c:
   140	                n0c[(coh, c)] = float(np.linalg.norm(Q.e.initial(256, np.asarray(cohorts[coh]['physical'][c]))))
   141	            n0 = n0c[(coh, c)]
   142	            refs = load_ref2d(ent, coh, c)
   143	            for ri, k in enumerate(keys):
   144	                U = decode2d(G, W[ci, ri])
   145	                pe = {t: [float(np.linalg.norm(U[j] - refs[t][j])) / n0 for j in range(6)] for t in tags}
   146	                out[f"{s['name']}|{k}|{coh}|{c}"] = {t: dict(per_time=v, worst=max(v[1:])) for t, v in pe.items()}
   147	                if check:
   148	                    r = inrow.get((s['name'], k, coh, c))
   149	                    for t in ('ST', 'S', 'TX'):
   150	                        if t not in pe:
   151	                            continue
   152	                        gate['expected'] += 6
   153	                        if r is None:
   154	                            continue
   155	                        for j in range(6):
   156	                            x, y = pe[t][j], r[f'e_{t}_per_time'][j]
   157	                            gate['compared'] += 1
   158	                            if not (np.isfinite(x) and np.isfinite(y)):
   159	                                gate['nonfinite'] += 1     # allowed only for an invalid (unverified) in-job rollout
   160	                                ok_nf = not (np.isfinite(x) or np.isfinite(y)) and not r.get('verified', True)
   161	                                gate['failures'] = gate.get('failures', 0) + (0 if ok_nf else 1)
   162	                                continue
   163	                            gate['worst'] = max(gate['worst'], abs(x - y))
   164	                            gate['failures'] = gate.get('failures', 0) + (0 if tol_ok(x, y) else 1)
   165	    if check:                                        # coverage: configured inventory == result rows == archive entries
   166	        import c2grid as C2G
   167	        cfg_ = res['config']
   168	        inv_runs = [C2G.key(r) for r in C2G.run_list(cfg_['grid'])]
   169	        cases_ = [(coh, str(c)) for coh in cfg_['cohorts'] for c in
   170	                  (cfg_.get('case_subset', {}).get(coh) if cfg_.get('case_subset', {}).get(coh) is not None
   171	                   else range(res['cohorts'][coh]['n']))]
   172	        expected = {(s_['name'], k, coh, c) for s_ in cfg_['settings'] for k in inv_runs for coh, c in cases_}
   173	        arch = set()
   174	        for s in res['config']['settings']:
   175	            z = np.load(run / f"W_{s['name']}.npz")
   176	            arch |= {(s['name'], str(k), *str(c).split('|')) for k in z['runs'] for c in z['cases']}
   177	        rowk = {(r['setting'], r['run'], r['cohort'], str(r['case'])) for r in res['rows']}
   178	        gate['rows_without_archive'] = len(rowk - arch)
   179	        gate['archive_without_rows'] = len(arch - rowk)
   180	        gate['inventory_mismatch'] = len(expected ^ rowk)
   181	        fexp = {(f'fom|{sc}|{f:g}', coh, c) for sc in cfg_['fom']['schemes'] for f in cfg_['fom']['dt_factors']
   182	                if res['fom']['calibration'].get(f'{sc}|{f:g}', {}).get('status') in ('calibrated', 'fallback_tight')
   183	                for coh, c in cases_}
   184	        frk = {(r['run'], r['cohort'], str(r['case'])) for r in res.get('fom', {}).get('rows', [])}
   185	        gate['fom_inventory_mismatch'] = len(fexp ^ frk)
   186	    # FOM archive (same reference, same nodes); required whenever the result has FOM rows
   187	    fom = {}
   188	    fp = run / 'fom_f257.npz'
   189	    frow = {(r['run'], r['cohort'], r['case']): r for r in res.get('fom', {}).get('rows', [])}
   190	    if frow and not fp.exists():
   191	        raise SystemExit('FOM rows without fom_f257.npz')
   192	    if fp.exists():
   193	        Fz = np.load(fp)
   194	        assert np.allclose(Fz['__coords_x'], np.arange(257) / 256) and np.allclose(Fz['__times'], np.arange(6) * .05)
   195	        fkeys = {tuple(k.replace('__', '|').rsplit('|', 2)) for k in Fz.files if not k.startswith('__')}
   196	        gate['fom_archive_mismatch'] = len(fkeys ^ {(r['run'], r['cohort'], str(r['case'])) for r in res.get('fom', {}).get('rows', [])})
   197	        for k in Fz.files:
   198	            if k.startswith('__'):
