   108	def pooled_nonstationary(cert_rows, form):
   109	    """Pooled non-stationary fraction over every step of every case (V4-2): LSPG gamma > 1e-3 or non-finite; GAL eta > 1e-8."""
   110	    bar = GAMMA if form == 'LSPG' else ETA
   111	    tot = bad = 0
   112	    for c in cert_rows:
   113	        c = np.asarray(c, float)
   114	        tot += c.size
   115	        bad += int(np.sum(~(np.isfinite(c) & (c <= bar))))
   116	    return (bad / tot) if tot else float('nan')
