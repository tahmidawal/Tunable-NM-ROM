    56	def kvec(n, d, axis):
    57	    """k_a * pi broadcast along `axis` for coefficient arrays of side n (= M - 1 or N - 1)."""
    58	    k = jnp.arange(1, n + 1, dtype=jnp.float64) * jnp.pi
    59	    shp = [1] * d
    60	    shp[axis] = n
    61	    return k.reshape(shp)
