   312	def u_ic3d():
   313	    """Chunked 3D IC (used above 256 intervals) equals the vendor unchunked IC."""
   314	    T = CH.Cohort(3, 'dev4').T
   315	    a = CH.ic_3d_chunked(128, T, 1, chunk=5000)
   316	    b = np.asarray(CH.C3.initial_interior(129, T, 1))
   317	    dev = float(np.max(np.abs(a - b)) / np.max(np.abs(b)))
   318	    return dict(gate='Uic3d', max_rel=dev, **{'pass': dev <= 1e-14})
