    86	def h_e1c(e, e0, failed, eps, econv, eligible):
    87	    """A3.2/A3.3/A4.2. Per eligible case i: within margin iff no draw failed on i and max_s |e_si - e_0i| <= margin_i,
    88	    margin_i = max(2 eps_i, 0.1 e_conv_i) (e_conv unavailable on i -> 2 eps_i). e: (draws, cases); failed: (draws, cases)."""
    89	    e, failed = np.asarray(e, float), np.asarray(failed, bool)
    90	    idx = [i for i in range(e.shape[1]) if eligible[i]]
    91	    if not idx:
    92	        return dict(label='unavailable', n=0)
    93	    within = []
    94	    for i in idx:
    95	        if failed[:, i].any():
    96	            within.append(False)
    97	            continue
    98	        m = 2 * eps[i]
    99	        if econv[i] is not None and np.isfinite(econv[i]):
   100	            m = max(m, .1 * econv[i])
   101	        col = e[:, i]
   102	        within.append(bool(np.isfinite(col).all() and np.max(np.abs(col - col[0])) <= m))
   103	    frac = sum(within) / len(within)
   104	    lab = 'insensitive' if frac >= .9 else ('sensitive' if frac < .75 else 'inconclusive')
   105	    return dict(label=lab, fraction_within=frac, n=len(within), outside=[idx[k] for k, w in enumerate(within) if not w])
