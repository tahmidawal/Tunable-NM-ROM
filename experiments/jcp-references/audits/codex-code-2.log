   259	def u_rng():
   260	    s2, s3 = CH.PUBLIC_CHECK_SEEDS[2], CH.PUBLIC_CHECK_SEEDS[3]
   261	    prefix = (np.array_equal(CH.rowwise_2d(s2, 10, 'family')[:4], CH.rowwise_2d(s2, 4, 'family'))
