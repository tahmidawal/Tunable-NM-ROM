    31	def sine_synth_last(b, M):
    32	    """b (..., M-1) coefficients -> S_j = sum_k b_k sin(pi k j / M), j = 1..M-1."""
    33	    z = jnp.zeros(b.shape[:-1] + (1,), b.dtype)
    34	    o = jnp.concatenate((z, b, z, -b[..., ::-1]), -1)          # odd extension, length 2M
    35	    return -_ext_fft(o).imag[..., 1:M] / 2.0
    36	
    37	
    38	def cos_synth_last(g, M):
    39	    """g (..., M-1) coefficients (k = 1..M-1) -> C_j = sum_k g_k cos(pi k j / M), j = 1..M-1."""
    40	    z = jnp.zeros(g.shape[:-1] + (1,), g.dtype)
    41	    e = jnp.concatenate((z, g, z, g[..., ::-1]), -1)           # even extension, length 2M
    42	    return _ext_fft(e).real[..., 1:M] / 2.0
