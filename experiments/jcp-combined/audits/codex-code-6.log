   200	            kk, coh, c = k.replace('__', '|').rsplit('|', 2)
   201	            c = int(c)
   202	            refs = load_ref2d(ent, coh, c)
   203	            n0 = n0c.get((coh, c)) or float(np.linalg.norm(Q.e.initial(256, np.asarray(cohorts[coh]['physical'][c]))))
   204	            pe = {t: [float(np.linalg.norm(Fz[k][j] - refs[t][j])) / n0 for j in range(6)] for t in tags}
   205	            fom[f'{kk}|{coh}|{c}'] = {t: dict(per_time=v, worst=max(v[1:])) for t, v in pe.items()}
   206	            if check:
   207	                r = frow.get((kk, coh, c))
   208	                for t in ('ST', 'S', 'TX'):
   209	                    gate['expected'] += 6
   210	                    if r is None:
   211	                        continue
   212	                    for j in range(6):
   213	                        x, y = pe[t][j], r[f'e_{t}_per_time'][j]
   214	                        gate['compared'] += 1
   215	                        gate['worst'] = max(gate['worst'], abs(x - y)) if np.isfinite(x) and np.isfinite(y) else gate['worst']
   216	                        gate['failures'] = gate.get('failures', 0) + (0 if tol_ok(x, y) else 1)
   217	    ctrl = {}
   218	    if check:
   219	        s0 = res['config']['settings'][0]['name']
   220	        z = np.load(run / f'W_{s0}.npz')
   221	        W, keys, cases = z['W'], [str(k) for k in z['runs']], [str(c) for c in z['cases']]
   222	        k0 = keys.index('LSPG|BE|0.005|prod')
   223	        ci0 = cases.index('dev6|0')
   224	        r = inrow[(s0, keys[k0], 'dev6', 0)]
   225	        n0 = n0c[('dev6', 0)]
   226	        refs = load_ref2d(ent, 'dev6', 0)
   227	        U = decode2d(G, W[ci0, k0])
   228	        e = lambda U_, R_: max(float(np.linalg.norm(U_[j] - R_[j])) / n0 for j in range(1, 6))
   229	        other = next((i for i in range(len(cases)) if i != ci0), None)
   230	        ctrl['case_swap'] = abs(e(decode2d(G, W[other, k0]), refs['ST']) - r['e_ST']) if other is not None else None
   231	        ctrl['time_shift'] = abs(e(np.roll(U, 1, 0), refs['ST']) - r['e_ST'])
   232	        ctrl['ST_S_swap'] = abs(e(U, refs['S']) - r['e_ST'])
