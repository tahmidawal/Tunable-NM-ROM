   119	def draw_qualified(flags, d, target_ok, n_cases, n_tight):
   120	    """A1.2 + A3.2 + A3.3 + A4.2 for one draw. flags: per-case validity lists (valid, valid_tight, valid_succ: n_cases;
   121	    valid_tighter: n_tight); d: per-case distances / indicator maxima (tight, succ, rho_succ, target, rho_tgt: n_cases;
   122	    tt: n_tight) and 'nonst_frac'. Values may be None (serialised non-finite) -> treated as +inf (a failure of the bar).
   123	    Wrong lengths or a missing list -> 'missing' (unavailable). target_ok: True / False (a target run failed on some
   124	    case) / None (target not certified). Returns (qualified_full, qualified_own_family, status)."""
   125	    need = dict(valid=n_cases, valid_tight=n_cases, valid_succ=n_cases, valid_tighter=n_tight)
   126	    needd = dict(tight=n_cases, succ=n_cases, rho_succ=n_cases, target=n_cases, rho_tgt=n_cases, tt=n_tight)
   127	    if n_cases <= 0 or n_tight <= 0:
   128	        return None, None, 'missing'
   129	    for k, n in need.items():
   130	        if flags.get(k) is None or len(flags[k]) != n:
   131	            return None, None, 'missing'
   132	    for k, n in needd.items():
   133	        if d.get(k) is None or len(d[k]) != n:
   134	            return None, None, 'missing'
   135	    if d.get('nonst_frac') is None or not np.isfinite(d['nonst_frac']):
   136	        return None, None, 'missing'
   137	    for k, st in (('valid', 'failed-prod'), ('valid_tight', 'failed-tight'), ('valid_tighter', 'failed-tighter'),
   138	                  ('valid_succ', 'failed-succ')):
   139	        if not all(bool(x) for x in flags[k]):
   140	            return False, False, st
   141	    mx = lambda xs: max(num(x) for x in xs)
   142	    own = bool(d['nonst_frac'] <= .01 and mx(d['tight']) <= BAR_Q1 and mx(d['tt']) <= BAR_TT and mx(d['succ']) <= BAR_Q2
   143	               and mx(d['rho_succ']) <= BAR_RHO)
   144	    if target_ok is None:
   145	        return None, own, 'target not certified'
   146	    if target_ok is False:
   147	        return None, own, 'failed-target'
   148	    cross = bool(mx(d['target']) <= BAR_Q2 and mx(d['rho_tgt']) <= BAR_RHO)
   149	    return bool(own and cross), own, 'ok'
