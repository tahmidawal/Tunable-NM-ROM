@@ -0,0 +1,163 @@
+{
+ "rules": {
+  "lat256": {
+   "family": "cbc_lattice",
+   "m": 256,
+   "role": "must-fail control (far too few points)",
+   "weight_sum": 1.0,
+   "w_min": 0.00390625,
+   "sha256": "43196cf038d2325906461d3a1f8598c5daf67b8b3a0a9a7c0772ad8b4c8f2a3e",
+   "z": [
+    1,
+    75,
+    23
+   ],
+   "p2": 0.06145448919903984,
+   "p2_check": 0.06145448919903984,
+   "shift_seed": 0
+  },
+  "lat4096": {
+   "family": "cbc_lattice",
+   "m": 4096,
+   "role": "arm",
+   "weight_sum": 1.0,
+   "w_min": 0.000244140625,
+   "sha256": "7e40cf2c8a3a350eb1d9267ba8efc1f9b717bcd0c9afc46db8a4e7c0462afbeb",
+   "z": [
+    1,
+    1557,
+    1741
