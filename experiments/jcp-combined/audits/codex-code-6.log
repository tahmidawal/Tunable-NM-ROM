   128	                    slots.add((inv['B'], inv['case'], inv['rep']))
   129	                want = {f'{sname}|{r}|{sk}' for sk in SEL}
   130	                expected = {(b, c, rp) for b in want for c in p['cases'] for rp in range(int(p['reps']))}
   131	                if set(med) != want or slots != expected or len(p['invocations']) != len(expected):
   132	                    cost[fam] = None                                                # incomplete panel -> unavailable
