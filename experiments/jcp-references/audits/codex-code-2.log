   111	            out[f'{coh}/{j}'] = dict(verdict='MISSING')
   112	            continue
   113	        pj = att[-1]                                    # the latest (escalated) ladder governs (A1.7)
   114	        ps = json.loads(pj.read_text())
   115	        a = np.load(pj.with_suffix('.npz'))
   116	        u3, _ = fd_finest(dim, coh, 'ST', j)
   117	        Ns = ps['Ns']
   118	        runs = {r['id']: r for r in ps['runs']}
   119	        half = ps['selected_half']
   120	        full = next(i for i in ps['selected_spatial'] if runs[i]['N'] == Ns[-1])
