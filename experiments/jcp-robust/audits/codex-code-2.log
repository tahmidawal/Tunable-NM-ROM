     1	"""jcp-robust E2 2D rule selection (DESIGN 3.2 as amended by A1.8, A2.5). CPU only.
     2	
     3	For every r: the selected rule is the first candidate (ordered by m) that is qualified under BOTH LSPG-BE dt0 and
     4	LSPG-CN-R dt0 by the full contract (Q1 + Q2 against its registered successor on every case + the cross-family check
     5	against gauss384 on every case), all recomputed offline by e1analyze.analyse_arm. If the target is not certified on either
     6	arm, the pick is a DIAGNOSTIC pick on Q1 + successor Q2 only (A2.5). "none within ladder" if no candidate qualifies.
     7	
     8	    JAX_PLATFORMS=cpu python select2d.py <e2s output dir> <bank>
     9	"""
    10	import json
    11	import sys
    12	from pathlib import Path
    13	
    14	import numpy as np
    15	
    16	import e1analyze as EA
    17	import e2bank
    18	from make_configs_e2 import CANDIDATES, DEPLOYED, RANKS
    19	
    20	HERE = Path(__file__).resolve().parent
    21	
    22	
    23	def main():
    24	    out, b = Path(sys.argv[1]), sys.argv[2]
    25	    res = json.loads((out / 'result.json').read_text())
    26	    assert res.get('complete'), 'selection job incomplete'
    27	    e2bank.use(res['config'].get('bank'))
    28	    rep = dict(source=str(out), bank=b, job_id=res['job_id'], commit=res['commit'], selected={}, cells={})
    29	    for r in RANKS:
    30	        g = [x for x in res['config']['groups'] if x['Rp'] == r][0]
    31	        labels = [x['label'] for x in g['rules']]
    32	        assert labels == [c for c, _ in CANDIDATES], 'candidate list differs from the registered one'
    33	        cells, tcert, integ = {}, True, True
    34	        for arm in ('LSPG_BE_1', 'LSPG_CNR_1'):
    35	            av = EA.analyse_arm(out, res, g, arm, r)
    36	            tcert = tcert and av['target']['certified'] and bool(av['target']['all_valid'])
    37	            integ = integ and av['integrity']['ok']
    38	            cells[arm] = {l: dict(qualified=av['rules'][l]['qualified'], own=av['rules'][l]['own_family_qualified'],
    39	                                  status=av['rules'][l]['status'], D=av['rules'][l]['D'],
    40	                                  median_e=float(np.median(av['rules'][l]['e'])), worst_e=float(np.max(av['rules'][l]['e'])))
    41	                          for l in labels}
    42	            cells[arm]['_integrity'] = av['integrity']
    43	        key = 'qualified' if tcert else 'own'
    44	        pick, outcome = None, 'none within ladder'
    45	        if not integ:
    46	            outcome = 'unavailable (integrity: distance / G-cert / population check failed)'
    47	        else:
    48	            for c, _ in CANDIDATES:                    # three-state (code audit 1 #10): undetermined evidence stops the search
    49	                v = [cells[a][c][key] for a in ('LSPG_BE_1', 'LSPG_CNR_1')]
    50	                if all(x is True for x in v):
    51	                    pick = c
    52	                    outcome = 'selected' if tcert else 'diagnostic pick (target unverified)'
    53	                    break
    54	                if any(x is None for x in v):
    55	                    outcome = f'unavailable (evidence for {c} undetermined)'
    56	                    break
    57	        rep['selected'][str(r)] = dict(rule=pick, outcome=outcome, target_certified=tcert, deployed=DEPLOYED[r],
    58	                                       equals_deployed=pick == DEPLOYED[r])
    59	        rep['cells'][str(r)] = cells
    60	        print(r, rep['selected'][str(r)], flush=True)
    61	    (HERE / 'checks').mkdir(exist_ok=True)
