+        arms[f'tensor_R{Rp}'] = dict(Rp=Rp, M=M, rule='tensor', family='tensor', trust=trust, data=base,
+                                     q=OM.make_fsc_rule(n, Rp, M, OM.contract_tensor, dt=cfg['dt'], gtol=cfg['gtol'],
