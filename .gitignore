__pycache__/
*.pyc
experiments/*/cluster/stage/

# Full transfer fields are preserved exactly in checked archive chunks.
experiments/mr-heat2d/runs/transfer04/archive/outputs/fields/*.npz

# Linear heat full fields are preserved exactly in checksum-verified archive parts.
experiments/mr-heat2d/runs/linear05/archive/outputs/fields/*.npz

# Nonlinear heat fields are preserved in checksum-verified archive parts.
experiments/mr-heat2d/runs/nonlinear06/archive/outputs/fields/*.npz

experiments/mr-heat2d/runs/nonlinear07/archive/outputs/fields/*.npz

# Exact full fields retained in checked archive parts.
experiments/mr-heat2d/runs/cp_algebra08/archive/outputs/fields/*.npz
experiments/mr-heat2d/runs/iterative_cg09/archive/outputs/fields/*.npz

# Heat accuracy fields are preserved exactly in checksum-verified archive parts.
experiments/mr-heat2d/runs/accuracy10/archive/outputs/fields/*.npz

# p-bank-head: the collected job archives are preserved exactly as checksum-verified
# chunks under experiments/p-bank-head/artifacts/<attempt>/. The working copies under
# runs/<attempt>/archive/ are the same bytes unpacked and must not be tracked twice —
# pbh02's alone is 2.0 GB compressed and 4.0 GB unpacked.
experiments/p-bank-head/runs/*/archive/

# p-linear: plhead1 and plin1024b job archives are preserved exactly as checksum-verified
# chunks under experiments/p-linear/artifacts/<attempt>/; the unpacked runs/<attempt>/archive/
# trees are the same bytes and are not tracked twice. (plin256/archive was already tracked
# before this rule and is left as committed.)
experiments/p-linear/runs/plhead1/archive/
experiments/p-linear/runs/plin1024b/archive/

# Reproducible expansions of the checksum-retained plorc01 archive.
experiments/p-linear/runs/plorc01/archive/
experiments/p-linear/runs/plorc01/restore-check/
experiments/p-linear/artifacts/plorc01/result.json
