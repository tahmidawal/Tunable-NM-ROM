+    w('')
+    for k, v in [
+        ('tensor (incumbent)', 'the precomputed quadratic form $\\tfrac12 c^\\top T_m c$ that evaluates the tested '
+         'advection exactly for the mesh\'s backward-difference stencil; $M R\'^2$ numbers.'),
+        ('off-mesh rule', 'a fixed quadrature of the continuum advection at $m$ points not tied to the mesh, using '
