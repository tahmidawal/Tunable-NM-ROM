     1	"""jcp-robust E2 cross-bank verdicts (DESIGN 3.4 as amended by A1.10, A2.7, A3.5, A3.6, A4.2). CPU only, no JAX.
     2	
     3	Reads checks/e2-<dim>-<bank>.json for bank 0 (incumbent) and the recipe seeds. For every registered verdict:
     4	  seed-robust      all three new seeds give the same definitive label
     5	  seed-dependent   two new seeds give different definitive labels
     6	  inconclusive     otherwise
     7	and, when seed-robust, historical agreement with the incumbent (agrees / differs (recipe/software version, not attributed
     8	to the seed) / incumbent not definitive). Precedence: G-E2.3 failure on the incumbent blocks every verdict of that
     9	dimension; a bank job that is incomplete / not on GPU / fails integrity makes that bank's labels 'missing'.
    10	Seed spread: per (r, scheme, mesh) case-median and case-worst error, min-max over seeds, incumbent value, and a t interval
    11	(df = n-1) for the mean of log10 over the new seeds, labelled. Spread ratio per H-acc-r transition (A2.7).
    12	
    13	    python e2verdicts.py 2d [--seeds 1,2,3]
    14	"""
    15	import json
    16	import math
    17	import sys
    18	from pathlib import Path
    19	
    20	import numpy as np
    21	from scipy.stats import t as tdist
    22	
    23	HERE = Path(__file__).resolve().parent
    24	DEFINITIVE = {'pass', 'fail', 'improves', 'does not improve', 'monotone', 'not monotone', 'member', 'dominated', 'unqualified',
    25	              'absent', True, False}
    26	
    27	
    28	def lab3(labels):
    29	    """labels of the new seeds (None = missing)."""
    30	    d = [x for x in labels if x in DEFINITIVE or (isinstance(x, str) and x.startswith('rule:'))]
    31	    if len(d) >= 2 and len(set(map(str, d))) > 1:
    32	        return 'seed-dependent'
    33	    if len(d) == len(labels) and len(set(map(str, d))) == 1:
    34	        return 'seed-robust'
    35	    return 'inconclusive'
    36	
    37	
    38	def hist(inc, new, robust):
    39	    if robust != 'seed-robust':
    40	        return None
    41	    if not (inc in DEFINITIVE or (isinstance(inc, str) and inc.startswith('rule:'))):
    42	        return 'incumbent not definitive'
    43	    return 'agrees with incumbent' if str(inc) == str(new[0]) else 'differs from incumbent (recipe/software version, not attributed to the seed)'
    44	
    45	
    46	def keys_2d(r):
    47	    out = {}
    48	    if r is None:
    49	        return out
    50	    for k, v in r['selection'].items():
    51	        out[f'selected-rule|R{k}'] = ('rule:' + v['rule']) if v['rule'] else ('absent' if v['outcome'] == 'none within ladder' else None)
    52	    for k, v in r['h_acc_n'].items():
    53	        out[f'H-acc-N|{k}'] = v.get('outcome')
    54	    for k, v in r['h_acc_r'].items():
    55	        for tr, x in v.items():
    56	            out[f'H-acc-r|{k}|{tr}'] = x.get('outcome') if isinstance(x, dict) else x
    57	    for k, v in r['configurations'].items():
    58	        out[f'Q1Q2|{k}'] = v['qualified']
    59	    for k, v in (r.get('front_1024') or {}).items():
    60	        if isinstance(v, dict):
    61	            out[f'front1024|{k}'] = v.get('state')
    62	    return out
    63	
    64	
    65	def keys_3d(r):
    66	    out = {}
    67	    if r is None:
    68	        return out
    69	    for sl in r['selection']:
    70	        k = f"selected-rule|W{sl['width']}|{sl['spec']}|{sl['family']}"
    71	        out[k] = ('rule:' + sl['rule']) if sl['rule'] else ('absent' if sl['outcome'] == 'none within ladder' else None)
    72	    for k, v in r['h_acc_r'].items():
    73	        for tr, x in v.items():
    74	            out[f'H-acc-r|{k}|{tr}'] = x.get('outcome') if isinstance(x, dict) else x
    75	    for k, v in r['configurations'].items():
    76	        out[f'Q1Q2|{k}'] = v['qualified']
    77	    for k, v in ((r.get('front_65') or {}).get('points') or {}).items():
    78	        out[f'front65|{k}'] = v.get('state')
    79	    return out
    80	
    81	
    82	def tint(xs):
    83	    xs = [math.log10(x) for x in xs if x is not None and np.isfinite(x) and x > 0]
    84	    if len(xs) < 2:
    85	        return None
    86	    m, s = float(np.mean(xs)), float(np.std(xs, ddof=1))
    87	    h = tdist.ppf(.975, len(xs) - 1) * s / math.sqrt(len(xs))
    88	    return dict(mean_log10=m, lo=10 ** (m - h), hi=10 ** (m + h), n=len(xs), label=f'n = {len(xs)}, wide by construction')
    89	
    90	
    91	def main():
    92	    dim = sys.argv[1]
    93	    seeds = [int(x) for x in (sys.argv[sys.argv.index('--seeds') + 1] if '--seeds' in sys.argv else '1,2,3').split(',')]
    94	    load = lambda b: json.loads((HERE / 'checks' / f'e2-{dim}-{b}.json').read_text()) if (HERE / 'checks' / f'e2-{dim}-{b}.json').exists() else None
    95	    inc = load(0)
    96	    new = {s: load(s) for s in seeds}
    97	    blocked = inc is None or not (inc.get('G-E2.3') or {}).get('passed')
    98	    ok = lambda r: r is not None and r.get('integrity') and all(j.get('complete') and j.get('backend') == 'gpu' for j in r['jobs'].values())
    99	    kf = keys_2d if dim == '2d' else keys_3d
   100	    K = {b: (kf(r) if ok(r) else {}) for b, r in [(0, inc)] + list(new.items())}
   101	    allk = sorted(set().union(*[set(v) for v in K.values()]))
   102	    rows = []
   103	    for k in allk:
   104	        lbls = [K[s].get(k) for s in seeds]
   105	        robust = lab3(lbls)
   106	        rows.append(dict(key=k, incumbent=K[0].get(k), seeds=dict(zip(map(str, seeds), lbls)),
   107	                         label=('blocked (G-E2.3)' if blocked else robust),
   108	                         historical=None if blocked else hist(K[0].get(k), lbls, robust)))
   109	    spread = {}
   110	    for b, r in [(0, inc)] + list(new.items()):
   111	        if not ok(r):
   112	            continue
   113	        for k, v in r['configurations'].items():
   114	            spread.setdefault(k, {})[b] = (v['median_e'], v['worst_e'])
   115	    sp = {}
   116	    for k, v in spread.items():
   117	        s_ = [v[s] for s in seeds if s in v]
   118	        sp[k] = dict(incumbent=v.get(0), seeds={str(s): v.get(s) for s in seeds},
   119	                     median_minmax=[min(x[0] for x in s_), max(x[0] for x in s_)] if s_ else None,
   120	                     worst_minmax=[min(x[1] for x in s_), max(x[1] for x in s_)] if s_ else None,
   121	                     median_t=tint([x[0] for x in s_]), worst_t=tint([x[1] for x in s_]))
   122	    ratios = {}
   123	    for b in (seeds if dim == '2d' else []):            # 3D spread ratios: the gl64 panel rows (reported in the e2-3d files)
   124	        r = new[b]
   125	        if not ok(r):
   126	            continue
   127	        for k, v in r['h_acc_r'].items():
   128	            for tr, x in v.items():
   129	                if isinstance(x, dict) and x.get('median_paired_change') is not None:
   130	                    ratios.setdefault(f'{k}|{tr}', {})[b] = x['median_paired_change']
   131	    sr = {}
   132	    for kk, v in ratios.items():
   133	        kind, mesh, sc = kk.split('|')[:3]
   134	        lo = int(kk.split('|')[3].split('->')[0])
   135	        meds = [spread.get(f'{mesh}|R{lo}|{kind}|LSPG_{sc}_1', {}).get(s, (None,))[0] for s in seeds]
   136	        meds = [m_ for m_ in meds if m_ is not None]
   137	        num = (max(meds) - min(meds)) if len(meds) >= 2 else None
   138	        den = float(np.median([abs(x) for x in v.values()])) if v else None
   139	        if num is None or den is None:
   140	            sr[kk] = None
   141	        elif den == 0:
   142	            sr[kk] = 'undefined' if num == 0 else 'inf'
   143	        else:
   144	            sr[kk] = num / den
   145	    out = dict(dim=dim, seeds=seeds, blocked=blocked, rows=rows, spread=sp, spread_ratio=sr,
   146	               counts={l: sum(1 for x in rows if x['label'] == l) for l in ('seed-robust', 'seed-dependent', 'inconclusive')})
   147	    (HERE / 'checks' / f'e2-verdicts-{dim}.json').write_text(json.dumps(out, indent=1, default=float) + '\n')
   148	    print(json.dumps(out['counts']))
   149	
