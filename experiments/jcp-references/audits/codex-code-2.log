   144	def old_reference(dim, cohort, case, kind):
   145	    """The old first-order reference on the same lattice (2D f257; 3D c<j>), sha-checked against its job record."""
   146	    if dim == 2:
   147	        d = OLD2D.get(cohort)
   148	        if d is None:
   149	            return None
   150	        p = d / f'ref_{kind}_{cohort}_{case:03d}.npz'
   151	        if not p.exists():
   152	            return None
   153	        f = np.load(p)['f257']
   154	        rj = json.loads((d / 'result.json').read_text())
   155	        rec = [c for c in rj['cases'] if c['cohort'] == cohort and c['case'] == case and c['ref'] == kind]
   156	        assert rec and hashlib.sha256(np.ascontiguousarray(f).tobytes()).hexdigest() == rec[0]['f257_sha256'], p
   157	        return f
   158	    if kind != 'ST':
   159	        return None
   160	    p = OLD3D.get(cohort)
   161	    if p is None or not p.exists():
   162	        return None
   163	    done = json.loads(p.with_suffix('.done').read_text())
   164	    assert sha(p) == done['sha256'], p
   165	    return np.asarray(np.load(p)[f'c{case}'])
