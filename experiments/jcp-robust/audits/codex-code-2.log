   152	def fixture_fired(cpu_states, job_rho, n_states=6):
   153	    """A1.3 + A4.2: admitted (CPU: finite, target norm > 0, rho >= 1 at every state) and in-job rho >= 0.116 at >= 1 state
   154	    and agreement within 1 % relative at every state."""
   155	    if not cpu_states or not job_rho or len(cpu_states) != n_states or len(job_rho) != n_states:
   156	        return dict(admitted=False, fired=False, reason='missing')
   157	    admitted = all(s['ok'] for s in cpu_states)
   158	    if not admitted:
   159	        return dict(admitted=False, fired=False, reason='fixture not admitted')
   160	    job_rho = [num(j) for j in job_rho]
   161	    agree = all(np.isfinite(j) and abs(j - s['rho_tgt']) <= .01 * abs(s['rho_tgt']) for s, j in zip(cpu_states, job_rho))
   162	    flagged = any((not np.isfinite(j)) or j >= BAR_RHO for j in job_rho)
   163	    return dict(admitted=True, fired=bool(agree and flagged), agree=agree, flagged=flagged)
