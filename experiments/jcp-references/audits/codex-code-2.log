   191	def dimension_status(verdicts):
   192	    """A2.5: suspended if any FAIL (takes precedence over missing cases); validated if >= 6 of the 8 PASS; else
   193	    unvalidated. `verdicts` must list all 8 pre-registered cases ('MISSING' for an absent one)."""
   194	    if any(v == 'FAIL' for v in verdicts):
   195	        return 'suspended'
   196	    return 'validated' if sum(v == 'PASS' for v in verdicts) >= 6 else 'unvalidated'
