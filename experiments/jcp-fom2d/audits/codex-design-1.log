     1	"""jcp-time2 full-order model with the same two-step LMM time stepping (DESIGN section 9, A1.10, A2.21, A3.5).
     2	
     3	The project FOM (experiments/mr-burgers2d/engines.make_fom: sign-upwind advection, 5-point Laplacian, Newton with
     4	BiCGStab and the FFT-DST Helmholtz preconditioner) with its backward-Euler residual generalised to
     5	
     6	    a0 u + a1 u_n + a2 u_{n-1} + dt (b0 F(u) + b1 F(u_n)),   F(u) = a_h(u) - nu Lap_h u,
     7	
     8	preconditioner (a0 + dt b0 nu (lam_x + lam_y))^{-1} in the DST basis (BE: exactly engines.make_fom's). Startup steps
     9	by BE as in t2core.SCHEMES. dt, steps, output stride, coefficients and tolerances are traced. Per step it records the
    10	final nonlinear relative residual, the Newton count and the worst BiCGStab relative residual over that step's Newton
    11	iterations (amendment A10.1: per step, not per Newton iteration).
    12	A step fails iff its final nonlinear relative residual exceeds ntol or is nonfinite. Per-step arrays (final nonlinear
    13	relative residual, Newton count, worst linear relative residual of that step's Newton iterations) are returned for the
    14	first NMAX steps (entries beyond `steps` are NaN / -1).
    15	"""
    16	from __future__ import annotations
    17	
    18	import t2core as T2   # noqa: F401  (sys.path set-up)
    19	import jax
    20	import jax.numpy as jnp
    21	import engines as e
    22	
    23	BE_CO = T2.BE_CO
    24	
    25	
    26	NMAX = 800          # per-step diagnostic buffer (the longest schedule is dt0/8: 400 steps)
    27	
    28	
    29	def make_fom_lmm(L, max_newton=20):
    30	    k1 = jnp.arange(1, L, dtype=jnp.float64)
    31	    lam1 = 4 * L ** 2 * jnp.sin(jnp.pi * k1 / (2 * L)) ** 2
    32	    lam2 = lam1[:, None] + lam1[None, :]
    33	
    34	    def F(u, nu):
    35	        adv, lap = e.spatial(u, L)
    36	        return adv - nu * lap
    37	
    38	    def query(u0f, nu, sch, ntol, ltol):
    39	        dt = sch['dt']
    40	        be = jnp.asarray(BE_CO, jnp.float64)
    41	        u0 = u0f[1:-1, 1:-1].reshape(-1)
    42	        n = u0.shape[0]
    43	
    44	        def body(c):
    45	            k, un, um, out, st = c
    46	            co = jnp.where(k < sch['nstart'], be, sch['co'])
    47	            a0, a1, a2, b0, b1 = co[0], co[1], co[2], co[3], co[4]
    48	            Fn = jax.lax.cond(b1 != 0., lambda: F(un, nu), lambda: jnp.zeros(n, jnp.float64))
    49	            const = a1 * un + a2 * um + dt * b1 * Fn
    50	            res = lambda u: a0 * u + const + dt * b0 * F(u, nu)
    51	            den = a0 + dt * b0 * nu * lam2
    52	
    53	            def pre(v):
    54	                return e.dst2(e.dst2(v.reshape(L - 1, L - 1)) / den).reshape(-1)
    55	            scale = jnp.maximum(jnp.linalg.norm(un), 1e-300)
    56	
    57	            def nbody(s):
    58	                u, it, rn, lr = s
    59	                r = res(u)
    60	                jv = lambda v: jax.jvp(res, (u,), (v,))[1]
    61	                delta, _ = jax.scipy.sparse.linalg.bicgstab(jv, -r, tol=ltol, maxiter=200, M=pre)
    62	                lres = jnp.linalg.norm(jv(delta) + r) / jnp.maximum(jnp.linalg.norm(r), 1e-300)
    63	                cand = u + delta
    64	                return cand, it + 1, jnp.linalg.norm(res(cand)), jnp.maximum(lr, lres)
    65	            # predictor: the previous state (as engines.make_fom)
    66	            u, it, rn, lr = jax.lax.while_loop(lambda s: (s[2] > ntol * scale) & (s[1] < max_newton) & jnp.isfinite(s[2]),
    67	                                               nbody, (un, jnp.int32(0), jnp.linalg.norm(res(un)), jnp.float64(0.)))
    68	            rel = rn / scale
    69	            fail = ~(jnp.isfinite(rel) & (rel <= ntol))
    70	            ks = jnp.minimum(k, NMAX - 1)
    71	            st = dict(it_sum=st['it_sum'] + it, it_max=jnp.maximum(st['it_max'], it), nfail=st['nfail'] + fail.astype(jnp.int32),
    72	                      first_fail=jnp.where((st['first_fail'] < 0) & fail, k, st['first_fail']),
    73	                      worst_rel=jnp.maximum(st['worst_rel'], rel), worst_lres=jnp.maximum(st['worst_lres'], lr),
    74	                      step_rel=st['step_rel'].at[ks].set(rel), step_newton=st['step_newton'].at[ks].set(it),
    75	                      step_lres=st['step_lres'].at[ks].set(lr))
    76	            kk = k + 1
    77	            store = (kk % sch['keep']) == 0
    78	            out = jnp.where(store, out.at[jnp.clip(kk // sch['keep'], 0, 5)].set(u), out)
    79	            return kk, u, un, out, st
    80	
    81	        out0 = jnp.zeros((6, n), jnp.float64).at[0].set(u0)
    82	        st0 = dict(it_sum=jnp.int32(0), it_max=jnp.int32(0), nfail=jnp.int32(0), first_fail=jnp.int32(-1),
    83	                   worst_rel=jnp.float64(0.), worst_lres=jnp.float64(0.), step_rel=jnp.full(NMAX, jnp.nan),
    84	                   step_newton=jnp.full(NMAX, -1, jnp.int32), step_lres=jnp.full(NMAX, jnp.nan))
    85	        k, _, _, out, st = jax.lax.while_loop(lambda c: c[0] < sch['steps'], body, (jnp.int32(0), u0, u0, out0, st0))
    86	        fields = jnp.pad(out.reshape(6, L - 1, L - 1), ((0, 0), (1, 1), (1, 1)))
    87	        return dict(fields=fields, stats=dict(st, steps=k))
    88	
    89	    return jax.jit(query)

