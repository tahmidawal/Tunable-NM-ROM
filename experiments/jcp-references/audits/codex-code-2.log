    64	# ---------------------------------------------------------------------------------------------------------- 2D --
    65	
    66	def rowwise_2d(seed, n, kind):
    67	    """New 2D cohorts: row j from default_rng([seed, j]); prefix-stable."""
    68	    w_lo, w_hi = (.05, .20) if kind == 'family' else (.030, .050)
    69	    lo, hi = LOGNU_FAMILY if kind == 'family' else LOGNU_OOD
    70	    rows = []
    71	    for j in range(n):
    72	        r = np.random.default_rng([int(seed), int(j)])
    73	        cx, cy = r.uniform(.15, .85), r.uniform(.15, .85)
    74	        w = r.uniform(w_lo, w_hi)
    75	        a = r.uniform(.5, 2.)
    76	        nu = np.exp(r.uniform(lo, hi))
    77	        rows.append((cx, cy, w, a, nu))
    78	    return np.asarray(rows, float)
