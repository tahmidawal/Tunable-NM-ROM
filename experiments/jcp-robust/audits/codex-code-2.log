    66	def h_e1b(stats):
    67	    """stats: dict name -> label (from rank_interval). Configuration label of A2.2."""
    68	    labs = list(stats.values())
    69	    if not labs or any(l == 'unavailable' for l in labs):
    70	        return 'unavailable'
    71	    rest = [l for l in labs if l != 'insensitive']
    72	    if not rest:
    73	        return 'insensitive; typicality not assessed'
    74	    fav, unf = 'favourable' in rest, 'unfavourable' in rest
    75	    if fav and not unf:
    76	        return 'atypically favourable'
    77	    if unf and not fav:
    78	        return 'atypically unfavourable'
    79	    if fav and unf:
    80	        return 'mixed'
    81	    if all(l == 'typical' for l in rest):
    82	        return 'typical'
    83	    return 'indeterminate'
