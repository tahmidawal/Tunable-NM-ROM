   209	def qc_aggregate(metas, gpu_seconds):
   210	    """Frozen QC schema for sealed / OOD cohorts (A1.11, A2.9, A5.5): per kind, counts and quantiles only."""
   211	    def q(vals):
   212	        v = [x for x in vals if x is not None and np.isfinite(x)]
   213	        return dict(n=len(v), min=min(v) if v else None, median=float(np.median(v)) if v else None,
   214	                    max=max(v) if v else None)
   215	    out = dict(gpu_seconds=gpu_seconds, kinds={})
   216	    for kind in sorted({m['kind'] for m in metas}):
   217	        ms = [m for m in metas if m['kind'] == kind]
   218	        jd = [m['judge'] for m in ms]
   219	        k = dict(case_kinds=len(ms), outcomes={o: sum(m['outcome'] == o for m in ms) for o in V.OUTCOMES},
   220	                 refined=sum(m['refined'] for m in ms), tight=sum(m['tight_used'] for m in ms),
   221	                 attempts=sum(len(m['attempts']) for m in ms),
   222	                 failed_attempts=sum(not a['steps_ok'] for m in ms for a in m['attempts']),
   223	                 p=q([p for x in jd for p in x['p']]), p_undefined=sum(p is None for x in jd for p in x['p']),
   224	                 p_values=5 * len(ms), eps_ref=q([x['eps_ref'] for x in jd]), eps_ref_undefined=sum(
   225	                     x['eps_ref'] is None for x in jd), peclet=q([x['peclet'] for x in jd]),
   226	                 newton_total=q([float(sum(a['newton_total'] for a in m['attempts'])) for m in ms]))
   227	        out['kinds'][kind] = k
   228	    return out
