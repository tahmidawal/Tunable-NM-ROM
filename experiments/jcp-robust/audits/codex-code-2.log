     1	#!/bin/bash
     2	# jcp-robust E2 3D: the W1024 bank recipe (train2w.py, configs/train_r1024.json) for one recipe seed
     3	# (DESIGN.md 3.1, 3.3, A1.7). Only model_seed and subset_seed differ from the incumbent (make_config.py).
     4	#
     5	#   PY=<python> bash experiments/jcp-robust/train3d/run_seed.sh <seed|pilot> <outdir>
     6	#
     7	# <seed> = 1, 2, 3 -> configs/train_r1024_s<seed>.json;  pilot -> configs/train_r1024_pilot.json (200 bank steps).
     8	# Must be launched with the job root (<jobroot>/experiments/jcp-robust/...) as the layout; it cd's to <jobroot>
     9	# because the config's compare_bank is a repo-relative path. The incumbent job j3b ran on an H200 with --mem=420G.
    10	# Optional env: TRAIN3D_CONFIG=<path> overrides the config (CPU chaining test only; production never sets it).
    11	set -euo pipefail
    12	[ $# -eq 2 ] || { echo "usage: PY=<python> $0 <seed|pilot> <outdir>" >&2; exit 2; }
    13	WHICH=$1
    14	OUTDIR=$2
    15	: "${PY:?set PY to the python interpreter (cluster: /cluster/tufts/paralab/tawal01/ae-research/venv/bin/python)}"
    16	HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"            # <jobroot>/experiments/jcp-robust/train3d
    17	JOBROOT="$(cd "$HERE/../../.." && pwd)"
    18	case "$WHICH" in
    19	  pilot) CFG="$HERE/configs/train_r1024_pilot.json";;
    20	  1|2|3|4|5) CFG="$HERE/configs/train_r1024_s$WHICH.json";;
    21	  *) echo "seed must be 1..5 or pilot (seed 0 = the incumbent j3b)" >&2; exit 2;;
    22	esac
    23	CFG="${TRAIN3D_CONFIG:-$CFG}"
    24	[ -f "$CFG" ] || { echo "missing config $CFG" >&2; exit 2; }
    25	mkdir -p "$OUTDIR"
    26	OUTDIR="$(cd "$OUTDIR" && pwd)"
    27	[ ! -e "$OUTDIR/SEED-COMPLETE" ] || { echo "$OUTDIR/SEED-COMPLETE exists: refusing to rerun" >&2; exit 3; }
    28	log() { echo "[train3d $WHICH $(date -Is)] $*"; }
    29	
    30	# environment of the incumbent job (wide-bank runs/j3b/run.sbatch)
    31	export JAX_ENABLE_X64=true JAX_DEFAULT_MATMUL_PRECISION=highest
    32	export XLA_PYTHON_CLIENT_MEM_FRACTION=${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.90}
    33	export OPENBLAS_NUM_THREADS=8 OMP_NUM_THREADS=8 PYTHONDONTWRITEBYTECODE=1
    34	mkdir -p "$OUTDIR/tmp" "$OUTDIR/cache"
    35	export TMPDIR="$OUTDIR/tmp" XDG_CACHE_HOME="$OUTDIR/cache"
    36	
    37	log "host=$(hostname) config=$CFG jobroot=$JOBROOT commit=${SOURCE_COMMIT:-unset}"
    38	{ nvidia-smi --query-gpu=name,uuid,memory.total,driver_version --format=csv,noheader 2>/dev/null || echo "nvidia-smi unavailable"; } \
    39	  | tee "$OUTDIR/device.txt"
    40	if [ -z "${TRAIN3D_CONFIG:-}" ]; then
    41	  "$PY" -c "import jax,sys; b=jax.default_backend(); print(f'jax_backend={b}', flush=True); sys.exit(0 if b=='gpu' else 42)" \
    42	    | tee -a "$OUTDIR/device.txt" || exit 42
    43	fi
    44	"$PY" -I - "$HERE" "$CFG" <<'EOF'
    45	import hashlib, json, sys
    46	from pathlib import Path
    47	here, cfg = Path(sys.argv[1]), Path(sys.argv[2])
    48	bad = [f['path'] for f in json.loads((here / 'PROVENANCE.json').read_text())['files']
    49	       if hashlib.sha256((here.parent / f['path']).read_bytes()).hexdigest() != f['sha256']]
    50	print('PROVENANCE sha256 ' + ('OK' if not bad else 'MISMATCH ' + ' '.join(bad)), flush=True)
    51	c, b = json.loads(cfg.read_text()), json.loads((here / 'configs/train_r1024.json').read_text())
    52	if 'local_smoke' not in c:
    53	    d = sorted(k for k in b if c.get(k) != b[k])
    54	    assert set(c) == set(b) and set(d) <= {'model_seed', 'subset_seed', 'bank_steps', 'warmup'}, d
    55	    print('config differs from the incumbent only in', d, flush=True)
    56	sys.exit(1 if bad else 0)
    57	EOF
    58	
    59	# compare_bank = "experiments/jcp-wide-bank/vendor/quad3d/inputs/model_M2" (repo-relative, kept verbatim in every
    60	# config). The same bank (sha256 6687f259...) is vendored in this lane; link it at the path the config names.
    61	CB="$JOBROOT/experiments/jcp-wide-bank/vendor/quad3d/inputs/model_M2"
    62	if [ ! -e "$CB/bank.pkl" ]; then
    63	  mkdir -p "$(dirname "$CB")"
    64	  ln -s ../../../../jcp-robust/vendor/quad3d/inputs/model_M2 "$CB"
    65	fi
    66	echo "6687f259947ec08a986732db157db69c66f1110ab28125a029de17b4aa389af9  $CB/bank.pkl" | sha256sum -c --quiet
    67	
    68	cd "$JOBROOT"
    69	TIMECMD=""; [ -x /usr/bin/time ] && TIMECMD="/usr/bin/time -v -o $OUTDIR/time_v.txt"
    70	log "train2w.py (via memwrap.py: unchanged script, device peak recorded)"
    71	set +e
    72	$TIMECMD "$PY" -u "$HERE/memwrap.py" "$OUTDIR/memory.json" "$HERE/train2w.py" --config "$CFG" --out "$OUTDIR" \
    73	  > "$OUTDIR/train.out" 2> "$OUTDIR/train.err" &
    74	TPID=$!
    75	( while kill -0 $TPID 2>/dev/null; do C=$(pgrep -P $TPID | head -1); P=${C:-$TPID}
    76	    echo "RSS_SAMPLE $(date -Is) $(ps -o rss= -p $P 2>/dev/null) kB | $(tail -n 1 "$OUTDIR/train.out" | cut -c1-160)" >> "$OUTDIR/rss.log"
    77	    sleep 30; done ) &
    78	SPID=$!
    79	wait $TPID; RC=$?
    80	kill $SPID 2>/dev/null; set -e
    81	cat "$OUTDIR/train.out"; cat "$OUTDIR/train.err" >&2
    82	[ $RC -eq 0 ] || { log "train2w.py failed rc=$RC"; exit $RC; }
    83	grep -q "TRAINING COMPLETE" "$OUTDIR/train.out"
    84	
    85	"$PY" -I - "$OUTDIR" "$WHICH" "$CFG" <<'EOF'
    86	import json, sys
    87	from pathlib import Path
    88	o, which, cfg = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
    89	t = json.load(open(o / 'training.json'))
    90	m = json.load(open(o / 'memory.json'))
    91	assert t.get('complete') is True
    92	rec = dict(which=which, config=cfg, model_seed=t['config']['model_seed'], subset_seed=t['config']['subset_seed'],
    93	           bank_steps=t['config']['bank_steps'], selected_step=t['bank']['selected_step'],
    94	           selection_rule='lowest worst bank-validation projection error over the three groups (train2w.train_bank); '
    95	                          'incumbent j3b selected 11000', validation_worst_over_groups=t['bank']['validation_worst_over_groups'],
    96	           condition_65=t['bank'].get('condition_65'), ordering_inverse_check=t['ordering']['inverse_check'],
    97	           gpu=t.get('gpu'), backend=t.get('backend'), seconds=t.get('seconds'),
    98	           device_peak_GiB=m.get('peak_GiB'), device_bytes_limit=m.get('memory_stats', {}).get('bytes_limit'),
    99	           process_maxrss_kB=m.get('ru_maxrss_kB'), device=(o / 'device.txt').read_text().strip().splitlines(),
   100	           note='host MaxRSS of the job: sacct -j $SLURM_JOB_ID --format=JobID,MaxRSS,ReqMem,Elapsed')
   101	(o / 'run_record.json').write_text(json.dumps(rec, indent=1, default=float) + '\n')
   102	print('RUN RECORD', json.dumps({k: rec[k] for k in ('selected_step', 'bank_steps', 'device_peak_GiB', 'process_maxrss_kB')}))
   103	EOF
   104	rm -rf "$OUTDIR/tmp" "$OUTDIR/cache"
   105	( cd "$OUTDIR" && find . -type f ! -name OUTPUTS.sha256 ! -name SEED-COMPLETE -printf '%P\n' | sort \
   106	    | xargs sha256sum > OUTPUTS.sha256 )
   107	date -Is > "$OUTDIR/SEED-COMPLETE"
   108	log "SEED-COMPLETE ($OUTDIR)"
