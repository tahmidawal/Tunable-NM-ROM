    90	def nsteps(dt):
    91	    s, kp = int(round(.25 / dt)), int(round(.05 / dt))
    92	    assert abs(s * dt - .25) < 1e-12 and abs(kp * dt - .05) < 1e-12, dt
    93	    return s, kp
