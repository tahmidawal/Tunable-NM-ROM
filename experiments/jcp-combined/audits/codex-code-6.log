   244	def score3d(ent, run, check):
   245	    import c3common as C3
   246	    res = json.loads((run / 'result.json').read_text())
   247	    z = np.load(ent['file'])
   248	    cfg = res['config']
   249	    tab = C3.C.table(cfg['cohort_seed'], cfg['cohort_count'])
   250	    assert cfg['cohort_seed'] == ent['cohort_seed'] and tab['sha256'] == ent['cohort_table_sha256'], 'cohort table differs'
   251	    cases = cfg.get('case_subset') or list(range(cfg['cohort_count']))
   252	    i65 = C3.lattice65_index(65)
   253	    X65 = np.stack(np.meshgrid(*(np.arange(1, 64) / 64.,) * 3, indexing='ij'), -1).reshape(-1, 3)
   254	    n0 = {j: float(np.linalg.norm(np.asarray(C3.C.initial_interior(65, tab, j))[i65])) for j in cases}
   255	    Wz = np.load(run / f"W_{res['mode']}.npz")
   256	    R = {j: np.asarray(z[f'c{j}']) for j in cases}
   257	    out, gate = {}, dict(status='unchecked', compared=0, expected=0, worst=0., nonfinite=0, failures=0)
   258	    inrow = {(r['setting'], r['rule'], r['spec'], r['case']): r for r in res['rows']}
   259	    G, banks = {}, {}
   260	    for s in cfg['settings']:
   261	        bk = C3.load_bank(s['bank'])
   262	        assert bk['sha256'] == ent['bank_sha256'].get(s['bank']), 'bank not pinned by the registry entry'
   263	        banks[s['name']] = bk
   264	        G[s['name']] = np.asarray(C3.TB.feature_rows(bk['params'], bk['T'][:, :int(s['Rp'])], X65))
   265	    for key in Wz.files:
   266	        if key.startswith(('w0|', 'cases|')):
   267	            continue
   268	        sname, rule, spec = key.split('|', 2)
   269	        A = Wz[key]
   270	        ids = [int(x) for x in Wz[f'cases|{key}']] if f'cases|{key}' in Wz.files else list(cases)
   271	        assert len(ids) == A.shape[0], ('case ids do not match the trajectory array', key)
   272	        for ci, j in enumerate(ids):
   273	            F = A[ci] @ G[sname]
   274	            pe = [float(np.linalg.norm(F[k] - R[j][k])) / n0[j] for k in range(6)]
   275	            out[f'{key}|{j}'] = dict(ref=dict(per_time=pe, worst=max(pe[1:])))
   276	            if check:
   277	                gate['expected'] += 6
   278	                r = inrow.get((sname, rule, spec, j))
   279	                if r is None:
   280	                    continue
   281	                for k in range(6):
   282	                    x, y = pe[k], r['e_ref_per_time'][k]
   283	                    gate['compared'] += 1
   284	                    if not (np.isfinite(x) and np.isfinite(y)):
   285	                        gate['nonfinite'] += 1           # allowed only for an invalid in-job rollout
   286	                        gate['failures'] += 0 if (not (np.isfinite(x) or np.isfinite(y)) and not r.get('valid', True)) else 1
   287	                        continue
   288	                    gate['worst'] = max(gate['worst'], abs(x - y))
   289	                    gate['failures'] += 0 if tol_ok(x, y) else 1
   290	    ctrl = {}
   291	    if check:
   292	        key = next(k for k in Wz.files if k.endswith('|fs|BE|0.01|K1') or k.endswith('vendor|BE|0.01|K1'))
   293	        sname = key.split('|')[0]
   294	        A = Wz[key]
   295	        r0 = inrow[(sname, key.split('|')[1], key.split('|', 2)[2], cases[0])]
   296	        e = lambda F_, j: max(float(np.linalg.norm(F_[k] - R[j][k])) / n0[j] for k in range(1, 6))
   297	        F0 = A[0] @ G[sname]
   298	        ctrl['case_swap'] = abs(e(A[1] @ G[sname], cases[0]) - r0['e_ref']) if len(cases) > 1 else None
   299	        ctrl['time_shift'] = abs(e(np.roll(F0, 1, 0), cases[0]) - r0['e_ref'])
   300	        bk = banks[sname]
   301	        Rp = A.shape[-1]
   302	        Gs = np.asarray(C3.TB.feature_rows(bk['params'], bk['T'][:, :Rp], X65 + 1. / 64))
   303	        ctrl['lattice_shift_field_t005'] = float(np.linalg.norm((A[0][1] @ Gs) - F0[1])) / n0[cases[0]]
   304	        ctrl['all_break'] = bool(all(v is not None and v > 1e-6 for v in ctrl.values()))
   305	        arch = set()
   306	        for key in Wz.files:
   307	            if key.startswith(('w0|', 'cases|')):
   308	                continue
   309	            ids = [int(x) for x in Wz[f'cases|{key}']] if f'cases|{key}' in Wz.files else list(cases)
   310	            arch |= {(*key.split('|', 2), j) for j in ids}
   311	        rowk = {(r['setting'], r['rule'], r['spec'], r['case']) for r in res['rows']}
   312	        gate.update(rows_without_archive=len(rowk - arch), archive_without_rows=len(arch - rowk))
   313	        ok = (gate['compared'] == gate['expected'] and gate['failures'] == 0 and ctrl['all_break'] and
   314	              gate['rows_without_archive'] == 0 and gate['archive_without_rows'] == 0)
   315	        gate['status'] = 'pass' if ok else 'fail'
   316	    return out, gate, ctrl, {}
