    53	def two_way(eX, eY, eps, eligible=None, qualified=(True, True), names=('X', 'Y')):
    54	    """6.4 GAL vs LSPG (and LMF vs default): '<X> more accurate' / '<Y> more accurate' / 'neither' / inconclusive."""
    55	    if not all(qualified):
    56	        return 'inconclusive (unqualified cell)', None
    57	    p = paired(eY, eX, eps, eligible)                  # change e_X - e_Y; 'improve' = X more accurate than Y
    58	    if p['n_eligible'] == 0:
    59	        return 'inconclusive (no eligible cases)', p
    60	    if p['n_resolved'] < 0.5 * p['n_eligible']:
    61	        return 'inconclusive (resolution)', p
    62	    if p['improve'] > 0.5 * p['n_resolved'] and p['median_change'] < 0:
    63	        return f'{names[0]} more accurate', p
    64	    if p['worsen'] > 0.5 * p['n_resolved'] and p['median_change'] > 0:
    65	        return f'{names[1]} more accurate', p
    66	    return 'neither', p
