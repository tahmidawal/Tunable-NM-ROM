   461	def link_evidence(cx, x, ci, o, payload):
   462	    """A1.1 (3D): evidence linking the panel's untimed scoring run to the run certified earlier in the same job, kept as
   463	    separate items: identity (fs / qn: equal six outputs, internal states and per-step execution records; adaptive:
   464	    equal full payload hash), execution validity of the certified run, finite decoded fields of the scoring run, and
   465	    the certified run's numerical certificate count (non-certified steps). Timing acceptance needs identity, validity
   466	    and finite fields; numerical qualification (pooled certificate <= 1 %, distance to the anchors, Q2) is a property of
   467	    the configuration over its population and is decided by the analysis, never by the panel."""
   468	    ev = dict(identity=False, valid=False, fields_finite=bool('fields' in o and np.isfinite(np.asarray(o['fields'])).all()),
   469	              noncert=None)
   470	    if x['name'].startswith('T1|'):
   471	        return ev
   472	    j = cx.cases[ci]
   473	    tag, key = f"{x['setting']}|{x['rule']}", x['name'].split('|', 2)[2]
   474	    if key.startswith('ad|'):
   475	        p = cx.acc_sha.get((tag, key, j))
   476	        rec = cx.rep.get('ad_valid', {}).get(f'{tag}|{key}|{j}')
   477	        ev.update(identity=bool(p is not None and p == payload), valid=bool(rec is True),
   478	                  noncert=cx.rep.get('ad_noncert', {}).get(f'{tag}|{key}|{j}'))
   479	        return ev
   480	    W = cx.Wstore.get(f'{tag}|{key}')
   481	    Wall = cx.Wstore.get(f'wall|{tag}|{key}')
   482	    if W is None or Wall is None or 'W_all' not in o:
   483	        return ev
   484	    ids = list(cx.Cstore[f'{tag}|{key}'])
   485	    if j not in ids:
   486	        return ev
   487	    k_ = ids.index(j)
   488	    row = next((r for r in reversed(cx.rep['rows']) if r.get('tag') == tag and r.get('spec') == key and r.get('case') == j), None)
   489	    if row is None:
   490	        return ev
   491	    sp = S.parse_key(key)
   492	    rec_ok = json.dumps(S.step_record(sp, o, 0), sort_keys=True) == json.dumps(row['steps'], sort_keys=True)
   493	    ev.update(identity=bool(np.array_equal(np.asarray(o['W'])[:, 0], W[k_]) and
   494	                            np.array_equal(np.asarray(o['W_all'])[:, 0], Wall[k_]) and rec_ok),
   495	              valid=bool(row.get('valid') is True), noncert=row.get('nonstationary'))
   496	    return ev
