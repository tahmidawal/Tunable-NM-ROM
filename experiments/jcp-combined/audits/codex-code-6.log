    95	                out['settings'][sname] = ent
    96	                continue
    97	            absent = [r for r in FAMILIES['lattice'] + FAMILIES['gauss'] if r not in rules and r != base]
    98	            if absent:
    99	                ent.update(status=f'unavailable (ladder rules not evaluated: {absent})', deployed=None)
   100	                out['settings'][sname] = ent
   101	                continue
   102	            if CONTROL not in rules:
   103	                ent.update(status='unavailable (control lat256 not evaluated)', deployed=None)
   104	                out['settings'][sname] = ent
   105	                continue
   106	            ctrl_q = rules[CONTROL]['qualifies']
   107	            ent['control_qualifies'] = ctrl_q
   108	            mstar = {}
   109	            for fam, lad in FAMILIES.items():
   110	                q = [r for r in lad if rules.get(r, {}).get('qualifies')]
   111	                mstar[fam] = q[0] if q else None
   112	            ent['mstar'] = mstar
   113	            if ctrl_q:
   114	                ent.update(status='withheld (control lat256 qualifies: non-discriminating)', deployed=None)
   115	                out['settings'][sname] = ent
   116	                continue
   117	            cost = {}
   118	            for fam, r in mstar.items():
