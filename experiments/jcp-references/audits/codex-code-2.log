    41	def link(src, dst):
    42	    dst.parent.mkdir(parents=True, exist_ok=True)
    43	    if dst.exists():
    44	        if sha(dst) != sha(src):
    45	            raise RuntimeError(f'conflicting store file {dst}')
    46	        return
    47	    os.link(src, dst)
