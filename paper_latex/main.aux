\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Time to reach a target error on two-dimensional Burgers (6 development cases). Each point is the cheapest setting that meets the target: our model chooses its bank width, Newton--BiCGStab its time step and tolerance. Darker lines mean a stricter target. Fitting time $\propto N^p$ over $256^2$--$2048^2$ (one GPU type) gives $p\approx 0.05$ for our model and $p\approx 0.65$ for the solver; up to $4096^2$ our time grows less than twofold, the solver's about thirtyfold.}}{9}{figure.caption.26}\protected@file@percent }
\newlabel{fig:cost-scaling}{{2}{9}{Time to reach a target error on two-dimensional Burgers (6 development cases). Each point is the cheapest setting that meets the target: our model chooses its bank width, Newton--BiCGStab its time step and tolerance. Darker lines mean a stricter target. Fitting time $\propto N^p$ over $256^2$--$2048^2$ (one GPU type) gives $p\approx 0.05$ for our model and $p\approx 0.65$ for the solver; up to $4096^2$ our time grows less than twofold, the solver's about thirtyfold}{figure.caption.26}{}}
