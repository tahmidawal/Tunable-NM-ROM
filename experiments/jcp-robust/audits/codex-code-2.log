    44	def range_verdict(labels):
    45	    """6.1b: monotone iff every transition improves; 'not monotone' if any does not improve; else inconclusive."""
    46	    if labels and all(x == 'improves' for x in labels):
    47	        return 'monotone'
    48	    if any(x == 'does not improve' for x in labels):
    49	        return 'not monotone'
    50	    return 'inconclusive'
