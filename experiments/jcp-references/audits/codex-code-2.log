   203	def crosscheck_cases(dim):
   204	    """DESIGN §6/A1.7: the 4 validation cases with the smallest nu (ties by lower index) and the 4 lowest-index
   205	    remaining cases. 2D val32, 3D val64."""
   206	    if dim == 2:
   207	        nus = descriptors_2d('val32')[:, 4]
   208	    else:
   209	        (s, n), = HISTORICAL[3]['val64']
   210	        nus = b3.draw_param_table(s, n)['nu']           # raw draws only (s_star does not affect nu)
   211	    nus = np.asarray(nus, float)
   212	    c = type('C', (), {'n': len(nus)})
   213	    low = list(np.lexsort((np.arange(c.n), nus))[:4])
   214	    rest = [j for j in range(c.n) if j not in low][:4]
   215	    return sorted(int(j) for j in low + rest)

