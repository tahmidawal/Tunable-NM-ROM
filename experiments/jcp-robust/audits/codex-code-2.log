    45	                                                     backend=res['backend'], memory_rejected=res.get('memory_rejected', []))
    46	        Wz = np.load(d / f"W_{res['mode']}.npz")
    47	        tab = C3.C.table(int(cfg['cohort_seed']), int(cfg['cohort_count']))
    48	        cases = [int(x) for x in res['cohort']['cases']]
    49	        n0 = {j: float(np.linalg.norm(np.asarray(C3.C.initial_interior(65, tab, j)))) for j in cases}
    50	        lad = {}
    51	        for blk in res['blocks']:
    52	            if blk['kind'] == 'ladder':
