   342	def run_all(which, ps_N=None, ps_dt=None, ps_nu=0.01, dims=(2, 3), units=True):
   343	    """which: 'fd' (G1, G2, units), 'ps' (G3, G4, units), 'units', 'all'. ps_N: {d: largest N used} for G3b/G3c."""
   344	    res = []
   345	    t = time.perf_counter()
   346	    for f in ([u_order_solve, u_x1b, u_peclet, u_rng, u_crypto, u_transforms, u_ic3d] if units else []):
   347	        res.append(f())
   348	    if which in ('fd', 'all'):
   349	        for d in dims:
   350	            res.append(g1_parity(d))
   351	            res.append(g2_mms(d))
   352	    if which in ('ps', 'all'):
   353	        res.append(g4_projection())
   354	        for d in dims:
   355	            res.append(g3a_linear(d))
   356	            res.append(g4_mms(d))
   357	            if ps_N:
   358	                res.append(g3b_ic_quadrature(d, ps_N[d]))
   359	                res.append(g3c_contour(d, ps_N[d], ps_dt[d], ps_nu))
   360	    return dict(gates=res, all_pass=all(r['pass'] for r in res), seconds=time.perf_counter() - t)
