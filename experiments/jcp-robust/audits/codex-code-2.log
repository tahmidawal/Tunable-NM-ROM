     2	
     3	    python cluster/collect.py <attempt> [--partial]
     4	    python cluster/collect.py <attempt> --cleanup     (after the archive is verified and committed/manifested)
     5	"""
     6	import argparse
     7	import json
     8	import shlex
     9	import subprocess
    10	from pathlib import Path
    11	
    12	HERE = Path(__file__).resolve().parents[1]
    13	NAMESPACE = '/cluster/tufts/paralab/tawal01/jcp-robust'
    14	ARCHIVE = '/cluster/tufts/paralab/tawal01/burgers-archive/jcp-robust'
    15	SSH = ['timeout', '600', 'ssh', '-o', 'ConnectTimeout=20', 'tufts-login']
    16	
    17	
    18	def main():
    19	    p = argparse.ArgumentParser(description=__doc__)
    20	    p.add_argument('attempt')
    21	    p.add_argument('--partial', action='store_true')
    22	    p.add_argument('--cleanup', action='store_true')
    23	    a = p.parse_args()
    24	    assert a.attempt.isalnum()
    25	    remote = f'{NAMESPACE}/{a.attempt}'
    26	    out = HERE / 'runs' / a.attempt / 'archive'
    27	    if a.cleanup:
    28	        assert (out / 'OUTPUTS.sha256').exists(), 'collect first'
    29	        assert not (out / 'PARTIAL').exists(), 'a partial collection never authorises cleanup'
    30	        spec = json.loads((out / 'JOBSPEC.json').read_text())          # completion contract per staged step (code audit 1 #13)
    31	        need = []
    32	        for g in spec['groups']:
    33	            for st_ in g:
    34	                if 'driver' in st_:
    35	                    need.append(out / 'output' / f"{st_['driver']}_{Path(st_['config']).stem}" / 'COMPLETE')
    36	                else:
    37	                    need.append(out / st_['complete'].replace('OUT', 'output'))
    38	        assert need and all(p_.exists() for p_ in need), ('a staged step lacks its completion marker', [str(p_) for p_ in need if not p_.exists()])
    39	        log = '\n'.join(p.read_text() for p in (out / 'logs').glob('*.out'))
    40	        assert 'ALL-DONE' in log, 'job log lacks ALL-DONE'
    41	        subprocess.run(['sha256sum', '-c', 'OUTPUTS-LOCAL.sha256', '--quiet'], cwd=out, check=True)
    42	        if (out / 'LARGE.txt').read_text().strip():          # empty large-file list: nothing archived (code audit 1 #14)
    43	            chk = subprocess.run(SSH + [f'cd {ARCHIVE}/{a.attempt} && sha256sum -c {shlex.quote(remote)}/LARGE.sha256 --quiet'],
    44	                                 capture_output=True, text=True)
    45	            assert chk.returncode == 0, ('archive copy does not verify', chk.stderr)
    46	        q = subprocess.run(SSH + [f'squeue -h -n jr_{a.attempt} -o %i'], capture_output=True, text=True, check=True).stdout
    47	        assert not q.strip(), f'job jr_{a.attempt} still queued/running: {q}'
    48	        st = subprocess.run(SSH + [f'sacct -n -X -P --name jr_{a.attempt} -S now-7days -o State'], capture_output=True,
    49	                            text=True, check=True).stdout.split()
    50	        assert st and st[-1].split()[0] == 'COMPLETED', f'accounting state {st}'
    51	        subprocess.run(SSH + [f'rm -rf {shlex.quote(remote)}'], check=True)
    52	        print('removed', remote)
    53	        return
    54	    out.mkdir(parents=True, exist_ok=False)
    55	    pre = (f'cd {shlex.quote(remote)} && ' + ('find output -type f -print0 | sort -z | xargs -0 sha256sum > OUTPUTS.sha256 && '
    56	                                              if a.partial else '') +
    57	           'sha256sum -c OUTPUTS.sha256 --quiet && '
    58	           # brief 16: every output file > 100 MB is copied to the archive (verified) and left out of the pulled tar
    59	           f'mkdir -p {ARCHIVE}/{a.attempt} && find output -type f -size +100M | sort > LARGE.txt && '
    60	           f'(while read f; do mkdir -p "{ARCHIVE}/{a.attempt}/$(dirname "$f")" && cp "$f" "{ARCHIVE}/{a.attempt}/$f"; done < LARGE.txt) && '
    61	           f'(cd {ARCHIVE}/{a.attempt} && (cat {shlex.quote(remote)}/LARGE.txt | xargs -r sha256sum)) > LARGE.sha256 && '
    62	           f'(xargs -r sha256sum < LARGE.txt | cmp - LARGE.sha256) && '
    63	           'tar -cf collection.tar --exclude-from=LARGE.txt COMMIT.txt PROVENANCE.json MANIFEST.sha256 JOBSPEC.json '
    64	           'run.sbatch logs OUTPUTS.sha256 LARGE.txt LARGE.sha256 output && sha256sum collection.tar > collection.tar.sha256')
    65	    subprocess.run(SSH + [pre], check=True)
    66	    for name in ['collection.tar', 'collection.tar.sha256']:
    67	        subprocess.run(['timeout', '3600', 'scp', '-q', f'tufts-login:{remote}/{name}', str(out / name)], check=True)
    68	    subprocess.run(['sha256sum', '-c', 'collection.tar.sha256'], cwd=out, check=True)
    69	    subprocess.run(['tar', '-xf', 'collection.tar'], cwd=out, check=True)
    70	    large = set((out / 'LARGE.txt').read_text().split())
    71	    lines = [l for l in (out / 'OUTPUTS.sha256').read_text().splitlines() if l.split(None, 1)[1].strip() not in large]
    72	    (out / 'OUTPUTS-LOCAL.sha256').write_text('\n'.join(lines) + '\n')
    73	    subprocess.run(['sha256sum', '-c', 'OUTPUTS-LOCAL.sha256', '--quiet'], cwd=out, check=True)
    74	    (out / 'ARCHIVE-LOCATION.txt').write_text(f'{ARCHIVE}/{a.attempt}  (files listed in LARGE.txt / LARGE.sha256)\n')
    75	    (out / 'collection.tar').unlink()
    76	    if a.partial:
    77	        (out / 'PARTIAL').write_text('partial collection\n')
