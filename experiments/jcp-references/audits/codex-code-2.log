   244	def mode_fd(cfg, outdir, rep):
   245	    d = int(cfg['dim'])
   246	    ok, why = calib_status_ok(d)
   247	    rep['calib_status'] = why
   248	    if not ok and not cfg.get('smoke_override'):
   249	        log(f'REFUSING fd mode: {why}', sealed_ok=True)
   250	        raise SystemExit(5)
   251	    sealed = CH.is_sealed(d, cfg['cohort'])
   252	    key = cfg.get('key')
   253	    seed = None
   254	    if sealed:
   255	        QUIET[0] = True
   256	        seeds = SI.read_seeds(cfg['seeds_file'], key, cfg['seeds_plain_sha256'], cfg['seeds_cipher_sha256'])
   257	        seed = int(seeds[f"{d}d/{cfg['cohort']}"])
   258	    coh = CH.Cohort(d, cfg['cohort'], seed)
   259	    cases = cfg.get('cases') or list(range(coh.n))
   260	    rep['cohort'] = dict(name=coh.name, n=coh.n, sha256=None if sealed else coh.sha256,
   261	                         cases=None if sealed else cases, n_cases=len(cases))
   262	    manifest, metas = [], []
   263	    rep['cases'] = []
   264	    done = 0
   265	    for j in cases:
   266	        for kind in cfg['kinds']:
   267	            stem = outdir / f'{d}d' / coh.name / kind / f'c{j:03d}'
   268	            if sealed:
   269	                if any(Path(str(stem) + s).exists() for s in ('.npz.enc', '.json.enc')):
   270	                    raise SystemExit('sealed jobs never resume (A5.5): output exists')
   271	            elif Path(str(stem) + '.json').exists():
   272	                # verified resume: both files present, npz loads, identity matches; re-enter manifest and record
   273	                meta = json.loads(Path(str(stem) + '.json').read_text())
   274	                npz = Path(str(stem) + '.npz').read_bytes()
   275	                arr = np.load(str(stem) + '.npz')
   276	                assert (meta['cohort'], meta['case'], meta['kind']) == (coh.name, j, kind) and meta['final'][2] in arr
   277	                manifest.append(dict(file=str(stem.relative_to(outdir)) + '.npz', sha256=SI.sha(npz)))
   278	                manifest.append(dict(file=str(stem.relative_to(outdir)) + '.json',
   279	                                     sha256=SI.sha(Path(str(stem) + '.json').read_bytes())))
   280	                rep['cases'].append(dict(case=j, kind=kind, outcome=meta['outcome'], eps_ref=meta['judge']['eps_ref'],
   281	                                         p=meta['judge']['p'], seconds=meta.get('seconds'), resumed=True))
   282	                log(f'resumed (verified) {stem}')
   283	                continue
   284	            t = time.perf_counter()
   285	            arrays, meta = solve_case(coh, j, kind)
   286	            meta['job'] = job_info()
   287	            meta['seconds'] = time.perf_counter() - t
   288	            write_case(outdir, arrays, meta, sealed, key, manifest)
   289	            metas.append(meta)
   290	            done += 1
   291	            jd = meta['judge']
   292	            if sealed:
   293	                log(f'sealed item {done}/{len(cases) * len(cfg["kinds"])} written', sealed_ok=True)
   294	            else:
   295	                rep['cases'].append(dict(case=j, kind=kind, outcome=meta['outcome'], refined=meta['refined'],
   296	                                         tight=meta['tight_used'], eps_ref=jd['eps_ref'], p=jd['p'],
   297	                                         seconds=meta['seconds']))
   298	                log(f"CASE {coh.name} {j} {kind}: {meta['outcome']} eps={jd['eps_ref']} p={jd['p']} {meta['seconds']:.0f}s")
   299	                rep['manifest'] = manifest
   300	                save(outdir, rep)
   301	    if sealed:
   302	        del rep['cases']
   303	        mbytes = json.dumps(manifest).encode()
   304	        blob = SI.encrypt(mbytes, key)
   305	        atomic_write(outdir / 'manifest.json.enc', blob)
   306	        rep['sealed_manifest'] = dict(plain_sha256=SI.sha(mbytes), cipher_sha256=SI.sha(blob),
   307	                                      ciphertexts=[dict(file=m['file'], cipher=m['cipher']) for m in manifest])
   308	        rep['qc'] = qc_aggregate(metas, time.perf_counter() - T_BEGIN)
   309	    else:
   310	        rep['manifest'] = manifest
