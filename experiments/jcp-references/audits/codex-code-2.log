   124	def _finish_table(tab):
   125	    tab['s_star'] = b3.peak_on_reference_grid(tab)
   126	    h = hashlib.sha256()
   127	    for k in ('B', 'c', 'w', 'rho', 'A', 'nu', 's_star'):
   128	        h.update(np.ascontiguousarray(tab[k]).tobytes())
   129	    tab['sha256'] = h.hexdigest()
   130	    return tab
