   104	    and r['lam_sob'] == 0.0, 'Stage A train.json is not a complete base/sigma4/lam0 run of this seed'
   105	print('Stage A OK: steps_done', r['train']['steps_done'], 'recon mean', r['train']['recon_rel_l2_mean'],
