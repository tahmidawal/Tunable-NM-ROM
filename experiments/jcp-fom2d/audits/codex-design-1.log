   158	# ------------------------------------------------------------------------------------------------ lattice -----
   159	
   160	def lattice_S(N, m):
   161	    """(m-1, N-1) synthesis matrix sin(pi k x_i), x_i = i/m interior lattice coordinates."""
   162	    x = np.arange(1, m) / m
   163	    k = np.arange(1, N)
   164	    return jnp.asarray(np.sin(np.pi * np.outer(x, k)))
   165	
   166	
   167	def synth_lattice(b, S, d):
   168	    if d == 2:
   169	        v = S @ b @ S.T
   170	        return jnp.pad(v, 1)                                  # (257, 257) with zero walls (2D convention)
   171	    v = jnp.einsum('ia,jb,kc,abc->ijk', S, S, S, b)
   172	    return v.reshape(-1)                                      # (63^3,) flat, x slowest (3D convention)
   173	
   174	
   175	# --------------------------------------------------------------------------------------------- quadrature -----
   176	
   177	def composite_gl(panels, pts=32):
   178	    """Composite Gauss-Legendre on [0, 1]: `panels` equal panels x `pts` points."""
   179	    x, w = np.polynomial.legendre.leggauss(pts)
   180	    edges = np.arange(panels) / panels
   181	    X = (edges[:, None] + (x[None, :] + 1) / (2 * panels)).ravel()
   182	    W = np.tile(w / (2 * panels), panels)
   183	    return X, W
   184	
   185	
   186	def sine_integrals(fvals, X, W, N):
   187	    """I_k = 2 int_0^1 f(x) sin(k pi x) dx, k = 1..N-1, for fvals = f(X) (..., Q)."""
   188	    k = np.arange(1, N)
   189	    S = np.sin(np.pi * np.outer(X, k))                         # (Q, N-1)
   190	    return 2.0 * (np.asarray(fvals) * W) @ S
   191	
   192	
   193	def ic_coefs_2d(desc, N, panels=256):
   194	    cx, cy, w, a, _ = [float(v) for v in desc]
   195	    X, W = composite_gl(panels)
   196	    gx = sine_integrals(np.exp(-(X - cx) ** 2 / (2 * w * w)), X, W, N)
   197	    gy = sine_integrals(np.exp(-(X - cy) ** 2 / (2 * w * w)), X, W, N)
   198	    return a * np.outer(gx, gy)
   199	
   200	
   201	def ic_coefs_3d(tab, j, N, panels=256):
   202	    X, W = composite_gl(panels)
   203	    B = int(tab['B'][j])
   204	    out = np.zeros((N - 1,) * 3)
   205	    for b in range(B):
   206	        c, w, rho = tab['c'][j][b], float(tab['w'][j][b]), float(tab['rho'][j][b])
   207	        I = [sine_integrals(4 * X * (1 - X) * np.exp(-(X - c[a]) ** 2 / (2 * w * w)), X, W, N) for a in range(3)]
   208	        out += rho * np.einsum('i,j,k->ijk', *I)
   209	    return float(tab['A'][j]) / float(tab['s_star'][j]) * out
   210	
   211	
   212	# ----------------------------------------------------------------------------------------------- MMS (G4) -----
   213	
   214	MMS_NU = 0.05
   215	
   216	
   217	def phi(x):
   218	    return jnp.sin(jnp.pi * x) * jnp.exp(0.5 * jnp.sin(jnp.pi * x) ** 2)
   219	
   220	
   221	dphi = jax.vmap(jax.grad(phi))
   222	ddphi = jax.vmap(jax.grad(jax.grad(phi)))
   223	
   224	
   225	def amp(t):
   226	    return 1.0 + 0.5 * jnp.sin(4 * jnp.pi * t)
   227	
   228	
   229	damp = jax.grad(amp)
   230	
   231	
   232	def mms_exact(X, t):
   233	    """u*(X, t) on coordinate arrays X (list of d arrays)."""
   234	    out = amp(t)
   235	    for x in X:
   236	        out = out * phi(x)
   237	    return out
   238	
   239	
   240	def mms_forcing_grid(t, X, nu=MMS_NU):
   241	    """f = u*_t + u* sum_a d_a u* - nu Lap u* at coordinate arrays X (FD gate G2)."""
   242	    d = len(X)
   243	    P = [phi(x) for x in X]
   244	    dP = [dphi(x.ravel()).reshape(x.shape) for x in X]
   245	    ddP = [ddphi(x.ravel()).reshape(x.shape) for x in X]
   246	    A = amp(t)
   247	    prod = 1.0
   248	    for p in P:
   249	        prod = prod * p
   250	    ut = damp(t) * prod
   251	    adv = 0.0
   252	    lp = 0.0
   253	    for a in range(d):
   254	        term_d, term_dd = dP[a], ddP[a]
   255	        for b in range(d):
   256	            if b != a:
   257	                term_d = term_d * P[b]
   258	                term_dd = term_dd * P[b]
   259	        adv = adv + term_d
   260	        lp = lp + term_dd
   261	    return ut + A * prod * A * adv - nu * A * lp
   262	
   263	
   264	def mms_forcing_coefs(N, d, nu=MMS_NU, panels=256):
   265	    """Returns fn(t) -> forcing sine coefficients (N-1)^d, from separable 1D integrals (independent of the DST)."""
   266	    X, W = composite_gl(panels)
   267	    Xj = jnp.asarray(X)
   268	    p = np.asarray(phi(Xj))
   269	    dp = np.asarray(dphi(Xj))
   270	    ddp = np.asarray(ddphi(Xj))
   271	    I_p = jnp.asarray(sine_integrals(p, X, W, N))
   272	    I_pp = jnp.asarray(sine_integrals(p * p, X, W, N))
   273	    I_pdp = jnp.asarray(sine_integrals(p * dp, X, W, N))
   274	    I_ddp = jnp.asarray(sine_integrals(ddp, X, W, N))
   275	
   276	    def outer(vs):
   277	        if d == 2:
   278	            return vs[0][:, None] * vs[1][None, :]
   279	        return vs[0][:, None, None] * vs[1][None, :, None] * vs[2][None, None, :]
   280	
   281	    base = outer([I_p] * d)
   282	    adv = sum(outer([I_pdp if b == a else I_pp for b in range(d)]) for a in range(d))
   283	    lp = sum(outer([I_ddp if b == a else I_p for b in range(d)]) for a in range(d))
   284	
   285	    def fn(t):
   286	        A = amp(t)
   287	        return damp(t) * base + A * A * adv - nu * A * lp
   288	    return fn
   289	
   290	
   291	def mms_ic_coefs(N, d, panels=256):
   292	    X, W = composite_gl(panels)
   293	    I = jnp.asarray(sine_integrals(np.asarray(phi(jnp.asarray(X))), X, W, N))
   294	    if d == 2:
   295	        return amp(0.0) * I[:, None] * I[None, :]
   296	    return amp(0.0) * I[:, None, None] * I[None, :, None] * I[None, None, :]

