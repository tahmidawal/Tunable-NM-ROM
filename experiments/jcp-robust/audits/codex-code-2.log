    16	# --------------------------------------------------------------------------------------------- paired comparison
    17	def paired(eX, eY, eps, eligible=None):
    18	    """Counts and statistics of the paired change e_Y - e_X on eligible cases; resolved iff |e_Y - e_X| > 2 eps."""
    19	    eX, eY, eps = (np.asarray(a, float) for a in (eX, eY, eps))
    20	    el = np.ones(len(eX), bool) if eligible is None else np.asarray(eligible, bool)
    21	    d = (eY - eX)[el]
    22	    tie = np.abs(d) <= 2 * eps[el]
    23	    res = ~tie
    24	    return dict(n_eligible=int(el.sum()), n_resolved=int(res.sum()), improve=int(np.sum(res & (d < 0))),
    25	                worsen=int(np.sum(res & (d > 0))), tie=int(tie.sum()), ineligible=int((~el).sum()),
    26	                median_change=float(np.median(d)) if d.size else float('nan'),
    27	                worst_change=float(d[np.argmax(np.abs(d))]) if d.size else float('nan'))
