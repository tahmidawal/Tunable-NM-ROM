     2	
     3	    python certify.py inventory <config.json>                 print the unique-execution inventory of one config
     4	    python certify.py certify <attempt> [--timings checks/smoke-timings.json]
     5	        -> checks/inventory-<attempt>.json  (unique execution keys of every step: bank, mesh, rule, spec / arm, solver
     6	                                             level, case; controls and gates included; reuse marked)
     7	           checks/resources-<attempt>.json  (projection_hours = per GPU group: sum of setup + count x measured seconds of
     8	                                             that execution class, x 1.25; the job's GPU-h = groups run in parallel on
     9	                                             `gpus` GPUs, so the reservation is gpus x max-group hours; bound to the config
    10	                                             sha256s, the inventory sha256 and the GPU count)
    11	Measured seconds come from the smokes (checks/smoke-timings.json: {"<driver>|<class>": seconds per execution,
    12	"<driver>|setup|<mesh or setting>": seconds}); a class with no measurement makes certification fail (never a guess),
    13	except shell (training) steps, whose projection is stated in the job spec with its basis.
    14	"""
    15	import hashlib
    16	import json
    17	import sys
    18	from pathlib import Path
    19	
    20	HERE = Path(__file__).resolve().parent
    21	MARGIN = 1.25
    22	
    23	
    24	def _cases(spec, n_all=38):
    25	    if spec in (None, 'all38'):
    26	        return n_all
    27	    if spec == 'dev6':
    28	        return 6
    29	    if spec == 'sub16':
    30	        return 16
    31	    return len(spec)
    32	
    33	
    34	def inv_r2acc(c):
    35	    keys = []
    36	    m = c['mesh']
    37	    bank = (c.get('bank') or {}).get('ckpt_sha256', 'incumbent')
    38	    ids = list(range(_cases(c.get('cases', 'all38'))))
    39	    for g in c['groups']:
    40	        tids = list(range(min(len(ids), _cases(g.get('tighter_cases', 'dev6')))))
    41	        cids = list(range(min(len(ids), _cases(g.get('check_cases', 'dev6')))))
    42	        for arm in g['arms']:
    43	            ak = f"{arm['form']}_{arm['scheme']}_{float(arm['factor']):g}"
    44	            if g.get('target'):
    45	                keys += [(bank, m, g['name'], g['target'], ak, 'prod', 'target', i) for i in ids]
    46	            if g.get('check'):
    47	                keys += [(bank, m, g['name'], g['check'], ak, 'prod', 'check', i) for i in cids]
    48	            for r in g['rules']:
    49	                keys += [(bank, m, g['name'], r['rule'], ak, 'prod', 'rule', i) for i in ids]
    50	                if r.get('level', 'full') == 'full':
    51	                    keys += [(bank, m, g['name'], r['rule'], ak, 'tight', 'rule', i) for i in ids]
    52	                    keys += [(bank, m, g['name'], r['rule'], ak, 'tighter', 'rule', i) for i in tids]
    53	                    if r.get('succ'):
    54	                        keys += [(bank, m, g['name'], r['succ'], ak, 'prod', f"succ-of-{r['rule']}", i) for i in ids]
    55	        if g.get('permute'):
    56	            pr = next(r for r in g['rules'] if r['label'] == g['permute']['label'])
    57	            keys += [(bank, m, g['name'], pr['rule'], 'arm' + str(g['permute']['arm']), 'prod', 'permuted-replay', i) for i in ids]
    58	    return keys
    59	
    60	
    61	def inv_e13d(c):
    62	    keys = []
    63	    ids = c.get('case_subset') or list(range(c['cohort_count']))
    64	    for cf in c['configs']:
    65	        sp = cf['spec']
    66	        tcs = [j for j in cf.get('tighter_cases', list(range(8))) if j in ids]
    67	        chk = [j for j in cf.get('check_cases', list(range(8))) if j in ids]
    68	        keys += [('W1024', cf['setting'], cf['target'], sp, 'prod', 'target', j) for j in ids]
    69	        keys += [('W1024', cf['setting'], cf['check'], sp, 'prod', 'check', j) for j in chk]
    70	        for s in cf['draws']:
    71	            rl, su = f"lat{cf['n']}s{s}", f"lat{cf['succ_n']}s{s}"
    72	            keys += [('W1024', cf['setting'], rl, sp, 'prod', 'draw', j) for j in ids]
    73	            keys += [('W1024', cf['setting'], rl, sp, 'adt-tight', 'draw', j) for j in ids]
    74	            keys += [('W1024', cf['setting'], rl, sp, 'adt-tighter', 'draw', j) for j in tcs]
    75	            keys += [('W1024', cf['setting'], su, sp, 'prod', f'succ-of-{rl}', j) for j in ids]
    76	        for rl in cf.get('extra', []) + ([cf['bad']] if cf.get('bad') else []):
    77	            keys += [('W1024', cf['setting'], rl, sp, 'prod', 'diag', j) for j in ids]
    78	        if cf.get('permute'):
    79	            keys += [('W1024', cf['setting'], f"lat{cf['n']}s0", sp, 'prod', 'permuted-replay', j) for j in ids]
    80	    return keys
    81	
    82	
    83	def inv_d3(c):
    84	    keys = []
    85	    ids = c.get('case_subset') or list(range(c['cohort_count']))
    86	    bank = {s['name']: s['bank'] for s in c['settings']}
    87	    for b in c['blocks']:
    88	        if b['kind'] == 'ladder':
    89	            tcs = [j for j in b.get('tighter_cases', list(range(8))) if j in ids]
    90	            st = b['setting']
    91	            for rl in b['rungs']:
    92	                for sp in b['specs']:
    93	                    keys += [(bank[st], st, rl, sp, 'prod', 'rung', j) for j in ids]
    94	                for sd in sorted({tuple(sp.split('|')[1:3]) for sp in b['specs']}):
    95	                    keys += [(bank[st], st, rl, f'ad|{sd[0]}|{sd[1]}', 'adt-tight', 'rung', j) for j in ids]
    96	                    keys += [(bank[st], st, rl, f'ad|{sd[0]}|{sd[1]}', 'adt-tighter', 'rung', j) for j in tcs]
    97	        elif b['kind'] == 'panel':
    98	            for sp in [b['A']] + b['subjects']:
    99	                for j in range(int(b['cases'])):
   100	                    for r_ in range(int(b['reps'])):
   101	                        keys.append((bank[sp['setting']], sp['setting'], sp['rule'], sp['spec'], 'timed-triplet', b['label'], j, r_))
   102	    return keys
   103	
   104	
   105	INV = {'r2acc': inv_r2acc, 'e1run3d': inv_e13d, 'd3run': inv_d3, 'e2run3d': inv_d3}
