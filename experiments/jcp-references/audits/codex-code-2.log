   477	def main():
   478	    ap = argparse.ArgumentParser()
   479	    ap.add_argument('--config', required=True)
   480	    ap.add_argument('--out', required=True)
   481	    a = ap.parse_args()
   482	    cfg = json.loads(Path(a.config).read_text())
   483	    outdir = Path(a.out)
   484	    outdir.mkdir(parents=True, exist_ok=True)
   485	    if not cfg.get('allow_cpu'):
   486	        assert jax.default_backend() == 'gpu', jax.default_backend()
   487	    assert os.environ.get('JAX_DEFAULT_MATMUL_PRECISION') == 'highest'
   488	    print(f'jax_backend={jax.default_backend()} x64=True precision=highest', flush=True)
   489	    rep = dict(config={k: v for k, v in cfg.items() if k not in ('seeds_file', 'key')}, job=job_info(), complete=False)
   490	    if cfg.get('smoke_override'):            # LOCAL FUNCTIONAL SMOKE ONLY (A4.4 v): reduced levels; never a reference
   491	        assert not os.environ.get('SLURM_JOB_ID'), 'smoke_override is refused inside a cluster job'
   492	        so = cfg['smoke_override']
   493	        for kind, dd in so.get('levels', {}).items():
   494	            for dim, v in dd.items():
   495	                LEVELS[kind][int(dim)] = dict(base=[tuple(x) for x in v['base']], refine=tuple(v['refine']),
   496	                                              scheme=v['scheme'])
   497	        for dim, v in so.get('ps', {}).items():
   498	            PS_CFG[int(dim)].update(v)
   499	        for dim, v in so.get('x1', {}).items():
   500	            X1_LEVELS[int(dim)] = [tuple(x) for x in v]
   501	        rep['SMOKE_OVERRIDE'] = True
   502	    pre = G.run_all('units')
   503	    for dd in (2, 3):
   504	        pre['gates'].append(G.g1_parity(dd))
   505	    if cfg['mode'] == 'gates':
   506	        full = G.run_all('all', ps_N={2: PS_CFG[2]['esc'][-1], 3: PS_CFG[3]['esc'][-1]},
   507	                         ps_dt={2: PS_CFG[2]['dt'], 3: PS_CFG[3]['dt']}, units=False)
   508	        pre['gates'] += full['gates']
   509	    if cfg['mode'] == 'ps':                  # PS jobs: G3/G4 of their dimension in the same job (A2.4 step 2)
   510	        dd = int(cfg['dim'])
   511	        att = int(cfg.get('attempt', 0))
   512	        Ns = cfg.get('Ns') or (PS_CFG[dd]['Ns'] if att == 0 else PS_CFG[dd]['esc'])
