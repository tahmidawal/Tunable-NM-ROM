   143	def ic_3d(L, tab, j, chunk=1 << 24):
   144	    """Canonical interior IC (flat, x slowest) on the (L+1)-node grid: common.initial_interior for L <= 256; above that
   145	    the same b3d_common._blob_sum evaluated on coordinate chunks (memory; elementwise identical formula, checked
   146	    against the unchunked vendor call by the unit gate Uic3d)."""
   147	    if L <= 256:
   148	        return np.asarray(C3.initial_interior(L + 1, tab, j), float)
   149	    return ic_3d_chunked(L, tab, j, chunk)
   150	
   151	
   152	def ic_3d_chunked(L, tab, j, chunk=1 << 24):
   153	    n = L + 1
   154	    ni = n - 2
   155	    ax = np.linspace(0.0, 1.0, n)[1:-1]
   156	    row = b3.table_row(tab, j)
   157	    out = np.empty(ni ** 3)
   158	    plane = ni * ni
   159	    step = max(1, chunk // plane)
   160	    Y, Z = np.meshgrid(ax, ax, indexing='ij')
   161	    yz = np.stack([Y.ravel(), Z.ravel()], 1)
   162	    for i0 in range(0, ni, step):
   163	        xs = ax[i0:i0 + step]
   164	        coords = np.concatenate([np.concatenate([np.full((plane, 1), x), yz], 1) for x in xs])
   165	        s = np.asarray(b3._blob_sum(coords, row))
   166	        out[i0 * plane:(i0 + len(xs)) * plane] = row['A'] * s / float(tab['s_star'][j])
   167	    return out
