   239	def ic_lattice(cohort, j):
   240	    """Canonical t0 field on the scoring lattice (nodal samples at the lattice nodes)."""
   241	    d = cohort.dim
   242	    m = LATTICE[d]
   243	    if d == 2:
   244	        return np.asarray(CH.ic_2d(m, cohort.D[j]))
   245	    return CH.ic_3d(m, cohort.T, j)
     1	"""jcp-references: independent pseudo-spectral cross-check solver (DESIGN §3.3, A1.6, A2.3, A2.6, A2.7, A3.4, A3.6).
     2	
     3	State: continuous sine-series coefficients b_k, u(x) = sum_k b_k prod_a sin(k_a pi x_a), 1 <= k_a <= N-1.
     4	Linear part exact: L_k = -nu pi^2 |k|^2. Nonlinear part -u sum_a d_a u: u and d_a u are synthesised on the 3/2-padded
     5	grid (M = 3N/2 intervals, interior nodes j = 1..M-1) by sine (DST-I type) and, along a, cosine (DCT-I type) sums,
     6	multiplied pointwise and projected back with the trapezoid rule b_k = (2/M)^d sum_j f_j prod sin(pi k_a j_a / M),
     7	then truncated to k_a < N. This is oversampled collocation (a quadrature of the sine projection, O(M^-4) error for
     8	these integrands), not exact de-aliasing (A1.6). Time: ETDRK4 (Cox-Matthews), coefficients by the Kassam-Trefethen
     9	contour mean (32 points; checked against 64). Forcing (gate G4 only): coefficient arrays at the stage times.
    10	
    11	IC: sine coefficients of the CONTINUOUS u0 by composite Gauss-Legendre quadrature of its separable 1D factors
    12	(A1.6/A2.6; see amendment A4 for the composite rule). Outputs: lattice values by direct synthesis of the series at the
    13	scoring-lattice coordinates. All large arrays are traced jit arguments.
    14	"""
    15	from __future__ import annotations
    16	
    17	import math
    18	
    19	import numpy as np
    20	import jax
    21	jax.config.update('jax_enable_x64', True)
    22	import jax.numpy as jnp
    23	
    24	
    25	# ------------------------------------------------------------------------------------------------ transforms --
    26	
    27	def _ext_fft(o):
    28	    return jnp.fft.rfft(o, axis=-1)
    29	
    30	
    31	def sine_synth_last(b, M):
    32	    """b (..., M-1) coefficients -> S_j = sum_k b_k sin(pi k j / M), j = 1..M-1."""
    33	    z = jnp.zeros(b.shape[:-1] + (1,), b.dtype)
    34	    o = jnp.concatenate((z, b, z, -b[..., ::-1]), -1)          # odd extension, length 2M
    35	    return -_ext_fft(o).imag[..., 1:M] / 2.0
    36	
    37	
    38	def cos_synth_last(g, M):
    39	    """g (..., M-1) coefficients (k = 1..M-1) -> C_j = sum_k g_k cos(pi k j / M), j = 1..M-1."""
    40	    z = jnp.zeros(g.shape[:-1] + (1,), g.dtype)
    41	    e = jnp.concatenate((z, g, z, g[..., ::-1]), -1)           # even extension, length 2M
    42	    return _ext_fft(e).real[..., 1:M] / 2.0
    43	
    44	
    45	def along(fn, x, axis, M):
    46	    return jnp.moveaxis(fn(jnp.moveaxis(x, axis, -1), M), -1, axis)
    47	
    48	
    49	def analysis(f, M):
    50	    """Trapezoid sine projection on every axis: b_k = (2/M)^d sum_j f_j prod_a sin(pi k_a j_a / M)."""
    51	    for ax in range(f.ndim):
    52	        f = along(sine_synth_last, f, ax, M) * (2.0 / M)
    53	    return f
    54	
    55	
    56	def kvec(n, d, axis):
    57	    """k_a * pi broadcast along `axis` for coefficient arrays of side n (= M - 1 or N - 1)."""
    58	    k = jnp.arange(1, n + 1, dtype=jnp.float64) * jnp.pi
    59	    shp = [1] * d
    60	    shp[axis] = n
    61	    return k.reshape(shp)
    62	
    63	
    64	def nonlinear(b, N, d):
    65	    """-P[u sum_a d_a u] (coefficients, (N-1)^d) and max |u| on the padded grid."""
    66	    M = 3 * N // 2
    67	    pad = [(0, M - N)] * d
    68	    bp = jnp.pad(b, pad)
    69	    n = M - 1
    70	    S = lambda x, ax: along(sine_synth_last, x, ax, M)
    71	    Cc = lambda x, ax: along(cos_synth_last, x, ax, M)
    72	    if d == 2:
    73	        Ty = S(bp, 1)
    74	        u = S(Ty, 0)
    75	        g = Cc(kvec(n, 2, 0) * Ty, 0) + S(Cc(kvec(n, 2, 1) * bp, 1), 0)
    76	    else:
    77	        Tz = S(bp, 2)
    78	        Tyz = S(Tz, 1)
    79	        u = S(Tyz, 0)
    80	        g = (Cc(kvec(n, 3, 0) * Tyz, 0) + S(Cc(kvec(n, 3, 1) * Tz, 1), 0)
    81	             + S(S(Cc(kvec(n, 3, 2) * bp, 2), 1), 0))
    82	    f = analysis(u * g, M)
    83	    sl = tuple(slice(0, N - 1) for _ in range(d))
    84	    return -f[sl], jnp.max(jnp.abs(u))
    85	
    86	
    87	def lin_eig(N, d, nu):
    88	    k = np.arange(1, N, dtype=np.float64)
    89	    ks = [k.reshape([-1 if a == b else 1 for b in range(d)]) for a in range(d)]
    90	    return -nu * np.pi ** 2 * sum(x ** 2 for x in ks)
    91	
    92	
    93	# ------------------------------------------------------------------------------------------------ ETDRK4 -------
    94	
    95	def etdrk4_coefs(Lk, h, Mc=32):
    96	    """Kassam-Trefethen contour means (accumulated point by point; no (n, Mc) array)."""
    97	    Lk = jnp.asarray(Lk)
    98	    acc = [jnp.zeros_like(Lk) for _ in range(4)]
    99	    for j in range(1, Mc + 1):
   100	        r = np.exp(1j * np.pi * (j - 0.5) / Mc)
   101	        LR = h * Lk + r
   102	        eLR = jnp.exp(LR)
   103	        acc[0] = acc[0] + ((jnp.exp(LR / 2) - 1) / LR).real
   104	        acc[1] = acc[1] + ((-4 - LR + eLR * (4 - 3 * LR + LR ** 2)) / LR ** 3).real
   105	        acc[2] = acc[2] + ((2 + LR + eLR * (-2 + LR)) / LR ** 3).real
   106	        acc[3] = acc[3] + ((-4 - 3 * LR - LR ** 2 + eLR * (4 - LR)) / LR ** 3).real
   107	    Q, f1, f2, f3 = (h * a / Mc for a in acc)
   108	    return dict(E=jnp.exp(h * Lk), E2=jnp.exp(h * Lk / 2), Q=Q, f1=f1, f2=f2, f3=f3)
   109	
   110	
   111	def make_ps(N, d, nonlin_on=True, forcing=None):
   112	    """Return run(b0, nu, dt, lat_S, Mc=32) -> dict(lat (6, ...lattice...), umax, finite).
   113	    forcing: None or fn(t) -> coefficient array (N-1)^d (G4)."""
   114	
   115	    def Nfun(b, t):
   116	        if nonlin_on:
   117	            nb, um = nonlinear(b, N, d)
   118	        else:
   119	            nb, um = jnp.zeros_like(b), jnp.max(jnp.abs(b)) * 0.0
   120	        if forcing is not None:
   121	            nb = nb + forcing(t)
   122	        return nb, um
   123	
   124	    def step(carry, co, dt):
   125	        v, t, umax = carry
   126	        Nv, m1 = Nfun(v, t)
   127	        a = co['E2'] * v + co['Q'] * Nv
   128	        Na, m2 = Nfun(a, t + dt / 2)
   129	        b = co['E2'] * v + co['Q'] * Na
   130	        Nb, m3 = Nfun(b, t + dt / 2)
   131	        c = co['E2'] * a + co['Q'] * (2 * Nb - Nv)
   132	        Nc, m4 = Nfun(c, t + dt)
   133	        v = co['E'] * v + Nv * co['f1'] + 2 * (Na + Nb) * co['f2'] + Nc * co['f3']
   134	        return v, t + dt, jnp.maximum(umax, jnp.maximum(jnp.maximum(m1, m2), jnp.maximum(m3, m4)))
   135	
   136	    def block(v, t, umax, co, dt, nsteps):
   137	        def body(i, c):
   138	            return step(c, co, dt)
   139	        return jax.lax.fori_loop(0, nsteps, body, (v, t, umax))
   140	    jblock = jax.jit(block, static_argnums=(5,))
   141	
   142	    def run(b0, nu, dt, lat_S, Mc=32):
   143	        keep = int(round(0.05 / dt))
   144	        assert abs(keep * dt - 0.05) < 1e-12, dt
   145	        co = etdrk4_coefs(jnp.asarray(lin_eig(N, d, nu)), dt, Mc)
   146	        v = jnp.asarray(b0)
   147	        t, umax = jnp.float64(0.0), jnp.float64(0.0)
   148	        lats = [synth_lattice(v, lat_S, d)]
   149	        for _ in range(5):
   150	            v, t, umax = jblock(v, t, umax, co, jnp.float64(dt), keep)
   151	            lats.append(synth_lattice(v, lat_S, d))
   152	        lat = np.stack([np.asarray(x) for x in lats])
   153	        fin = bool(np.isfinite(lat).all() and np.isfinite(float(umax)) and bool(jnp.all(jnp.isfinite(v))))
   154	        return dict(lat=lat, umax=float(umax), finite=fin, coef_final=v)
   155	    return run
