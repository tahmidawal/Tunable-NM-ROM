   172	class Cohort:
   173	    """Uniform view: .n, .nu(j), .ic(L, j) -> interior array of shape (L-1,)*dim, .desc(j) (JSON-able), .sha256."""
   174	
   175	    def __init__(self, dim, name, seed=None):
   176	        self.dim, self.name = dim, name
   177	        if dim == 2:
   178	            self.D = descriptors_2d(name, seed)
   179	            self.n = len(self.D)
   180	            self.sha256 = hashlib.sha256(np.ascontiguousarray(self.D).tobytes()).hexdigest()
   181	        else:
   182	            self.T = table_3d(name, seed)
   183	            self.n = int(self.T['m'])
   184	            self.sha256 = self.T['sha256']
   185	
   186	    def nu(self, j):
   187	        return float(self.D[j, 4]) if self.dim == 2 else float(self.T['nu'][j])
   188	
   189	    def ic(self, L, j):
   190	        if self.dim == 2:
   191	            return ic_2d(L, self.D[j])[1:-1, 1:-1]
   192	        return ic_3d(L, self.T, j).reshape((L - 1,) * 3)
   193	
   194	    def desc(self, j):
   195	        if self.dim == 2:
   196	            return dict(zip(('cx', 'cy', 'w', 'a', 'nu'), map(float, self.D[j])))
   197	        T = self.T
   198	        B = int(T['B'][j])
   199	        return dict(B=B, c=T['c'][j][:B].tolist(), w=T['w'][j][:B].tolist(), rho=T['rho'][j][:B].tolist(),
   200	                    A=float(T['A'][j]), nu=float(T['nu'][j]), s_star=float(T['s_star'][j]))
