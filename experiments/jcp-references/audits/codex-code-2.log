    35	HISTORICAL = {
    36	    2: {'dev6': [(7090702, 4), (911702, 2)], 'val32': [(20260927, 32)], 'test64': [(20260916, 64)]},
    37	    3: {'dev4': [(923651, 4)], 'val64': [(923801, 64)], 'test32': [(923901, 32)]},
