   313	def mode_calib(cfg, outdir, rep):
   314	    d = int(cfg['dim'])
   315	    name, cases = CALIB_CASES[d]
   316	    coh = CH.Cohort(d, name)
   317	    rep['calib'], rep['d1'], rep['x1'], rep['x4'] = [], [], [], None
   318	    store = {}
   319	
   320	    def keep(tag, rec, lat, res, nwt):
   321	        store[tag] = lat
   322	        store['res_' + tag] = res
   323	        store['nwt_' + tag] = nwt
   324	        return rec
   325	
   326	    for j in cases:
   327	        n0 = float(np.linalg.norm(RC.ic_lattice(coh, j).ravel()))
   328	        for kind in ('ST', 'S'):
   329	            cfgk = LEVELS[kind][d]
   330	            for L, dt in cfgk['base']:
   331	                recs = {}
   332	                for purpose in ('prod', 'tight', 'tighter'):
   333	                    rec, lat, res, nwt = attempt(coh, j, L, dt, cfgk['scheme'], purpose)
   334	                    recs[purpose] = keep(f'{kind}_c{j}_L{L}_{purpose}', rec, lat, res, nwt)
   335	                diff = lambda a, b: float(np.max(V.tnorm(store[f'{kind}_c{j}_L{L}_{a}'] -
   336	                                                          store[f'{kind}_c{j}_L{L}_{b}'])[1:]) / n0)
   337	                row = dict(case=j, kind=kind, L=L, dt=dt, prod_vs_tight=diff('prod', 'tight'),
   338	                           tight_vs_tighter=diff('tight', 'tighter'), records=recs)
   339	                row['proxy_ok'] = bool(row['prod_vs_tight'] <= recs['prod']['tau'] and
   340	                                       row['tight_vs_tighter'] <= recs['tight']['tau'])
   341	                row['ratio_prod'] = row['prod_vs_tight'] / recs['prod']['tau']
   342	                row['ratio_tight'] = row['tight_vs_tighter'] / recs['tight']['tau']
   343	                rep['calib'].append(row)
   344	                log(f"CALIB {kind} c{j} L={L}: prod-tight {row['prod_vs_tight']:.3e} (tau {recs['prod']['tau']:.3e}) "
   345	                    f"tight-tighter {row['tight_vs_tighter']:.3e} (tau {recs['tight']['tau']:.3e}) ok={row['proxy_ok']} "
   346	                    f"prod solve {recs['prod']['solve_seconds']:.1f}s peak {recs['prod']['peak_bytes']}")
   347	                save(outdir, rep)
   348	        # D1 (R_ST): time-only ladder at the finest L (dt of the three levels), space-only ladder at the finest dt
   349	        (L1, dt1), (L2, dt2), (L3, dt3) = LEVELS['ST'][d]['base']
   350	        tl = []
   351	        for dt in (dt1, dt2, dt3):
   352	            tag = f'ST_c{j}_L{L3}_prod' if dt == dt3 else f'D1t_c{j}_L{L3}_dt{dt:.3e}'
   353	            if tag not in store:
   354	                keep(tag, *attempt(coh, j, L3, dt, 'cnr', 'prod'))
   355	            tl.append(store[tag])
   356	        sl = []
   357	        for L in (L1, L2, L3):
   358	            tag = f'ST_c{j}_L{L3}_prod' if L == L3 else f'D1s_c{j}_L{L}_dt{dt3:.3e}'
   359	            if tag not in store:
   360	                keep(tag, *attempt(coh, j, L, dt3, 'cnr', 'prod'))
   361	            sl.append(store[tag])
   362	        for name_, lad, hs in (('time', tl, (dt1, dt2, dt3)), ('space', sl, (1 / L1, 1 / L2, 1 / L3))):
   363	            d12, d23 = V.tnorm(lad[0] - lad[1])[1:], V.tnorm(lad[1] - lad[2])[1:]
   364	            rep['d1'].append(dict(case=j, ladder=name_, p=[V.solve_order(d12[k], d23[k], *hs) for k in range(5)],
   365	                                  d12=(d12 / n0).tolist(), d23=(d23 / n0).tolist()))
   366	        log(f"D1 c{j}: {rep['d1'][-2:]}")
   367	        save(outdir, rep)
   368	    for j in range(coh.n):                     # X1: upwind + BE ladder on every dev case (must be rejected)
   369	        lv = []
   370	        for L, dt in X1_LEVELS[d]:
   371	            rec, lat, res, nwt = attempt(coh, j, L, dt, 'be', 'prod', adv='upwind')
   372	            keep(f'X1_c{j}_L{L}', rec, lat, res, nwt)
   373	            lv.append(dict(L=L, lat=lat, tau=rec['tau'], steps_ok=rec['steps_ok'], umax=rec['umax_running']))
   374	        jd = V.judge(lv, RC.ic_lattice(coh, j), coh.nu(j))
   375	        rep['x1'].append(dict(case=j, p=jd['p'], outcome=jd['outcome']))
   376	        log(f"X1 c{j}: p={jd['p']} {jd['outcome']}")
   377	        save(outdir, rep)
   378	    if d == 2:                                 # X4 probe: dev6 case 0, R_ST, middle level dt doubled
   379	        lv = []
   380	        for i, (L, dt) in enumerate(LEVELS['ST'][2]['base']):
   381	            dtx = dt * (2 if i == 1 else 1)
   382	            tag = f'ST_c0_L{L}_prod' if (i != 1 and 0 in cases) else f'X4_L{L}_dt{dtx:.3e}'
   383	            if tag not in store:
   384	                keep(tag, *attempt(coh, 0, L, dtx, 'cnr', 'prod'))
   385	            lv.append(dict(L=L, lat=store[tag], tau=V.floor_proxy(store['res_' + tag], len(store['res_' + tag])),
   386	                           steps_ok=V.steps_ok(store['res_' + tag], len(store['res_' + tag])), umax=0.0))
   387	        jd = V.judge(lv, RC.ic_lattice(coh, 0), coh.nu(0))
   388	        rep['x4'] = dict(p=jd['p'], outcome=jd['outcome'], note='umax not used (probe)')
   389	        log(f"X4: {rep['x4']}")
   390	    np.savez(outdir / f'calib_{d}d_fields.npz', **store)
   391	    rep['calib_fields_sha256'] = SI.sha((outdir / f'calib_{d}d_fields.npz').read_bytes())
   392	    rep['calib_status'] = dict(dim=d, floor_stab=V.FLOOR_STAB, proxy_ok_all=all(r['proxy_ok'] for r in rep['calib']),
   393	                               worst_ratio_prod=max(r['ratio_prod'] for r in rep['calib']),
   394	                               worst_ratio_tight=max(r['ratio_tight'] for r in rep['calib']),
   395	                               job=job_info(), fields_sha256=rep['calib_fields_sha256'])
   396	
