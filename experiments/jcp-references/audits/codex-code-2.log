    64	def nonlinear(b, N, d):
    65	    """-P[u sum_a d_a u] (coefficients, (N-1)^d) and max |u| on the padded grid."""
    66	    M = 3 * N // 2
    67	    pad = [(0, M - N)] * d
    68	    bp = jnp.pad(b, pad)
    69	    n = M - 1
    70	    S = lambda x, ax: along(sine_synth_last, x, ax, M)
    71	    Cc = lambda x, ax: along(cos_synth_last, x, ax, M)
    72	    if d == 2:
    73	        Ty = S(bp, 1)
    74	        u = S(Ty, 0)
    75	        g = Cc(kvec(n, 2, 0) * Ty, 0) + S(Cc(kvec(n, 2, 1) * bp, 1), 0)
    76	    else:
    77	        Tz = S(bp, 2)
    78	        Tyz = S(Tz, 1)
    79	        u = S(Tyz, 0)
    80	        g = (Cc(kvec(n, 3, 0) * Tyz, 0) + S(Cc(kvec(n, 3, 1) * Tz, 1), 0)
    81	             + S(S(Cc(kvec(n, 3, 2) * bp, 2), 1), 0))
    82	    f = analysis(u * g, M)
    83	    sl = tuple(slice(0, N - 1) for _ in range(d))
    84	    return -f[sl], jnp.max(jnp.abs(u))
