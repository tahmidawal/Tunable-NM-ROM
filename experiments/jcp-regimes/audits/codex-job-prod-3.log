--- /dev/null
+++ b/experiments/jcp-regimes/runs/rom1024/experiments/jcp-regimes/vendor/quad3d/make_configs.py
@@ -0,0 +1,47 @@
+"""Write every job config of DESIGN.md section 9 into configs/ (deterministic; rerun to regenerate)."""
+import hashlib
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+NS = '/cluster/tufts/paralab/tawal01/quad3d_20261001'
+REF_TOL = (1e-6, 1e-7)        # refined-reference tolerances: set from the smoke1 probe by the DESIGN section 4 rule (R3)
+RULES_SHA = hashlib.sha256((HERE / 'rules' / 'rules.npz').read_bytes()).hexdigest()
+BASE = dict(
+    Rps=[512, 256], dt=0.01, gtol=1e-3, trust_fraction=0.05,
+    model='experiments/quadrature-burgers3d/inputs/model_M2',
+    expected_model_sha256='6687f259947ec08a986732db157db69c66f1110ab28125a029de17b4aa389af9',
+    rules_npz='experiments/quadrature-burgers3d/rules/rules.npz', expected_rules_sha256=RULES_SHA,
+    rules=['lat4096', 'lat8192', 'lat16384', 'lat32768', 'kor16381', 'gl16', 'gl24', 'gl32', 'sob16384',
+           'lat256', 'smol8'],
+    controls=['lat256', 'smol8'],
+    continuum_target='gl80', continuum_check='gl64', converged_rule='lat32768', audit_rule='lat4096',
+    cert_draws=[[923811, 8], [923812, 8], [923813, 8]],
+    ref_ntol=1e-10, ref_ltol=1e-11,
+    fom_grid=[[0.005, 0.01, 0.1], [0.005, 0.001, 0.1], [0.01, 0.01, 0.1], [0.01, 0.001, 0.1],
+              [0.025, 0.01, 0.1], [0.025, 0.001, 0.1]],
+    timing_cases=16, reps=3, refined_wait_hours=1.5,
+    expected_ref=dict(n=513, dt=0.0025, ntol=REF_TOL[0], ltol=REF_TOL[1], accepted=True))
+DENSE = {65: 'all', 129: 4, 257: 0}
+SEL = HERE / 'selection.json'
+
+
+def write(name, cfg):
+    (HERE / 'configs' / f'{name}.json').write_text(json.dumps(cfg, indent=1) + '\n')
+
+
+for n in (65, 129, 257):
+    write(f'val_n{n}', dict(BASE, mesh=n, dense_cases=DENSE[n], cohort_seed=923801, cohort_count=64,
+                            refined_ref=f'{NS}/ref1/code/output/ref_923801.npz'))
+write('ref_run', dict(mode='run', n_ref=513, dt_ref=0.0025, probe_seed=923651, ntol=REF_TOL[0], ltol=REF_TOL[1],
+                      cohorts=[[923801, 64], [923901, 32]]))
+if SEL.exists():                    # held-out configs only once the frozen selection exists (DESIGN section 7)
+    sel_sha = hashlib.sha256(SEL.read_bytes()).hexdigest()
+    for n in (65, 129, 257):
+        write(f'ho_n{n}', dict(BASE, mesh=n, dense_cases=DENSE[n], cohort_seed=923901, cohort_count=32,
+                               refined_ref=f'{NS}/ref1/code/output/ref_923901.npz',
+                               selection='experiments/quadrature-burgers3d/selection.json', selection_sha256=sel_sha))
+write('smoke_n65', dict(BASE, mesh=65, dense_cases=2, cohort_seed=923651, cohort_count=4,
+                        cert_draws=[[923811, 2]], timing_cases=2, reps=2, refined_wait_hours=0))
+write('ref_probe', dict(mode='probe', n_ref=513, dt_ref=0.0025, probe_seed=923651,
+                        tolerances=[[1e-6, 1e-7], [1e-8, 1e-9], [1e-10, 1e-11]], compare_meshes=[257]))
diff --git a/experiments/jcp-regimes/runs/rom1024/experiments/jcp-regimes/vendor/quad3d/make_report.py b/experiments/jcp-regimes/runs/rom1024/experiments/jcp-regimes/vendor/quad3d/make_report.py
new file mode 100644
index 000000000..e5620b7d6
--- /dev/null
+++ b/experiments/jcp-regimes/runs/rom1024/experiments/jcp-regimes/vendor/quad3d/make_report.py
@@ -0,0 +1,518 @@
+"""quadrature-burgers3d: generate the report from the run JSONs (no hand-typed numbers).
+
+    make_report.py --out reports/2026-10-01-burgers3d-offmesh-quadrature.md
+
+Inputs (all committed under results/): select-val.json, select-ho.json, refined-val.json, refined-ho.json,
+audit-*.json, the panels' result.json (runs/*/code/output/result.json), ref1 / rck1 / smoke1 result.json.
+Every number in the report comes from these files; prose that states a number reads it from them.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import statistics
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+RES = HERE / 'results'
+MESHES = ['65', '129', '257']
+CELLS = {'65': '64³', '129': '128³', '257': '256³'}
+RPS = ['512', '256']
+OFF = ['lat4096', 'lat8192', 'lat16384', 'lat32768', 'kor16381', 'gl16', 'gl24', 'gl32', 'sob16384', 'lat256',
+       'smol8']
+
+
+def J(p):
+    return json.loads(Path(p).read_text())
+
+
+def pct(x, d=2):
+    return '–' if x is None else f'{100 * x:.{d}f} %'
+
+
+def sci(x, d=1):
+    return '–' if x is None else f'{x:.{d}e}'
+
+
+def fx(x, d=1, unit=''):
+    return '–' if x is None else f'{x:.{d}f}{unit}'
+
+
+def gb(b):
+    return '–' if b is None else (f'{b / 1e9:.2f} GB' if b >= 1e8 else f'{b / 1e6:.1f} MB')
+
+
+def sha(p):
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--out', required=True)
+    ap.add_argument('--dry', action='store_true', help='layout test: validation data in place of held-out')
+    a = ap.parse_args()
+    ho = 'val' if a.dry else 'ho'
+    sv, sh = J(RES / 'select-val.json'), J(RES / f'select-{ho}.json')
+    rv, rh = J(RES / 'refined-val.json'), J(RES / f'refined-{ho}.json')
+    pv = {n: J(HERE / 'runs' / f'val{n}' / 'code' / 'output' / 'result.json') for n in MESHES}
+    ph = {n: J(HERE / 'runs' / f'{ho}{n}' / 'code' / 'output' / 'result.json') for n in MESHES}
+    ref = J(HERE / 'runs' / 'ref1' / 'code' / 'output' / 'result.json')
+    rck = J(HERE / 'runs' / 'rck1' / 'code' / 'output' / 'result.json') if not a.dry else \
+        dict(job_id='DRY', recheck=[dict(lattice_diff_vs_reference=0.0)])
+    probe = J(HERE / 'runs' / 'smoke1' / 'code' / 'output' / 'ref_probe' / 'result.json')['probe']
+    aud = {f'{c}{n}': J(RES / f'audit-{(ho if c == "ho" else c)}{n}.json') for c in ('val', 'ho') for n in MESHES}
+    L = []
+    w = L.append
+
+    rck_max = max(r['lattice_diff_vs_reference'] for r in rck['recheck'])
+    sg_ref = {n: max(rh['panels'][n]['same_grid_reference']) for n in MESHES}
+
+    # ---------------------------------------------------------------- title and status
+    w('# Off-mesh quadrature for the Burgers 3D reduced model at 64³, 128³ and 256³')
+    w('')
+    w('This report replaces only the advection term of our frozen Burgers 3D span model ($R = 512$ coordinate-network '
+      'bank) by Hari\'s off-mesh quadrature of the continuum term, and compares it with the incumbent precomputed '
+      'quadratic tensor against a refined reference, on 64 validation and 32 held-out cases. **Status: final** for the '
+      'held-out numbers (frozen settings, evaluated once by this lane after the selection was frozen); validation '
+      'numbers are the selection data. All numbers are generated by `experiments/quadrature-burgers3d/make_report.py` '
+      'from the run JSONs.')
+    w('')
+    # ---------------------------------------------------------------- answers
+    w('## Answers')
+    w('')
+    lbg = sv['lattice_beats_gauss'] and sh['lattice_beats_gauss']
+    w(f'1. **Lattice vs Gauss at equal $m$ — {"yes, everywhere" if lbg else "not everywhere"}.** ' +
+      ' '.join(f'At {CELLS[n]}, $R\' = {Rp}$: worst continuum ρ of the 4096-point CBC lattice '
+               f'{sci(sv["meshes"][n]["R"][Rp]["rows"][f"lat4096_R{Rp}"]["rho_cont"]["worst"])} vs Gauss 16³ '
+               f'{sci(sv["meshes"][n]["R"][Rp]["rows"][f"gl16_R{Rp}"]["rho_cont"]["worst"])}; 32768-point lattice '
+               f'{sci(sv["meshes"][n]["R"][Rp]["rows"][f"lat32768_R{Rp}"]["rho_cont"]["worst"])} vs Gauss 32³ '
+               f'{sci(sv["meshes"][n]["R"][Rp]["rows"][f"gl32_R{Rp}"]["rho_cont"]["worst"])}.'
+               for n in MESHES for Rp in RPS[:1]) +
+      ' The smallest lattice size whose validation worst refined error is at most the tensor\'s: ' +
+      ', '.join(f'{CELLS[n]}/{Rp}: {sv["meshes"][n]["R"][Rp]["smallest_m_reaching_tensor"]}'
+                for n in MESHES for Rp in RPS) + '; the smallest lattice size within $10^{-3}$ of the converged '
+      'off-mesh rollout: ' + ', '.join(f'{CELLS[n]}/{Rp}: {sv["meshes"][n]["R"][Rp]["smallest_m_reaching_converged"]}'
+                                       for n in MESHES for Rp in RPS) + '.')
+    w('')
+    w('2. **Does the off-mesh solve reproduce the tensor against the refined reference?** Held-out worst refined error, '
+      'selected off-mesh rule vs tensor: ' + '; '.join(
+          f'{CELLS[n]}/{Rp}: {sh["meshes"][n]["R"][Rp]["selected"] or "none"} '
+          f'{pct((sh["meshes"][n]["R"][Rp]["selected_row"] or {}).get("refined_worst"))} vs '
+          f'{pct(sh["meshes"][n]["R"][Rp]["tensor_row"]["refined_worst"])}'
+          for n in MESHES for Rp in RPS) + '. See section 4 for the mesh-invariance verdict.')
+    w('')
+    w('3. **Cost.** Held-out median ms per query, selected off-mesh rule vs tensor (same allocation): ' + '; '.join(
+        f'{CELLS[n]}/{Rp}: {fx((sh["meshes"][n]["R"][Rp]["selected_row"] or {}).get("ms"))} vs '
+        f'{fx(sh["meshes"][n]["R"][Rp]["tensor_row"]["ms"])} ms'
+        for n in MESHES for Rp in RPS) + '. Section 5 has memory, Jacobian time and both speedup rules.')
+    w('')
+    w('4. **k-head revisited (optional): not run.** Nothing was retrained.')
+    w('')
+
+    # ---------------------------------------------------------------- what changed
+    w('## 1. What was changed')
+    w('')
+    w('```mermaid')
+    w('flowchart LR')
+    w('  U0["initial field on the mesh"] --> P["project onto the frozen bank span (mesh Gram)"]')
+    w('  P --> LM["Levenberg–Marquardt per time step (cached predictor)"]')
+    w('  LM --> LIN["linear terms: A = Φᵀ Ĝ, discrete λ (exact, mesh)"]')
+    w('  LM --> ADV{"advection a(c) and Jacobian"}')
+    w('  ADV --> T["tensor: ½ cᵀ T c (mesh backward difference, M R′² numbers)"]')
+    w('  ADV --> Q["off-mesh: Pᵀ((Bc)⊙(Dc)) at m rule points (continuum u·∇u)"]')
+    w('  ADV --> D["dense: sign-upwind on every node (64³ only)"]')
+    w('  LM --> OUT["six output fields decoded on the mesh"]')
+    w('  classDef frozen fill:#dbeafe,stroke:#1e40af;')
+    w('  classDef solved fill:#dcfce7,stroke:#166534;')
+    w('  classDef rule fill:#fef3c7,stroke:#92400e;')
+    w('  class P,LIN,OUT frozen;')
+    w('  class LM solved;')
+    w('  class T,Q,D,ADV rule;')
+    w('```')
+    w('')
+    w('The off-mesh term is')
+    w('')
+    w('$$ a_m(c) = N^{3/2}\\sum_{q=1}^{m} w_q\\,\\psi_m(x_q)\\,u(x_q)\\,\\big(u_x+u_y+u_z\\big)(x_q),\\qquad '
+      'u(x_q) = \\hat G(x_q)\\,c, $$')
+    w('')
+    w('with the bank and its analytic $(1,1,1)$-derivative evaluated at the rule points. It is a quadrature of the '
+      '*continuum* advection, whereas the tensor and the full-order model use the mesh\'s first-order backward/upwind '
+      'difference; the two differ by the stencil\'s $O(h)$ consistency gap. Linear terms, the projection of $u_0$ and '
+      'the output decoding are the mesh operators in every arm. Solver, $\\Delta t = 0.01$, $R\' \\in \\{512, 256\\}$ '
+      'and the test count $M \\approx 4R\'$ are identical across arms (DESIGN.md).')
+    w('')
+
+    # ---------------------------------------------------------------- reference
+    w('## 2. The refined reference and its own uncertainty')
+    w('')
+    cases_ref = [c for co in ref['cohorts'].values() for c in co['cases']]
+    w(f'Full-order model at 513 nodes (512³ cells), $\\Delta t = 0.0025$, tolerances $(10^{{-6}}, 10^{{-7}})$ (DESIGN R3), '
+      f'job {ref["job_id"]} on {ref["gpu"]}: {len(cases_ref)} cases, median '
+      f'{fx(statistics.median(c["seconds"] for c in cases_ref))} s per case, every case accepted. '
+      f'Re-solving four validation cases at $(10^{{-10}}, 10^{{-11}})$ (job {rck["job_id"]}) changes them by '
+      + ', '.join(sci(r['lattice_diff_vs_reference'], 3) for r in rck['recheck']) +
+      ' relative to $\\lVert u_0\\rVert$ (four cases: an observation, not a bound for all cases)' + (
+          f' — above the $10^{{-5}}$ threshold of DESIGN R4, so the reference is declared tolerance-limited at that '
+          f'level and refined-error differences below {sci(10 * rck_max, 3)} are unresolved' if rck_max > 1e-5 else '') +
+      '. The same-grid references at the lane\'s meshes differ from it, '
+      'worst over the held-out cases, by ' + ', '.join(f'{pct(sg_ref[n])} ({CELLS[n]})' for n in MESHES) +
+      f'; on the probe case the 257-node reference differed from the 513-node one by '
+      f'{pct(probe["same_grid_257"]["lattice_diff_vs_refined"])}, and the post-hoc Richardson estimate '
+      '$u_R = 2u_{513} - u_{257}$ (both $h$ and $\\Delta t$ halved between the two references) is displaced from it '
+      f'by up to {pct(max(rh["richardson"]["ref513_vs_R"]))} over the held-out cases. These are refinement '
+      'discrepancies, not error bounds: the reference is a first-order upwind solution whose own error is of that '
+      'order, so refined-error differences between arms at that scale are not read as established accuracy '
+      'differences. $u_R$ assumes an asymptotic first-order error expansion and is not a verified continuum solution.')
+    w('')
+
+    # ---------------------------------------------------------------- rho
+    w('## 3. Quadrature error ρ on reached states')
+    w('')
+    w('Worst (median) ρ over the evolved tensor-reached states of 24 certification cases (923811–923813), against the '
+      'continuum target (Gauss 80³) and against the mesh target (sign-upwind on every node). Validation jobs.')
+    w('')
+    for Rp in RPS:
+        w(f'**$R\' = {Rp}$**')
+        w('')
+        w('| rule | $m$ | ' + ' | '.join(f'ρ continuum {CELLS[n]}' for n in MESHES) + ' | ' +
+          ' | '.join(f'ρ mesh {CELLS[n]}' for n in MESHES) + ' |')
+        w('|---|---|' + '---|' * 6)
+        for rule in ['tensor', 'dense_upwind'] + OFF:
+            m = None
+            cells_c, cells_m = [], []
+            for n in MESHES:
+                r = pv[n]['rho'][Rp]['rules'][rule]
+                cells_c.append(f'{sci(r["cont"]["worst"])} ({sci(r["cont"]["median"])})')
+                cells_m.append(f'{sci(r["mesh"]["worst"])}')
+                if rule in OFF:
