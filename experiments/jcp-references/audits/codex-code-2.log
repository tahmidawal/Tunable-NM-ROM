   179	                u3, _ = fd_finest(dim, cohort, kind, case)
   180	                n0 = m['judge']['n0']
   181	                t0dev = float(np.linalg.norm((old[0] - u3[0]).ravel()) / n0)
   182	                e_t = (V.tnorm(old - u3)[1:] / n0).tolist()
   183	                rows.append(dict(cohort=cohort, kind=kind, case=case, delta_old=max(e_t), delta_t=e_t,
   184	                                 eps_ref=m['judge']['eps_ref'], t0_dev=t0dev, outcome=m['outcome'],
   185	                                 fires=bool(m['judge']['eps_ref'] is not None and max(e_t) > m['judge']['eps_ref'])))
   186	    return rows
