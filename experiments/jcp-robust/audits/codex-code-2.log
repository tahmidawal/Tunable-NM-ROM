   177	def arm_verdicts(a):
   178	    """H-E1a/b/c and the indicator table over the registered draws d0..d15 (A2.2, A3.2-A3.4, A4.2)."""
   179	    if any(l not in a['rules'] for l in DRAWS):
   180	        return dict(population='unavailable (registered draws d0..d15 not all present)')
   181	    dr = [a['rules'][l] for l in DRAWS]
   182	    n = len(dr[0]['e'])
   183	    elig = [all(d['eligible'][i] for d in dr) for i in range(n)]
   184	    ok_e = [i for i in range(n) if elig[i]]
   185	    t = a['target']
   186	    tgt_full = bool(t['present'] and t['certified'] and t['all_valid'])
   187	    h_a = E.h_e1a([d['qualified'] for d in dr]) if tgt_full else \
   188	        dict(E.h_e1a([d['own_family_qualified'] for d in dr]), basis='Q1 + own-family Q2 only (target not certified / failed)')
   189	    if not ok_e:
   190	        return dict(H_E1a=h_a, H_E1b=dict(label='unavailable'), H_E1c=dict(label='unavailable', n=0), indicator='unavailable',
   191	                    eligible_cases=0)
   192	    eps = np.array(dr[0]['eps'], float)
   193	    delta = 2 * float(np.max(eps[ok_e]))                                  # A3.4: uniform bound
   194	    agg = lambda fn, d: math.inf if any(not d['valid'][i] for i in ok_e) else float(fn([d['e'][i] for i in ok_e]))
   195	    stats = {}
   196	    if tgt_full:
   197	        stats['D'] = E.rank_interval([d['D'] for d in dr], 0.)
   198	    stats['median_e'] = E.rank_interval([agg(np.median, d) for d in dr], delta)
   199	    stats['worst_e'] = E.rank_interval([agg(np.max, d) for d in dr], delta)
   200	    failed = np.array([[not d['valid'][i] for i in range(n)] for d in dr])
   201	    emat = np.array([d['e'] for d in dr], float)
   202	    econv = t['econv'] if tgt_full else [None] * n
   203	    h_c = E.h_e1c(emat, emat[0], failed, eps, econv, elig)
   204	    if not tgt_full:
   205	        h_c['margin'] = '2 eps_ref only (target-free fallback)'
   206	    ind = 'unavailable (target not certified / failed)'
   207	    if tgt_full:
   208	        ind = dict(tp=0, fp=0, fn=0, tn=0)
   209	        for d in dr:
   210	            i_ok, r_ok = d['rho_tgt_max'] <= E.BAR_RHO, d['D'] <= E.BAR_Q2
   211	            ind[('t' if i_ok == r_ok else 'f') + ('p' if i_ok else 'n')] += 1
   212	        ind['draw0'] = dict(rho_ok=dr[0]['rho_tgt_max'] <= E.BAR_RHO, rollout_ok=dr[0]['D'] <= E.BAR_Q2)
   213	    return dict(H_E1a=h_a, H_E1b=dict(label=E.h_e1b({k: v[2] for k, v in stats.items()}),
   214	                                       stats={k: list(v) for k, v in stats.items()}, delta_error=delta),
   215	                H_E1c=h_c, indicator=ind, eligible_cases=len(ok_e))
