df -h /cluster/tufts/paralab | tail -1
for i in $(seq 0 $(({gpus} - 1))); do
  CUDA_VISIBLE_DEVICES=$i "$PY" -c "import jax,sys; b=jax.default_backend(); print(f'jax_backend={{b}} gpu_index=$i',flush=True); sys.exit(0 if b=='gpu' else 42)"
