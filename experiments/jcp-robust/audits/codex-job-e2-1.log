"""jcp-dims smoke-derived cost certificates (DESIGN 8, A2.6; pattern of P1 / qualify resources.py, rewritten for the
lane's drivers). ESTIMATES, not bounds: the scheduler time limit (>= 1.5 x projection, rounded up to 0.25 h) is the
enforced bound; cluster/stage.py refuses a production attempt whose limit is below 1.5 x the certificate's projection or
whose configs differ from the certified ones.

Work model: dacc per case a + b w (DESIGN A7.1, w = m * M * r); dtime and d3run: linear in w from the heaviest smoke unit,
floored by the smallest measured per-unit cost of the same driver. Measurements (smokes, all H200):
  smk2  (dacc)  rep['elapsed']['<setting>|<arm>'] / n_cases     -> per-case cost incl. tight, tighter and rho work
                rep['elapsed']['<setting>|setup']                -> per-setting table build (max taken)
  smk2t (dtime) rep['blocks'][*]['seconds'] / (subjects x cases x (1 + reps))   -> per subject-case-rep unit
  smk3  (d3run) rep['blocks'][*] ladder / adaptive seconds / (rungs x specs x cases); panel seconds / invocations
The heaviest measured unit of each kind is the reference (t_ref, w_ref); a production unit costs
max(t_floor, t_ref * w / w_ref) — linear scaling from the heaviest point, conservative for heavier-than-smoke cells.

    python resources.py --attempt f2a --run dacc:configs/f2a.json
"""
from __future__ import annotations

import argparse
import hashlib
import json
import math

import numpy as np
from pathlib import Path

HERE = Path(__file__).resolve().parent
NC = {'all38': 38, 'sub16': 16, 'dev6': 6, 'dev2': 2}


def out_dir(att, drv, stem):
    for base in ('archive', 'slim'):                  # slim: the raw archive was offloaded (brief 16); metadata kept
        d = HERE / 'runs' / att / base / 'output' / f'{drv}_{stem}'
        if (d / 'result.json').exists():
            break
    assert (d / 'result.json').exists(), f'missing output {d}'
    return d


SMOL = {2: {8: 1025, 9: 2305, 10: 5121, 11: 11265, 12: 24577, 13: 53249, 14: 114689},
        3: {8: 2559, 9: 6271, 10: 15103, 11: 35839, 12: 83967, 13: 194559}}


def m_of(rule, dim=2):
    import re
    f, n = re.match(r'^([a-z]+)(\d+)', rule).groups()
    n = int(n)
    if f in ('gauss',):
        return n * n
    if f == 'gl':
        return n ** 3
    if f in ('smolyak', 'smol'):             # 2D and 3D Smolyak sizes (DESIGN 2.2, A1.7)
        return SMOL[dim][n]
    return n


def ncases(c):
    return NC[c] if isinstance(c, str) else len(c)


# ------------------------------------------------------------------------------------------------ 2D accuracy
def ref_dacc():
    r = json.loads((out_dir('smk2', 'dacc', 'smk2') / 'result.json').read_text())
    assert r['complete'] and not r.get('memory_rejected'), 'smoke incomplete or memory-rejected (A1.4)'
    assert r['memory']['end']['peak'] <= 120e9, 'smoke peak above 120 GB'
    pts, setups = [], []
    for s in r['config']['settings']:
        for a in s['arms']:
            k = f"{s['name']}|{a['form']}_{a['scheme']}_{float(a['factor']):g}"
            t = r['elapsed'][k] / ncases(a['cases'])
            pts.append((m_of(s['rule']) * s['M'] * s['Rp'], t, a['form']))
        setups.append(r['elapsed'].get(f"{s['name']}|setup", 0.))
    return pts, max(setups)


PROD_SQUARE = {128: 1.5, 256: 10., 384: 17., 512: 20.}      # A8.2: >= observed production maxima per r (1.18, 9.30, 16.07, 17.90 s)
FORM_F = {('GAL', 'CN'): 1.2, ('LSPG', 'CN'): 1.0, ('LSPG', 'CNR'): 1.0, ('LSPG', 'BE'): .6}


def proj_dacc_prod(cfg):
    """A8.2: per-case cost calibrated on the production f2br1 / f2a archives (H200, same driver): non-square cells
    a + b w (least squares on f2br1's 32 non-square R512 arms, a >= 0), square cells the per-r production maximum
    (PROD_SQUARE), times a form factor from the smoke ratios; per-setting setup 5 s."""
    r = json.loads((out_dir('f2br1', 'dacc', 'f2b') / 'result.json').read_text())
    W, T = [], []
    for s in r['config']['settings']:
        if s['M'] == s['Rp']:
            continue
        for a in s['arms']:
            W.append(m_of(s['rule']) * s['M'] * s['Rp'])
            T.append(r['elapsed'][f"{s['name']}|{a['form']}_{a['scheme']}_{float(a['factor']):g}"] / 38)
    b, a0 = np.polyfit(np.array(W, float), np.array(T), 1)
    a0 = max(a0, 0.)
    tot = 0.
    for s in cfg['settings']:
        tot += 5.
        w = m_of(s['rule']) * s['M'] * s['Rp']
        for a in s['arms']:
            per = PROD_SQUARE[s['Rp']] if s['M'] == s['Rp'] else a0 + b * w
            tot += ncases(a['cases']) * per * FORM_F[(a['form'], a['scheme'])]
    tot += 120. * len(cfg.get('blocks', []))           # fixgate / control blocks (smk2: <= 26 s each; 120 s allowance)
    return tot


def proj_dacc(cfg):
    """Per-case cost a + b w (DESIGN A7.1): the intercept a = 75th percentile of the smoke per-case costs of the arms with
    w below a tenth of the heaviest (fixed per-case work: tight / tighter solves, 1024^2 decode, rho, compilation share),
    the slope from the heaviest smoke point of the same form. The pure linear-in-w model under-estimated small cells
    (f2b, 5537386, cancelled after 14 min)."""
    pts, setup = ref_dacc()
    tot = 0.
    for s in cfg['settings']:
        tot += setup
        w = m_of(s['rule']) * s['M'] * s['Rp']
        for a in s['arms']:
            same = [p for p in pts if p[2] == a['form']] or pts
            wr, tr, _ = max(same)
            small = [t for w_, t, _ in same if w_ < wr / 10] or [t for _, t, _ in same]
            a0 = float(np.percentile(small, 75))
            tot += ncases(a['cases']) * (a0 + max(tr - a0, 0.) * w / wr)
    for blk in cfg.get('blocks', []):
        tot += 120. if blk['kind'] == 'fixgate' else 600.
    return tot


# ------------------------------------------------------------------------------------------------ 2D timing
def proj_dtime(cfg):
    r = json.loads((out_dir('smk2', 'dtime', 'smk2t') / 'result.json').read_text())
    assert r['complete'] and not r.get('memory_rejected'), 'smoke incomplete or memory-rejected (A1.4)'
    nc_s, reps_s = ncases(r['config']['cases']), int(r['config']['reps'])
    units = []
    for b in r['blocks']:
        subs = [x for x in r['config']['subjects'] if f"{x['mesh']}|R{x['Rp']}|M{x.get('M')}" in b['subjects'][0]] or r['config']['subjects']
        x = subs[0]
        units.append((m_of(x['rule']) * int(x.get('M', 4 * x['Rp'])) * int(x['Rp']),
                      b['seconds'] / (len(b['subjects']) * nc_s * (1 + reps_s))))
    floor = min(t for _, t in units)
    wr, tr = max(units)
    nc, reps = ncases(cfg['cases']), int(cfg['reps'])
    tot = 300.
    for x in [cfg['A']] + cfg['subjects']:
        w = m_of(x['rule']) * int(x.get('M', 4 * x['Rp'])) * int(x['Rp'])
        tot += nc * (1 + reps) * max(floor, tr * w / wr)
    return tot


# ------------------------------------------------------------------------------------------------ 3D
def ref_d3():
    r = json.loads((out_dir('smk3', 'd3run', 'smk3') / 'result.json').read_text())
    assert r['complete'] and not r.get('memory_rejected'), 'smoke incomplete or memory-rejected (A1.4)'
    cfg = r['config']
    sets = {s['name']: s for s in cfg['settings']}
    assert r['peak_bytes_job'] <= 120e9, 'smoke peak above 120 GB'
    lad, pan = [], []
    for b, rb in zip(cfg['blocks'], r['blocks']):
        if b['kind'] in ('ladder', 'adaptive'):
            s = sets[b['setting']]
            M = int(s.get('M') or 4 * s['Rp'])
            nsp = len(b['specs']) if b['kind'] == 'ladder' else len(b['forms'])
            nc = len(b.get('cases') or range(cfg['cohort_count']))
            w = max(m_of(x, 3) for x in b['rungs']) * M * s['Rp']
            lad.append((w, rb['seconds'] / (len(b['rungs']) * nsp * nc), b['kind']))
        elif b['kind'] == 'panel':
            n = len(r['timing'][b['label']]['invocations'])
            pan.append(rb['seconds'] / max(n, 1))
        elif b['kind'] == 'rounds':
            pan_r = rb['seconds'] / max(1, cfg['cohort_count'])
            lad.append((1., pan_r, 'rounds'))
    return lad, max(pan) if pan else 1., r['peak_bytes_job']


def square_unit():
    """Per (form, rung, case) cost of the square (M = r) adaptive smoke block (W512k1), incl. anchors and diagnostics,
    and the mean point count of its rungs (job audit k3-1: square solves are far slower than the w scaling)."""
    r = json.loads((out_dir('smk3', 'd3run', 'smk3') / 'result.json').read_text())
    for b, rb in zip(r['config']['blocks'], r['blocks']):
        if b['kind'] == 'adaptive' and b['setting'] == 'W512k1':
            units = len(b['forms']) * len(b['rungs']) * len(b['cases'])
            return rb['seconds'] / units, float(np.mean([m_of(x, 3) for x in b['rungs']]))
    raise RuntimeError('no square adaptive smoke block')


def proj_d3(cfg):
    lad, t_inv, _ = ref_d3()
    floor = min(t for _, t, _ in lad)
    sq_unit, sq_m = square_unit()
    sets = {s['name']: s for s in cfg['settings']}
    tot = 600.
    for b in cfg['blocks']:
        s0 = sets.get(b.get('setting'), {})
        if b['kind'] == 'adaptive' and int(s0.get('M') or -1) == int(s0.get('Rp', 0)):     # square kappa = 1 (A8.2-style)
            nc = len(b.get('cases') or range(cfg['cohort_count']))
            for rl in b['rungs']:
                tot += len(b['forms']) * nc * sq_unit * max(1., m_of(rl, 3) / sq_m)
            continue
        if b['kind'] in ('ladder', 'adaptive'):
            s = sets[b['setting']]
            M = int(s.get('M') or 4 * s['Rp'])
            nsp = len(b['specs']) if b['kind'] == 'ladder' else len(b['forms'])
            nc = len(b.get('cases') or range(cfg['cohort_count']))
            same = [p for p in lad if p[2] == b['kind']] or lad
            wr, tr, _ = max(same)
            for rl in b['rungs']:
                tot += nsp * nc * max(floor, tr * m_of(rl, 3) * M * s['Rp'] / wr)
        elif b['kind'] == 'rounds':
            same = [p for p in lad if p[2] == 'ladder']
            wr, tr, _ = max(same)
            for m in b['members']:
                st, rl = m['key'].split('|')[:2]
                s = sets[st]
                w = (m_of(rl, 3) + m_of(m['qp'], 3)) * 4 * s['Rp'] * s['Rp']
                tot += cfg['cohort_count'] * max(floor, tr * w / wr) * 1.2
        elif b['kind'] == 'panel':
            tot += len(b['subjects']) * int(b['cases']) * int(b['reps']) * t_inv * 3
        else:
            tot += 300.
    return tot


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--attempt', required=True)
    ap.add_argument('--run', action='append', required=True)
    a = ap.parse_args()
    det, total = {}, 0.
    for r_ in a.run:
        drv, cf = r_.split(':', 1)
        cfg = json.loads((HERE / cf).read_text())
        sec = {'dacc': proj_dacc_prod if (HERE / 'runs' / 'f2br1').exists() else proj_dacc,
               'dtime': proj_dtime, 'd3run': proj_d3}[drv](cfg)
        det[cf] = sec / 3600.
        total += sec / 3600.
    tl = math.ceil(1.5 * total * 4) / 4
    cert = dict(attempt=a.attempt, runs=a.run, projection_hours=round(total, 4), time_limit_hours=tl, detail=det,
                configs={r_.split(':', 1)[1]: hashlib.sha256((HERE / r_.split(':', 1)[1]).read_bytes()).hexdigest() for r_ in a.run},
                note='estimate (dacc: production-calibrated A8.2 when f2br1 exists, else smoke a + b w (A7.1); d3run: w scaling with square adaptive units priced from smk3 (A10.2); dtime: smoke w scaling); not a bound')
    (HERE / 'checks').mkdir(exist_ok=True)
    (HERE / 'checks' / f'resources-{a.attempt}.json').write_text(json.dumps(cert, indent=1) + '\n')
    print(json.dumps(cert))


if __name__ == '__main__':
    main()
"""jcp-robust execution inventory and resource certificate (DESIGN 7, A3.10, A4.2; common brief 6).

    python certify.py inventory <config.json>                 print the unique-execution inventory of one config
    python certify.py certify <attempt> [--timings checks/smoke-timings.json]
        -> checks/inventory-<attempt>.json  (unique execution keys of every step: bank, mesh, rule, spec / arm, solver
                                             level, case; controls and gates included; reuse marked)
           checks/resources-<attempt>.json  (projection_hours = per GPU group: sum of setup + count x measured seconds of
                                             that execution class, x 1.25; the job's GPU-h = groups run in parallel on
                                             `gpus` GPUs, so the reservation is gpus x max-group hours; bound to the config
                                             sha256s, the inventory sha256 and the GPU count)
Measured seconds come from the smokes (checks/smoke-timings.json: {"<driver>|<class>": seconds per execution,
"<driver>|setup|<mesh or setting>": seconds}); a class with no measurement makes certification fail (never a guess),
except shell (training) steps, whose projection is stated in the job spec with its basis.
"""
import hashlib
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
MARGIN = 1.25


def _cases(spec, n_all=38):
    if spec in (None, 'all38'):
        return n_all
    if spec == 'dev6':
        return 6
    if spec == 'sub16':
        return 16
    return len(spec)


def inv_r2acc(c):
    keys = []
    m = c['mesh']
    bank = (c.get('bank') or {}).get('ckpt_sha256', 'incumbent')
    ids = list(range(_cases(c.get('cases', 'all38'))))
    for g in c['groups']:
        tids = list(range(min(len(ids), _cases(g.get('tighter_cases', 'dev6')))))
        cids = list(range(min(len(ids), _cases(g.get('check_cases', 'dev6')))))
        for arm in g['arms']:
            ak = f"{arm['form']}_{arm['scheme']}_{float(arm['factor']):g}"
            if g.get('target'):
                keys += [(bank, m, g['name'], g['target'], ak, 'prod', 'target', i) for i in ids]
            if g.get('check'):
                keys += [(bank, m, g['name'], g['check'], ak, 'prod', 'check', i) for i in cids]
            for r in g['rules']:
                keys += [(bank, m, g['name'], r['rule'], ak, 'prod', 'rule', i) for i in ids]
                if r.get('level', 'full') == 'full':
                    keys += [(bank, m, g['name'], r['rule'], ak, 'tight', 'rule', i) for i in ids]
                    keys += [(bank, m, g['name'], r['rule'], ak, 'tighter', 'rule', i) for i in tids]
                    if r.get('succ'):
                        keys += [(bank, m, g['name'], r['succ'], ak, 'prod', f"succ-of-{r['rule']}", i) for i in ids]
        if g.get('permute'):
            pr = next(r for r in g['rules'] if r['label'] == g['permute']['label'])
            keys += [(bank, m, g['name'], pr['rule'], 'arm' + str(g['permute']['arm']), 'prod', 'permuted-replay', i) for i in ids]
    return keys


def inv_e13d(c):
    keys = []
    ids = c.get('case_subset') or list(range(c['cohort_count']))
    for cf in c['configs']:
        sp = cf['spec']
        tcs = [j for j in cf.get('tighter_cases', list(range(8))) if j in ids]
        chk = [j for j in cf.get('check_cases', list(range(8))) if j in ids]
        keys += [('W1024', cf['setting'], cf['target'], sp, 'prod', 'target', j) for j in ids]
        keys += [('W1024', cf['setting'], cf['check'], sp, 'prod', 'check', j) for j in chk]
        for s in cf['draws']:
            rl, su = f"lat{cf['n']}s{s}", f"lat{cf['succ_n']}s{s}"
            keys += [('W1024', cf['setting'], rl, sp, 'prod', 'draw', j) for j in ids]
            keys += [('W1024', cf['setting'], rl, sp, 'adt-tight', 'draw', j) for j in ids]
            keys += [('W1024', cf['setting'], rl, sp, 'adt-tighter', 'draw', j) for j in tcs]
            keys += [('W1024', cf['setting'], su, sp, 'prod', f'succ-of-{rl}', j) for j in ids]
        for rl in cf.get('extra', []) + ([cf['bad']] if cf.get('bad') else []):
            keys += [('W1024', cf['setting'], rl, sp, 'prod', 'diag', j) for j in ids]
        if cf.get('permute'):
            keys += [('W1024', cf['setting'], f"lat{cf['n']}s0", sp, 'prod', 'permuted-replay', j) for j in ids]
    return keys


def inv_d3(c):
    keys = []
    ids = c.get('case_subset') or list(range(c['cohort_count']))
    bank = {s['name']: s['bank'] for s in c['settings']}
    for b in c['blocks']:
        if b['kind'] == 'ladder':
            bids = b.get('cases') or ids                     # block-specific case set (code audit 2 #12)
            tcs = [j for j in b.get('tighter_cases', list(range(8))) if j in bids]
            st = b['setting']
            for rl in b['rungs']:
                for sp in b['specs']:
                    keys += [(bank[st], st, rl, sp, 'prod', 'rung', j) for j in bids]
                for sd in sorted({tuple(sp.split('|')[1:3]) for sp in b['specs']}):
                    keys += [(bank[st], st, rl, f'ad|{sd[0]}|{sd[1]}', 'adt-tight', 'rung', j) for j in bids]
                    keys += [(bank[st], st, rl, f'ad|{sd[0]}|{sd[1]}', 'adt-tighter', 'rung', j) for j in tcs]
        elif b['kind'] == 'panel':
            for sp in [b['A']] + b['subjects']:
                for j in range(int(b['cases'])):
                    for r_ in range(int(b['reps'])):
                        keys.append((bank[sp['setting']], sp['setting'], sp['rule'], sp['spec'], 'timed-triplet', b['label'], j, r_))
    return keys


def inv_dtime(c):
    """dtime: per subject and case an untimed scoring run + tight / tighter / successor / check replays, then reps A-B-A
    triplets (+ a fused triplet) per (subject, case, rep), and the doubled-work control."""
    keys = []
    bank = (c.get('bank') or {}).get('ckpt_sha256', 'incumbent')
    n = _cases(c.get('cases', 'dev6'))
    for sp in [c['A']] + c['subjects']:
        lab = f"{sp['Rp']}|{sp['rule']}|{sp['scheme']}|{sp['factor']}"
        for i in range(n):
            keys += [(bank, lab, 'score', i), (bank, lab, 'tight', i), (bank, lab, 'tighter', i), (bank, lab, 'qp', i),
                     (bank, lab, 'qpp', i)]
            keys += [(bank, lab, 'triplet', i, r) for r in range(int(c['reps']))]
            keys += [(bank, lab, 'fused-triplet', i, r) for r in range(int(c['reps']))]
    for sp in c.get('doubled', []):
        keys += [(bank, f"{sp['Rp']}|{sp['rule']}|doubled", 'doubled', i) for i in range(n)]
    return keys


def code_tree_sha(commit, root=None):
    """sha256 over the (path, blob id) list of every staged lane file at `commit` (runs/, audits/, checks/, plots/,
    report* and HEARTBEAT excluded) -- binds a certificate to the code it was computed for (code audit 3 #12)."""
    import subprocess
    root = root or HERE
    out = subprocess.check_output(['git', 'ls-tree', '-r', commit, '--', '.'], cwd=root, text=True)
    skip = ('runs/', 'audits/', 'checks/', 'plots/', 'report', 'HEARTBEAT.json')
    rows = sorted(l.split(None, 3)[3] + ' ' + l.split()[2] for l in out.splitlines() if not l.split(None, 3)[3].startswith(skip))
    return hashlib.sha256('\n'.join(rows).encode()).hexdigest()


def _inv_e5(c):
    import e5common as EC
    return EC.inv_e5time(c)


INV = {'e5time': _inv_e5, 'r2acc': inv_r2acc, 'e1run3d': inv_e13d, 'd3run': inv_d3, 'e2run3d': inv_d3, 'dtime': inv_dtime}


def klass(driver, k):
    """Execution class used for the measured-seconds lookup."""
    if driver == 'r2acc':
        bank, m, g, rule, arm, lev, kind, _ = k
        big = rule.startswith('gauss') and int(rule[5:]) >= 256
        return f"r2acc|{m}|{g}|{lev}|{'big' if big else 'std'}"
    if driver == 'e5time':
        import e5common as EC
        return EC.klass(k)          # one-argument signature (subagent note)
    if driver == 'dtime':
        return f'dtime|{k[2]}'
    if driver == 'e1run3d':
        return f"e1run3d|{k[1]}|{k[4]}|{'gl' if k[2].startswith('gl') else 'lat'}"
    if k[4] == 'timed-triplet':
        return f'd3|{k[1]}|triplet'
    return f"d3|{k[1]}|{k[4]}|{'gl' if k[2].startswith('gl') else 'lat'}"


def certify(att, timings_path):
    spec = json.loads((HERE / 'jobs' / f'{att}.json').read_text())
    T = json.loads((HERE / timings_path).read_text())
    T = T.get('timings', T)
    inv, group_hours, cfgs, missing = {}, [], {}, set()
    for gi, g in enumerate(spec['groups']):
        h = 0.
        for st in g:
            if 'driver' in st:
                c = json.loads((HERE / st['config']).read_text())
                cfgs[st['config']] = hashlib.sha256((HERE / st['config']).read_bytes()).hexdigest()
                keys = INV[st['driver']](c)
                uniq = sorted(set(map(tuple, keys)), key=str)
                inv[st['config']] = dict(n=len(keys), unique=len(uniq), duplicates=len(keys) - len(uniq),
                                         keys=[list(map(str, k)) for k in uniq])
                setup = T.get(f"{st['driver']}|setup|{c.get('mesh', c.get('mode'))}", T.get(f"{st['driver']}|setup"))
                if setup is None:
                    missing.add(f"{st['driver']}|setup|{c.get('mesh', c.get('mode'))}")
                    setup = 0.
                sec = setup
                for k in uniq:
                    kl = klass(st['driver'], k)
                    if kl not in T:
                        missing.add(kl)
                    else:
                        sec += T[kl]
                h += sec * MARGIN / 3600
            else:
                assert 'projection_hours' in st and st.get('projection_basis'), 'a shell step states its projection and basis'
                h += float(st['projection_hours'])
        group_hours.append(h)
    if missing:
        print('UNMEASURED classes (certificate refused):', sorted(missing))
        sys.exit(2)
    (HERE / 'checks').mkdir(exist_ok=True)
    ip = HERE / 'checks' / f'inventory-{att}.json'
    ip.write_text(json.dumps(inv, indent=0) + '\n')
    proj = max(group_hours)
    import math
    import subprocess
    commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=HERE, text=True).strip()
    cert = dict(attempt=att, commit=commit, code_tree_sha256=code_tree_sha(commit), jobspec_sha256=hashlib.sha256((HERE / 'jobs' / f'{att}.json').read_bytes()).hexdigest(),
                time_limit_hours=math.ceil(float(spec['hours']) * 4) / 4, projection_hours=round(proj, 4), group_hours=[round(x, 4) for x in group_hours],
                gpus=int(spec.get('gpus', 1)), projection_gpu_hours=round(proj * int(spec.get('gpus', 1)), 4),
                configs=cfgs, inventory_sha256=hashlib.sha256(ip.read_bytes()).hexdigest(), margin=MARGIN,
                timings=timings_path, timings_sha256=hashlib.sha256((HERE / timings_path).read_bytes()).hexdigest())
    (HERE / 'checks' / f'resources-{att}.json').write_text(json.dumps(cert, indent=1) + '\n')
    print(json.dumps({k: v for k, v in cert.items() if k != 'configs'}))


if __name__ == '__main__':
    if sys.argv[1] == 'inventory':
        c = json.loads(Path(sys.argv[2]).read_text())
        k = INV[c['driver']](c)
        print(len(k), 'executions', len(set(map(tuple, k))), 'unique')
    else:
        tp = sys.argv[sys.argv.index('--timings') + 1] if '--timings' in sys.argv else 'checks/smoke-timings.json'
        certify(sys.argv[2], tp)

