   135	
   136	def richardson_field(u2, u3, p_t, h2, h3):
   137	    """Diagnostic extrapolated field (no uncertainty attached): u3 + (u3 - u2) * h3^p/(h2^p - h3^p), per time."""
   138	    out = np.array(u3, np.float64, copy=True)
   139	    for k in range(1, 6):
   140	        p = p_t[k - 1]
   141	        if p is None:
   142	            out[k] = np.nan
   143	        else:
   144	            out[k] = u3[k] + (u3[k] - u2[k]) * rich_factor(p, h2, h3)
   145	    return out
   146	
   147	
   148	def rel_err(field, ref, n0):
   149	    """Campaign metric: per-time ||f - R|| / n0 (k >= 1) and its max."""
   150	    e = tnorm(np.asarray(field, np.float64) - np.asarray(ref, np.float64))[1:] / n0
   151	    return float(np.max(e)), e.tolist()
   152	
   153	
   154	# ----------------------------------------------------------------------------------------- cross-check (A2.4) --
   155	
   156	PS_Q_MIN = 2.5
   157	
   158	
   159	def crosscheck(fd_record, u3, ps, n0):
   160	    """Ordered cross-check procedure (A2.4/A2.12/A3.6). fd_record: judge() output of R_ST (final).
   161	    ps: dict(spatial=[(N, lat), (N, lat), (N, lat)] coarse->fine at dt, half=lat at N3 and dt/2, full=lat at N3 and dt,
   162	    finite=bool, gates_ok=bool, stability_ok=bool). Returns dict with verdict and numbers."""
   163	    rec = dict(x_ps=None, s_x=None, s_t=None, sigma=None, q=None, eps_ref=fd_record.get('eps_ref'))
   164	    if fd_record.get('outcome') != 'accepted' or rec['eps_ref'] is None or not np.isfinite(rec['eps_ref']):
   165	        return dict(rec, verdict='FD-INVALID')
   166	    eps = rec['eps_ref']
   167	    if not ps['finite']:
   168	        return dict(rec, verdict='UNRESOLVED', reason='non-finite')
   169	    if not ps['gates_ok']:
   170	        return dict(rec, verdict='UNRESOLVED', reason='gates')
   171	    (N1, a), (N2, b), (N3, c) = ps['spatial']
   172	    hs = [1.0 / N1, 1.0 / N2, 1.0 / N3]
   173	    da, db = tnorm(a - b), tnorm(b - c)
   174	    q = [solve_order(da[k], db[k], *hs) for k in range(1, 6)]
   175	    rec['q'] = q
   176	    if any(x is None or x < PS_Q_MIN for x in q):
   177	        return dict(rec, verdict='UNRESOLVED', reason='spatial-order')
   178	    if not ps['stability_ok']:
   179	        return dict(rec, verdict='UNRESOLVED', reason='stability')
   180	    s_x = float(np.max(db[1:]) / n0)
   181	    s_t = float(np.max(tnorm(ps['full'] - ps['half'])[1:]) / n0)
   182	    x_ps = float(np.max(tnorm(ps['half'] - u3)[1:]) / n0)
   183	    rec.update(s_x=s_x, s_t=s_t, sigma=s_x + s_t, x_ps=x_ps, eta=x_ps / eps if eps > 0 else None)
   184	    if not all(np.isfinite(v) for v in (s_x, s_t, x_ps)):
   185	        return dict(rec, verdict='UNRESOLVED', reason='non-finite')
   186	    if s_x + s_t > eps / 2:
   187	        return dict(rec, verdict='UNRESOLVED', reason='resolution')
   188	    return dict(rec, verdict='PASS' if x_ps <= 2 * eps else 'FAIL', reason=None)
   189	
