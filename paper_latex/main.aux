\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Best NM-ROM against FNO, U-Net, Transolver and DeepONet at every measured (PDE, $N$) cell. NM-ROM \emph  {accurate} and \emph  {fast} come from the same trained model. Error is the worst same-grid relative $L^2$ error (\%), over evolved times for Burgers and all times for heat. Speedup is the median GPU time of one full-order setting per cell, the fastest tested one at least as accurate as the NM-ROM accurate setting, divided by the method's time in the same allocation; \emph  {italic} marks speedups below $1\times $. \textbf  {Bold} marks an NM-ROM setting that is both more accurate and faster than every operator in the cell. Each operator family shows its most accurate trained size. Cells: Burgers $256^2$, job 4181372, six development cases, FOM Newton--BiCGStab tol $10^{-3}$, $\Delta t{=}0.005$ (0.049\,\%); Burgers $1024^2$ and $2048^2$, jobs 4204019 and 4218390, the same six cases, FOM tol $3{\times }10^{-3}$, $\Delta t{=}0.005$ (0.048 and 0.049\,\%); heat $1024^2$ and $2048^2$, jobs 4206383 (A100) and 4211204 (H200), the 16 held-out cases of Table~\ref {tab:headline}, FOM CN--CG $\Delta t{=}0.025$, rtol $10^{-4}$ (0.045\,\%); Navier--Stokes $32^3$ and $64^3$, jobs 4234771 and 4237885, the 16 development cases of Table~\ref {tab:headline}, FOM CNAB2 with 50 steps (0.094 and 0.093\,\%); Navier--Stokes $96^3$, job 4244423, 32 held-out cases, FOM CNAB2 with 70 steps (0.056\,\%). In these jobs the Burgers accurate setting (span, $R'=384$, the same quadrature rule as in Table~\ref {tab:headline}, errors equal to four digits) was solved by the general Levenberg--Marquardt code (Jacobian by forward-mode differentiation, dense LU solve, linear predictor) instead of the fused solver of Table~\ref {tab:headline}, whose times that table gives; it was not timed at $256^2$, and the $2048^2$ cell ran on an H200 GPU; the Burgers fast column is the head with $k=16$; the heat fast setting was not timed in its job.}}{10}{table.caption.28}\protected@file@percent }
\newlabel{tab:operators}{{2}{10}{Best NM-ROM against FNO, U-Net, Transolver and DeepONet at every measured (PDE, $N$) cell. NM-ROM \emph {accurate} and \emph {fast} come from the same trained model. Error is the worst same-grid relative $L^2$ error (\%), over evolved times for Burgers and all times for heat. Speedup is the median GPU time of one full-order setting per cell, the fastest tested one at least as accurate as the NM-ROM accurate setting, divided by the method's time in the same allocation; \emph {italic} marks speedups below $1\times $. \textbf {Bold} marks an NM-ROM setting that is both more accurate and faster than every operator in the cell. Each operator family shows its most accurate trained size. Cells: Burgers $256^2$, job 4181372, six development cases, FOM Newton--BiCGStab tol $10^{-3}$, $\Delta t{=}0.005$ (0.049\,\%); Burgers $1024^2$ and $2048^2$, jobs 4204019 and 4218390, the same six cases, FOM tol $3{\times }10^{-3}$, $\Delta t{=}0.005$ (0.048 and 0.049\,\%); heat $1024^2$ and $2048^2$, jobs 4206383 (A100) and 4211204 (H200), the 16 held-out cases of Table~\ref {tab:headline}, FOM CN--CG $\Delta t{=}0.025$, rtol $10^{-4}$ (0.045\,\%); Navier--Stokes $32^3$ and $64^3$, jobs 4234771 and 4237885, the 16 development cases of Table~\ref {tab:headline}, FOM CNAB2 with 50 steps (0.094 and 0.093\,\%); Navier--Stokes $96^3$, job 4244423, 32 held-out cases, FOM CNAB2 with 70 steps (0.056\,\%). In these jobs the Burgers accurate setting (span, $R'=384$, the same quadrature rule as in Table~\ref {tab:headline}, errors equal to four digits) was solved by the general Levenberg--Marquardt code (Jacobian by forward-mode differentiation, dense LU solve, linear predictor) instead of the fused solver of Table~\ref {tab:headline}, whose times that table gives; it was not timed at $256^2$, and the $2048^2$ cell ran on an H200 GPU; the Burgers fast column is the head with $k=16$; the heat fast setting was not timed in its job}{table.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Best NM-ROM against other nonlinear-manifold and projection ROMs on Burgers 2D at matched latent dimension ($k=16$ for every baseline and for our head). Error is the worst evolved same-grid relative $L^2$ error (\%). Speedup as in Table~\ref {tab:operators}: one full-order setting per cell, the fastest at least as accurate as the NM-ROM accurate setting, same allocation; \emph  {italic} below $1\times $; \textbf  {bold} marks an NM-ROM setting more accurate and faster than every baseline. At $256^2$ and $512^2$ the cohort is 32 validation cases (never used for any choice) and every method, ours included, uses a dense residual, so no times are given; at $1024^2$ and $2048^2$ it is the six development cases of jobs 4204019 and 4218390, where our accurate setting is timed with the general solver code, as in Table~\ref {tab:operators}. The shallow masked-autoencoder NM-LSPG of \citet  {KimChoi2022NMROM} passed its reproduction gate on the third of three pre-registered attempts; its hyper-reduction was not reproduced and it was not run from $1024^2$. The quadratic manifold \citep  {GeelenWrightWillcox2022} was run at $1024^2$ and $2048^2$ only. Every latent size and the memory use are in Tables~\ref {tab:nmrom-baselines-appx} and~\ref {tab:ops1024}.}}{10}{table.caption.30}\protected@file@percent }
\newlabel{tab:nmrom-baselines}{{3}{10}{Best NM-ROM against other nonlinear-manifold and projection ROMs on Burgers 2D at matched latent dimension ($k=16$ for every baseline and for our head). Error is the worst evolved same-grid relative $L^2$ error (\%). Speedup as in Table~\ref {tab:operators}: one full-order setting per cell, the fastest at least as accurate as the NM-ROM accurate setting, same allocation; \emph {italic} below $1\times $; \textbf {bold} marks an NM-ROM setting more accurate and faster than every baseline. At $256^2$ and $512^2$ the cohort is 32 validation cases (never used for any choice) and every method, ours included, uses a dense residual, so no times are given; at $1024^2$ and $2048^2$ it is the six development cases of jobs 4204019 and 4218390, where our accurate setting is timed with the general solver code, as in Table~\ref {tab:operators}. The shallow masked-autoencoder NM-LSPG of \citet {KimChoi2022NMROM} passed its reproduction gate on the third of three pre-registered attempts; its hyper-reduction was not reproduced and it was not run from $1024^2$. The quadratic manifold \citep {GeelenWrightWillcox2022} was run at $1024^2$ and $2048^2$ only. Every latent size and the memory use are in Tables~\ref {tab:nmrom-baselines-appx} and~\ref {tab:ops1024}}{table.caption.30}{}}
