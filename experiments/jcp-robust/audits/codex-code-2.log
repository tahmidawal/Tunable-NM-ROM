    23	def h_e1a(qualified, expected=NDRAW):
    24	    """qualified: per draw True / False / None (None = unavailable draw). A2.3: recorded failures are False. The
    25	    registered population (16 draws) is required; any other count is 'unavailable (population)'."""
    26	    if qualified is None or len(qualified) != expected:
    27	        return dict(label='unavailable (population)', failures=None, n=len(qualified or []))
    28	    if any(q is None for q in qualified):
    29	        return dict(label='unavailable', failures=None, n=len(qualified))
    30	    k = sum(1 for q in qualified if not q)
    31	    n = len(qualified)
    32	    lab = 'robust' if k == 0 else ('inconclusive' if k == 1 else 'fragile')
    33	    fresh = qualified[1:]
    34	    kf = sum(1 for q in fresh if not q)
    35	    return dict(label=lab, failures=k, n=n, cp_upper_all=cp_upper_one_sided(k, n), cp_upper_fresh=cp_upper_one_sided(kf, len(fresh)),
    36	                failed_draws=[i for i, q in enumerate(qualified) if not q])
