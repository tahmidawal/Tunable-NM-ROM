   129	def h_acc_r_transition(de, eps, qualified_lo, qualified_hi):
   130	    """de = e(r_hi) - e(r_lo) per eligible case; qualification per case on each rung."""
   131	    de = np.asarray(de, float)
   132	    eps = np.asarray(eps, float)
   133	    n = len(de)
   134	    if n == 0:
   135	        return dict(outcome='inconclusive', reason='empty population', n=0)
   136	    qual = np.asarray(qualified_lo, bool) & np.asarray(qualified_hi, bool)
   137	    unq = int(np.sum(~qual))
   138	    base = dict(n=n, unqualified=unq, improve=int(np.sum(qual & (de < -2 * eps))), worsen=int(np.sum(qual & (de > 2 * eps))),
   139	                tie=int(np.sum(qual & (np.abs(de) <= 2 * eps))), worst_change=float(np.max(de)) if n else None,
   140	                median_change_all=float(np.median(de)))
   141	    if unq > .25 * n:
   142	        return dict(base, outcome='inconclusive', reason='> 25 % lack qualification')
   143	    res_mask = qual & (np.abs(de) > 2 * eps)
   144	    nr = int(np.sum(res_mask))
   145	    base['resolved'] = nr
   146	    if nr < .5 * n:
   147	        return dict(base, outcome='inconclusive', reason='resolved < 50 %')
   148	    frac = float(np.mean(de[res_mask] < 0))
   149	    med = float(np.median(de[res_mask]))
   150	    base.update(improve_fraction=frac, median_change_resolved=med)
   151	    if frac > .5 and med < 0:
   152	        return dict(base, outcome='improves')
   153	    return dict(base, outcome='does not improve')
