   110	def main():
   111	    ap = argparse.ArgumentParser()
   112	    ap.add_argument('--f1', required=True)
   113	    ap.add_argument('--roms', required=True, help='checks/rom-scores.json: {label: {key, e, eta, ranked_ids, eligible}}')
   114	    ap.add_argument('--out', required=True)
   115	    a = ap.parse_args()
   116	    f1 = json.loads((Path(a.f1) / 'result.json').read_text())
   117	    cases = f1['cohort']['cases']
   118	    assert f1['cohort']['seed'] == 923801 and len(cases) == 64 and f1.get('complete') is True
   119	    roms = json.loads(Path(a.roms).read_text())
   120	    C = candidates(f1, cases)
   121	    out = dict(f1_job=f1.get('job_id'), gpu=f1.get('gpu'), label='every speed-up against a matched FOM is an upper bound '
   122	               '(finite FOM ladder); boundary = matched at the family\'s cheapest admissible configuration', matches={},
   123	               admissibility={f: {c['key']: c['why'] for c in v} for f, v in C.items()})
   124	    for lab, r in roms.items():
   125	        if not r.get('selectable'):                      # eligible AND evidence AND every claim gate (audit select-2)
   126	            out['matches'][lab] = {f: dict(status=f"ROM not admissible for claims (eligibility {r.get('eligibility')}, "
   127	                                                  f"selectable {r.get('selectable')})", matched=None) for f in FAMILIES}
   128	            continue
   129	        out['matches'][lab] = {f: match_one(r, C[f], cases) for f in FAMILIES}
   130	    out['K10_all_rejected'] = all('K10 FAILED' not in m['status'] for v in out['matches'].values() for m in v.values())
   131	    Path(a.out).write_text(json.dumps(out, indent=1, default=float) + '\n')
   132	    print(json.dumps({k: {f: (m['status'][:20], m.get('matched')) for f, m in v.items()} for k, v in out['matches'].items()}, indent=1))
