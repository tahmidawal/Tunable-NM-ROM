    44	
    45	def along(fn, x, axis, M):
    46	    return jnp.moveaxis(fn(jnp.moveaxis(x, axis, -1), M), -1, axis)
    47	
    48	
    49	def analysis(f, M):
    50	    """Trapezoid sine projection on every axis: b_k = (2/M)^d sum_j f_j prod_a sin(pi k_a j_a / M)."""
    51	    for ax in range(f.ndim):
    52	        f = along(sine_synth_last, f, ax, M) * (2.0 / M)
    53	    return f
