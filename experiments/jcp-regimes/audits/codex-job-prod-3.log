+    save = lambda: C.dump(out / 'result.json', C.clean(rep))
+    save()
+
+    # ================================================================ 1. tables
+    R = int(model['T'].shape[1])
+    Rps = sorted(cfg['Rps'], reverse=True)
+    ladder = sorted(set(Rps) | {R})
