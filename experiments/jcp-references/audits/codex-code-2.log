   271	                    jd = m['judge']
   272	                    cases.append(dict(cohort=cohort, kind=kind, case=case, outcome=m['outcome'], eps_ref=jd['eps_ref'],
   273	                                      p=jd['p'], c=jd['c'], d23=jd['d23'], tau=jd['tau'], peclet=jd['peclet'],
   274	                                      refined=m['refined'], tight=m['tight_used'], levels=jd['levels'],
   275	                                      nu=m['desc']['nu'], seconds=m.get('seconds'), gpu=m['job']['gpu'],
   276	                                      job_id=m['job']['job_id'], commit=m['job']['commit'],
   277	                                      newton_total=sum(a['newton_total'] for a in m['attempts'])))
   278	        sq = {k: v for (d_, k), v in sealed_qc.items() if d_ == dim}
   279	        e0, bad = e0_verdict(dim, dstat, cases, xc, sq)
   280	        ovn = old_vs_new(dim)
   281	        x3 = {}
   282	        for kind in ('ST', 'S'):
