   250	                    prev = sealed_qc[key]
   251	                    prev['case_kinds'] += q['case_kinds']
   252	                    prev['outcomes'] = {o: prev['outcomes'].get(o, 0) + q['outcomes'].get(o, 0) for o in V.OUTCOMES}
   253	            summary.setdefault('sealed_qc', {})[f"{r['config']['dim']}d/{r['config']['cohort']}/{name}"] = dict(
   254	                qc=r['qc'], manifest_cipher_sha256=r['sealed_manifest']['cipher_sha256'],
   255	                manifest_plain_sha256=r['sealed_manifest']['plain_sha256'], n_ciphertexts=len(r['sealed_manifest']['ciphertexts']))
   256	    status = dict(store_version=version, dimension_status={}, crosscheck={}, crosscheck_cases={})
   257	    for dim in (2, 3):
