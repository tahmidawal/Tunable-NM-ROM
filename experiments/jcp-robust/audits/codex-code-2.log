    16	def cp_upper_one_sided(k, n, conf=.95):
    17	    """One-sided Clopper-Pearson upper bound on a failure probability after k failures in n trials (A1.5)."""
    18	    if n <= 0:
    19	        return float('nan')
    20	    return 1.0 if k >= n else float(beta.ppf(conf, k + 1, n - k))
