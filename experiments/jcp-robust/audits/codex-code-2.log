   164	                                     tight_max=(max(q['tight']) if q['tight'] else None),
   165	                                     succ_max=(max(q['succ']) if q['succ'] else None),
   166	                                     e=q['e'], eps=q['eps'], eligible=q['eligible'], valid=q['valid'],
   167	                                     case_q=([bool(q['valid'][i] and q['valid_tight'][i] and q['valid_succ'][i]
   168	                                                   and q['tight'][i] <= E.BAR_Q1 and q['succ'][i] <= E.BAR_Q2
   169	                                                   and q['rho_succ'][i] <= E.BAR_RHO) for i in range(len(ids))]
   170	                                             if (full and str(z['succ'])) else None),
   171	                                     dist_target=q['target'] if has_t else None)
   172	    out_arm['integrity'] = dict(integ, ok=bool(integ['ids_ok'] and not integ['mismatches'] and integ['gcert_fail'] == 0
   173	                                              and not integ['missing']))
   174	    return out_arm
