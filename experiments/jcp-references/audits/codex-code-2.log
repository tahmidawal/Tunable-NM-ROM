   205	def e0_verdict(dim, dstat, cases, xc, sealed_qc):
   206	    """A3.5: FAIL iff suspended/unvalidated; PASS iff every required case-kind (every cohort incl. sealed/OOD x both
   207	    kinds) is eligible; else PASS-WITH-K0-CASES. INCOMPLETE while any required cohort-kind has not been generated."""
   208	    if dstat != 'validated':
   209	        return 'FAIL', []
   210	    bad, missing = [], []
   211	    for c in cases:
   212	        x = xc.get(f"{c['cohort']}/{c['case']}")
   213	        if c['outcome'] == 'MISSING':
   214	            missing.append(f"{c['cohort']}/{c['case']}/{c['kind']}")
   215	        elif c['outcome'] != 'accepted' or (x is not None and x['verdict'] != 'PASS'):
   216	            bad.append(f"{c['cohort']}/{c['case']}/{c['kind']}")
   217	    for coh in CH.NEW[dim]:
   218	        for kind in ('ST', 'S'):
   219	            q = sealed_qc.get((coh, kind))
   220	            n = CH.count(dim, coh)
   221	            if q is None or q['case_kinds'] < n:
   222	                missing.append(f'{coh}/*/{kind}')
   223	            elif q['outcomes'].get('accepted', 0) < n:
   224	                bad.append(f"{coh}/{n - q['outcomes'].get('accepted', 0)} case(s)/{kind} (sealed: counts only)")
   225	    if missing:
   226	        return 'INCOMPLETE', bad + [f'missing: {m}' for m in missing]
   227	    return ('PASS' if not bad else 'PASS-WITH-K0-CASES'), bad
