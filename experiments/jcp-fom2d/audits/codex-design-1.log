   144	def score(field, dim, cohort, case, kind='ST'):
   145	    """One arm's error against the reference (no ranking claim). `field` in the conventions above."""
   146	    ref, meta = load(dim, cohort, case, kind)
   147	    f = np.asarray(field, np.float64)
   148	    if f.shape != ref.shape:
   149	        raise ValueError(f'field shape {f.shape} != reference shape {ref.shape}')
   150	    n0 = meta['judge']['n0']
   151	    e, e_t = V.rel_err(f, ref, n0)
   152	    st = reference_status(dim, cohort, case, kind)
   153	    return dict(dim=dim, cohort=cohort, case=case, kind=kind, metric_id=V.METRIC_ID[dim],
   154	                store_version=store_version(), e=e, e_t=e_t, eps_ref=st['eps_ref'], eligible=st['eligible'],
   155	                outcome=st['outcome'])
