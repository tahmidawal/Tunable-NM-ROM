    98	def main():
    99	    ap = argparse.ArgumentParser()
   100	    ap.add_argument('--run', required=True)
   101	    ap.add_argument('--out')
   102	    a = ap.parse_args()
   103	    import c3common as C3
   104	    rp = Path(a.run)
   105	    res = json.loads((rp / 'result.json').read_text())
   106	    cfg = res['config']
   107	    seed = int(cfg['cohort_seed'])
   108	    tab = C3.C.table(seed, int(cfg['cohort_count']))
   109	    refs = Refs(seed, tab)
   110	    Wz = np.load(rp / f"W_{res['mode']}.npz")
   111	    out = dict(run=str(rp), job_id=res.get('job_id'), seed=seed, cohort=refs.coh, store_version=STORE_VERSION, status_sha=STATUS_SHA,
   112	               label=('E0 second-order reference R_ST (conditional Richardson estimate, not a rigorous bound; its '
   113	                      'cross-check rule was amended after data, E0 A10); first-order scores PROVISIONAL'),
   114	               scores={}, controls={}, gates={})
   115	    keys = [k for k in Wz.files if not k.startswith(('cases|', 'wall|', 'fomfield|'))]
   116	    for key in keys:
   117	        setting = base_setting(key)                    # jcp-dims EDIT
   118	        G = glat(setting)
   119	        ids = [int(x) for x in Wz[f'cases|{key}']]
   120	        A = Wz[key]
   121	        rec = {}
   122	        for ci, j in enumerate(ids):
   123	            R = refs.get(j)
   124	            F = A[ci] @ G
   125	            e_t, e = err(F, R)
   126	            r = dict(e_t=e_t, e=e, eps_ref=refs.st[j]['eps_ref'], eligible=refs.st[j]['eligible'])
   127	            if refs.r1 is not None:
   128	                e1t, e1 = err(F, np.asarray(refs.r1[f'c{j}']))
   129	                r['first_order'] = dict(e_t=e1t, e=e1)
   130	            rec[j] = r
   131	        out['scores'][key] = rec
   132	        print(key, 'median e', np.median([v['e'] for v in rec.values()]), flush=True)
   133	    # K4 controls on the first key with >= 2 cases
   134	    k0 = next(k for k in keys if len(Wz[f'cases|{k}']) >= 2)
   135	    s0 = base_setting(k0)                              # jcp-dims EDIT
   136	    ids = [int(x) for x in Wz[f'cases|{k0}']]
   137	    G = glat(s0)
   138	    ca, cb = (0, 1) if {0, 1} <= set(ids) else (ids[0], ids[1])     # A1.10: case 0's field vs case 1's reference
   139	    F0 = Wz[k0][ids.index(ca)] @ G
   140	    e00 = err(F0, refs.get(ca))[1]
   141	    out['controls']['K4_cases'] = [ca, cb]
   142	    out['controls']['K4_case_swap'] = abs(err(F0, refs.get(cb))[1] - e00)
   143	    out['controls']['K4_time_shift'] = abs(err(np.roll(F0, 1, 0), refs.get(ids[0]))[1] - e00)
   144	    out['controls']['K4_fires'] = bool(out['controls']['K4_case_swap'] > 1e-6 and out['controls']['K4_time_shift'] > 1e-6)
   145	    # gate: in-job ADT distances reproduced for one spec per grid rule
   146	    if res['mode'] == 'grid':
   147	        worst = 0.
   148	        n0 = {j: float(np.linalg.norm(np.asarray(C3.C.initial_interior(65, tab, j)))) for j in res['cohort']['cases']}
   149	        for sn, sv in res['settings'].items():
   150	            for rule, rr in sv['rules'].items():
   151	                key = next(iter(rr['dist_to_adt']))
   152	                parts = key.split('|')
   153	                ak = f"ad|LSPG|{parts[1]}|{parts[2]}|tight"
   154	                Wa, Wb = Wz[f'{sn}|{rule}|{key}'], Wz[f'{sn}|{rule}|{ak}']
   155	                ids = [int(x) for x in Wz[f'cases|{sn}|{rule}|{key}']]
   156	                G = glat(sn)
   157	                d = np.array([np.linalg.norm((Wa[i] - Wb[i]) @ G, axis=1) / n0[j] for i, j in enumerate(ids)])
   158	                worst = max(worst, float(np.abs(d - np.asarray(rr['dist_to_adt'][key])).max()))
   159	        out['gates']['dist_recomputed_worst_abs'] = worst
   160	        out['gates']['dist_ok'] = worst <= 1e-10
   161	    dest = Path(a.out or HERE / 'checks' / f"scores-{cfg['attempt']}.json")
   162	    dest.write_text(json.dumps(out, default=float) + '\n')
   163	    print(dest, out['controls'], out['gates'])
