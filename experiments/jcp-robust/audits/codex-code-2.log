   107	
   108	def klass(driver, k):
   109	    """Execution class used for the measured-seconds lookup."""
   110	    if driver == 'r2acc':
   111	        bank, m, g, rule, arm, lev, kind, _ = k
   112	        big = rule.startswith('gauss') and int(rule[5:]) >= 256
   113	        return f"r2acc|{m}|{g}|{lev}|{'big' if big else 'std'}"
   114	    if driver == 'e1run3d':
   115	        return f"e1run3d|{k[1]}|{k[4]}|{'gl' if k[2].startswith('gl') else 'lat'}"
   116	    if k[4] == 'timed-triplet':
   117	        return f'd3|{k[1]}|triplet'
   118	    return f"d3|{k[1]}|{k[4]}|{'gl' if k[2].startswith('gl') else 'lat'}"
   119	
   120	
   121	def certify(att, timings_path):
   122	    spec = json.loads((HERE / 'jobs' / f'{att}.json').read_text())
   123	    T = json.loads((HERE / timings_path).read_text())
   124	    inv, group_hours, cfgs, missing = {}, [], {}, set()
   125	    for gi, g in enumerate(spec['groups']):
   126	        h = 0.
   127	        for st in g:
   128	            if 'driver' in st:
   129	                c = json.loads((HERE / st['config']).read_text())
   130	                cfgs[st['config']] = hashlib.sha256((HERE / st['config']).read_bytes()).hexdigest()
   131	                keys = INV[st['driver']](c)
   132	                uniq = sorted(set(map(tuple, keys)), key=str)
   133	                inv[st['config']] = dict(n=len(keys), unique=len(uniq), duplicates=len(keys) - len(uniq),
   134	                                         keys=[list(map(str, k)) for k in uniq])
   135	                setup = T.get(f"{st['driver']}|setup|{c.get('mesh', c.get('mode'))}")
   136	                if setup is None:
   137	                    missing.add(f"{st['driver']}|setup|{c.get('mesh', c.get('mode'))}")
   138	                    setup = 0.
   139	                sec = setup
   140	                for k in uniq:
   141	                    kl = klass(st['driver'], k)
   142	                    if kl not in T:
   143	                        missing.add(kl)
   144	                    else:
   145	                        sec += T[kl]
   146	                h += sec * MARGIN / 3600
   147	            else:
   148	                assert 'projection_hours' in st and st.get('projection_basis'), 'a shell step states its projection and basis'
   149	                h += float(st['projection_hours'])
   150	        group_hours.append(h)
   151	    if missing:
   152	        print('UNMEASURED classes (certificate refused):', sorted(missing))
   153	        sys.exit(2)
   154	    (HERE / 'checks').mkdir(exist_ok=True)
   155	    ip = HERE / 'checks' / f'inventory-{att}.json'
   156	    ip.write_text(json.dumps(inv, indent=0) + '\n')
   157	    proj = max(group_hours)
   158	    cert = dict(attempt=att, projection_hours=round(proj, 4), group_hours=[round(x, 4) for x in group_hours],
   159	                gpus=int(spec.get('gpus', 1)), projection_gpu_hours=round(proj * int(spec.get('gpus', 1)), 4),
   160	                configs=cfgs, inventory_sha256=hashlib.sha256(ip.read_bytes()).hexdigest(), margin=MARGIN,
   161	                timings=timings_path, timings_sha256=hashlib.sha256((HERE / timings_path).read_bytes()).hexdigest())
   162	    (HERE / 'checks' / f'resources-{att}.json').write_text(json.dumps(cert, indent=1) + '\n')
   163	    print(json.dumps({k: v for k, v in cert.items() if k != 'configs'}))
   164	
   165	
   166	if __name__ == '__main__':
   167	    if sys.argv[1] == 'inventory':
   168	        c = json.loads(Path(sys.argv[2]).read_text())
   169	        k = INV[c['driver']](c)
   170	        print(len(k), 'executions', len(set(map(tuple, k))), 'unique')
   171	    else:
   172	        tp = sys.argv[sys.argv.index('--timings') + 1] if '--timings' in sys.argv else 'checks/smoke-timings.json'
   173	        certify(sys.argv[2], tp)
