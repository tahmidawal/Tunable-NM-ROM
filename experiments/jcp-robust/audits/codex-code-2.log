    71	def canon_dt(x):
    72	    """Every step of the lane is 0.05/k (k integer): the display value of a key is mapped back exactly (audit code-1 #4)."""
    73	    k = round(0.05 / float(x))
    74	    assert k >= 1 and abs(0.05 / k - float(x)) <= 1e-7 * float(x), x
    75	    return 0.05 / k
