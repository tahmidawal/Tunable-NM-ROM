    41	       3: {'sealed64': (64, 'family'), 'ood16': (16, 'ood')}}
    42	SEALED = {(d, n) for d in NEW for n in NEW[d]}
    43	PUBLIC_CHECK_SEEDS = {2: 5550001, 3: 5550002}          # public seeds for the RNG unit test only (A2.11)
    44	HISTORICAL_SEEDS = {s for d in HISTORICAL for v in HISTORICAL[d].values() for s, _ in v}
    45	
    46	LOGNU_FAMILY = (np.log(.01), np.log(.1))
    47	LOGNU_OOD = (np.log(.01), np.log(.01) + 0.1 * np.log(10.))
