   168	def V_clean(x):
   169	    if isinstance(x, dict):
   170	        return {str(k): V_clean(v) for k, v in x.items()}
   171	    if isinstance(x, (list, tuple)):
   172	        return [V_clean(v) for v in x]
   173	    if isinstance(x, (np.floating, float)):
   174	        return float(x) if np.isfinite(x) else None
   175	    if isinstance(x, (np.integer,)):
   176	        return int(x)
   177	    if isinstance(x, (np.bool_,)):
   178	        return bool(x)
   179	    if isinstance(x, np.ndarray):
   180	        return V_clean(x.tolist())
   181	    return x
