   231	def calib_status_ok(d):
   232	    """Production refusal (A5.4): the committed calibration status must have passed with this FLOOR_STAB."""
   233	    p = HERE / 'checks' / f'calib_{d}d.json'
   234	    if not p.exists():
   235	        return False, 'missing checks/calib_%dd.json' % d
   236	    st = json.loads(p.read_text())
   237	    if st.get('floor_stab') != V.FLOOR_STAB:
   238	        return False, f"calibrated FLOOR_STAB {st.get('floor_stab')} != {V.FLOOR_STAB}"
   239	    if not st.get('proxy_ok_all'):
   240	        return False, 'calibration proxy failed'
   241	    return True, 'ok'
