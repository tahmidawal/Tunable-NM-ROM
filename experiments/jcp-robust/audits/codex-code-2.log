"""jcp-robust E2 3D rule selection per (bank, width, spec, family) (DESIGN 3.3; A1.8, A2.5, A2.6, A3.3). CPU (offline first).

From the two selection jobs of one bank (e2q<b>a: W256, W512; e2q<b>b: W768, W1024; d3run 'ladder' blocks) and their E0
scores: a candidate rung is qualified iff, on every one of the 64 cases, its production run is valid, the pooled
non-stationary fraction (fresh in-job certificate, recomputed from the saved gam_cert rows) is <= 1 %, the ADT tight
anchor is valid and within 2.5e-4 (recomputed), tight/tighter <= 2.5e-5 on cases 0-7, its successor rung is valid and
within 2.5e-4 (recomputed), rho against the successor <= 0.116, and (cross-family) it is within 2.5e-4 of gl64 on every
case. The target check is gl56 vs gl64 <= 2.5e-5 on cases 0-7 with both valid; if it fails, the pick is a diagnostic pick
on the own-family criteria (A2.5). Search order = the candidate lists; three-state: an undetermined candidate stops the
search ("unavailable"); "none within ladder" only when every candidate is definitively rejected.

    python select3d.py <bank> <e2q<b>a dir> <e2q<b>b dir>
"""
import offline  # noqa: F401

import json
import math
import sys
from pathlib import Path

import numpy as np

import e1stats as E
import e2score3 as ES
from make_configs_e2_3d import GAUSS, GAUSS_CAND, LAT, LAT_CAND, SPECS

HERE = Path(__file__).resolve().parent


def num(x):
    return E.num(x)


def main():
    b = int(sys.argv[1])
    dirs = [Path(x) for x in sys.argv[2:4]]
    import c3common as C3
    import score3 as SC
    rep = dict(bank=b, slots=[], cells={}, target={}, jobs={})
    for d in dirs:
        res = json.loads((d / 'result.json').read_text())
        cfg = res['config']
        ES.install(cfg)
        rep['jobs'][res['config']['attempt']] = dict(job_id=res['job_id'], complete=bool(res.get('complete')),
                                                     backend=res['backend'], memory_rejected=res.get('memory_rejected', []))
        Wz = np.load(d / f"W_{res['mode']}.npz")
        tab = C3.C.table(int(cfg['cohort_seed']), int(cfg['cohort_count']))
        cases = [int(x) for x in res['cohort']['cases']]
        n0 = {j: float(np.linalg.norm(np.asarray(C3.C.initial_interior(65, tab, j)))) for j in cases}
        lad = {}
        for blk in res['blocks']:
            if blk['kind'] == 'ladder':
                lad.update(blk['result'])

        def dist(sname, A_, B_, ids=None):
            G = SC.glat(sname)
            ids = cases if ids is None else ids
            return [max(float(np.linalg.norm((A_[i][k] - B_[i][k]) @ G)) / n0[j] for k in range(1, 6)) for i, j in enumerate(ids)]

        for st in cfg['settings']:
            sname, wd = st['name'], int(st['Rp'])
            for spec in SPECS:
                g = {rl: lad.get(f'{sname}|{rl}|{spec}') for rl in GAUSS + LAT}
                W = {rl: Wz[f'{sname}|{rl}|{spec}'] for rl in GAUSS + LAT if f'{sname}|{rl}|{spec}' in Wz.files}
                tgt_ok = None
                if g.get('gl56') and g.get('gl64') and 'gl56' in W and 'gl64' in W:
                    dchk = dist(sname, W['gl56'][:8], W['gl64'][:8], cases[:8])
                    tgt_ok = bool(all(g['gl56']['valid'][:8]) and all(g['gl64']['valid']) and max(dchk) <= E.BAR_TC)
                    rep['target'][f'{sname}|{spec}'] = dict(dist_check=dchk, certified=tgt_ok, all_target_valid=all(g['gl64']['valid']))
                for fam, cand, ladder in (('gauss', GAUSS_CAND, GAUSS), ('lattice', LAT_CAND, LAT)):
                    cells = {}
                    for rl in cand:
                        x = g.get(rl)
                        nxt = ladder[ladder.index(rl) + 1]
                        if x is None or rl not in W or nxt not in W or g.get(nxt) is None:
                            cells[rl] = dict(qualified=None, own=None, status='missing')
                            continue
                        rows = [r_ for r_ in res['rows'] if r_.get('tag') == f'{sname}|{rl}' and r_.get('spec') == spec and 'gam_cert' in r_]
                        gam = [num(v) for r_ in rows for v in r_['gam_cert']]
                        nonst = (sum(1 for v in gam if not (np.isfinite(v) and v <= E.GAMMA)) / len(gam)) if (gam and len(rows) == len(cases)) else None
                        sp = spec.split('|')
                        ka = f"{sname}|{rl}|ad|LSPG|{sp[1]}|{float(sp[2]):.8g}|tight"
                        d_adt = dist(sname, W[rl], Wz[ka]) if ka in Wz.files else None
                        d_next = dist(sname, W[rl], W[nxt])
                        d_tgt = dist(sname, W[rl], W['gl64']) if 'gl64' in W else None
                        tt = x['adt_tight_tighter']
                        qual, own, status = E.draw_qualified(
                            dict(valid=x['valid'], valid_tight=x['adt_valid'], valid_tighter=x['adt_tighter_valid'],
                                 valid_succ=g[nxt]['valid']),
                            dict(tight=d_adt, tt=tt, succ=d_next, rho_succ=[max(num(v) for v in rr) for rr in x['rho']],
                                 # 3D selection's cross-family criterion is the rollout distance to gl64 only (A1.8,
                                 # the dims (3M) predicate); no rho against the target is registered, so it is not tested
                                 target=d_tgt, rho_tgt=[0.] * len(cases), nonst_frac=nonst),
                            (None if tgt_ok is None or tgt_ok is False else bool(all(g['gl64']['valid']))),
                            len(cases), len(x['adt_tight_tighter']))
                        cells[rl] = dict(qualified=qual, own=own, status=status, m=x.get('m'),
                                         dist_next_max=max(d_next), dist_tgt_max=max(d_tgt) if d_tgt else None)
                    key = 'qualified' if tgt_ok else 'own'
                    pick, outcome = None, 'none within ladder'
                    for rl in cand:
                        v = cells[rl][key]
                        if v is True:
                            pick, outcome = rl, ('selected' if tgt_ok else 'diagnostic pick (target unverified)')
                            break
                        if v is None:
                            outcome = f'unavailable (evidence for {rl} undetermined)'
                            break
                    rep['cells'][f'{sname}|{spec}|{fam}'] = cells
                    rep['slots'].append(dict(width=wd, spec=spec, family=fam, rule=pick, outcome=outcome))
                    print(sname, spec, fam, pick, outcome, flush=True)
    (HERE / 'checks' / f'select3d-{b}.json').write_text(json.dumps(rep, indent=1, default=float) + '\n')


if __name__ == '__main__':
    main()
"""jcp-robust E2 cross-bank verdicts (DESIGN 3.4 as amended by A1.10, A2.7, A3.5, A3.6, A4.2). CPU only, no JAX.

Reads checks/e2-<dim>-<bank>.json for bank 0 (incumbent) and the recipe seeds. For every registered verdict:
  seed-robust      all three new seeds give the same definitive label
  seed-dependent   two new seeds give different definitive labels
  inconclusive     otherwise
and, when seed-robust, historical agreement with the incumbent (agrees / differs (recipe/software version, not attributed
to the seed) / incumbent not definitive). Precedence: G-E2.3 failure on the incumbent blocks every verdict of that
dimension; a bank job that is incomplete / not on GPU / fails integrity makes that bank's labels 'missing'.
Seed spread: per (r, scheme, mesh) case-median and case-worst error, min-max over seeds, incumbent value, and a t interval
(df = n-1) for the mean of log10 over the new seeds, labelled. Spread ratio per H-acc-r transition (A2.7).

    python e2verdicts.py 2d [--seeds 1,2,3]
"""
import json
import math
import sys
from pathlib import Path

import numpy as np
from scipy.stats import t as tdist

HERE = Path(__file__).resolve().parent
DEFINITIVE = {'pass', 'fail', 'improves', 'does not improve', 'monotone', 'not monotone', 'member', 'dominated', 'unqualified',
              'absent', True, False}


def lab3(labels):
    """labels of the new seeds (None = missing)."""
    d = [x for x in labels if x in DEFINITIVE or (isinstance(x, str) and x.startswith('rule:'))]
    if len(d) >= 2 and len(set(map(str, d))) > 1:
        return 'seed-dependent'
    if len(d) == len(labels) and len(set(map(str, d))) == 1:
        return 'seed-robust'
    return 'inconclusive'


def hist(inc, new, robust):
    if robust != 'seed-robust':
        return None
    if not (inc in DEFINITIVE or (isinstance(inc, str) and inc.startswith('rule:'))):
        return 'incumbent not definitive'
    return 'agrees with incumbent' if str(inc) == str(new[0]) else 'differs from incumbent (recipe/software version, not attributed to the seed)'


def keys_2d(r):
    out = {}
    if r is None:
        return out
    for k, v in r['selection'].items():
        out[f'selected-rule|R{k}'] = ('rule:' + v['rule']) if v['rule'] else ('absent' if v['outcome'] == 'none within ladder' else None)
    for k, v in r['h_acc_n'].items():
        out[f'H-acc-N|{k}'] = v.get('outcome')
    for k, v in r['h_acc_r'].items():
        for tr, x in v.items():
            out[f'H-acc-r|{k}|{tr}'] = x.get('outcome') if isinstance(x, dict) else x
    for k, v in r['configurations'].items():
        out[f'Q1Q2|{k}'] = v['qualified']
    for k, v in (r.get('front_1024') or {}).items():
        if isinstance(v, dict):
            out[f'front1024|{k}'] = v.get('state')
    return out


def keys_3d(r):
    out = {}
    if r is None:
        return out
    for sl in r['selection']:
        k = f"selected-rule|W{sl['width']}|{sl['spec']}|{sl['family']}"
        out[k] = ('rule:' + sl['rule']) if sl['rule'] else ('absent' if sl['outcome'] == 'none within ladder' else None)
    for k, v in r['h_acc_r'].items():
        for tr, x in v.items():
            out[f'H-acc-r|{k}|{tr}'] = x.get('outcome') if isinstance(x, dict) else x
    for k, v in r['configurations'].items():
        out[f'Q1Q2|{k}'] = v['qualified']
    for k, v in ((r.get('front_65') or {}).get('points') or {}).items():
        out[f'front65|{k}'] = v.get('state')
    return out


def tint(xs):
    xs = [math.log10(x) for x in xs if x is not None and np.isfinite(x) and x > 0]
    if len(xs) < 2:
        return None
    m, s = float(np.mean(xs)), float(np.std(xs, ddof=1))
    h = tdist.ppf(.975, len(xs) - 1) * s / math.sqrt(len(xs))
    return dict(mean_log10=m, lo=10 ** (m - h), hi=10 ** (m + h), n=len(xs), label=f'n = {len(xs)}, wide by construction')


def main():
    dim = sys.argv[1]
    seeds = [int(x) for x in (sys.argv[sys.argv.index('--seeds') + 1] if '--seeds' in sys.argv else '1,2,3').split(',')]
    load = lambda b: json.loads((HERE / 'checks' / f'e2-{dim}-{b}.json').read_text()) if (HERE / 'checks' / f'e2-{dim}-{b}.json').exists() else None
    inc = load(0)
    new = {s: load(s) for s in seeds}
    blocked = inc is None or not (inc.get('G-E2.3') or {}).get('passed')
    ok = lambda r: r is not None and r.get('integrity') and all(j.get('complete') and j.get('backend') == 'gpu' for j in r['jobs'].values())
    kf = keys_2d if dim == '2d' else keys_3d
    K = {b: (kf(r) if ok(r) else {}) for b, r in [(0, inc)] + list(new.items())}
    allk = sorted(set().union(*[set(v) for v in K.values()]))
    rows = []
    for k in allk:
        lbls = [K[s].get(k) for s in seeds]
        robust = lab3(lbls)
        rows.append(dict(key=k, incumbent=K[0].get(k), seeds=dict(zip(map(str, seeds), lbls)),
                         label=('blocked (G-E2.3)' if blocked else robust),
                         historical=None if blocked else hist(K[0].get(k), lbls, robust)))
    spread = {}
    for b, r in [(0, inc)] + list(new.items()):
        if not ok(r):
            continue
        for k, v in r['configurations'].items():
            spread.setdefault(k, {})[b] = (v['median_e'], v['worst_e'])
    sp = {}
    for k, v in spread.items():
        s_ = [v[s] for s in seeds if s in v]
        sp[k] = dict(incumbent=v.get(0), seeds={str(s): v.get(s) for s in seeds},
                     median_minmax=[min(x[0] for x in s_), max(x[0] for x in s_)] if s_ else None,
                     worst_minmax=[min(x[1] for x in s_), max(x[1] for x in s_)] if s_ else None,
                     median_t=tint([x[0] for x in s_]), worst_t=tint([x[1] for x in s_]))
    ratios = {}
    for b in (seeds if dim == '2d' else []):            # 3D spread ratios: the gl64 panel rows (reported in the e2-3d files)
        r = new[b]
        if not ok(r):
            continue
        for k, v in r['h_acc_r'].items():
            for tr, x in v.items():
                if isinstance(x, dict) and x.get('median_paired_change') is not None:
                    ratios.setdefault(f'{k}|{tr}', {})[b] = x['median_paired_change']
    sr = {}
    for kk, v in ratios.items():
        kind, mesh, sc = kk.split('|')[:3]
        lo = int(kk.split('|')[3].split('->')[0])
        meds = [spread.get(f'{mesh}|R{lo}|{kind}|LSPG_{sc}_1', {}).get(s, (None,))[0] for s in seeds]
        meds = [m_ for m_ in meds if m_ is not None]
        num = (max(meds) - min(meds)) if len(meds) >= 2 else None
        den = float(np.median([abs(x) for x in v.values()])) if v else None
        if num is None or den is None:
            sr[kk] = None
        elif den == 0:
            sr[kk] = 'undefined' if num == 0 else 'inf'
        else:
            sr[kk] = num / den
    out = dict(dim=dim, seeds=seeds, blocked=blocked, rows=rows, spread=sp, spread_ratio=sr,
               counts={l: sum(1 for x in rows if x['label'] == l) for l in ('seed-robust', 'seed-dependent', 'inconclusive')})
    (HERE / 'checks' / f'e2-verdicts-{dim}.json').write_text(json.dumps(out, indent=1, default=float) + '\n')
    print(json.dumps(out['counts']))


if __name__ == '__main__':
