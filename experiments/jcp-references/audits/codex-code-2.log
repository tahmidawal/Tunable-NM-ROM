   117	    elif not checks['solver']:
   118	        outcome = 'solver-fail'
   119	    elif not checks['floor']:
   120	        outcome = 'unresolved-floor'
   121	    elif not checks['peclet']:
   122	        outcome = 'peclet-fail'
   123	    elif not checks['order']:
   124	        outcome = 'order-fail'
   125	    elif not checks['direction']:
   126	        outcome = 'direction-inconsistent'
   127	    else:
   128	        outcome = 'accepted'
   129	    eps_ok = [e for e in eps_t if e is not None]
   130	    return dict(levels=[lv['L'] for lv in levels], h=h, n0=n0, t0_dev=t0_dev,
   131	                d12=(d12[1:] / n0).tolist(), d23=(d23[1:] / n0).tolist(), p=p_t, eps_t=eps_t,
   132	                eps_ref=(max(eps_ok) if len(eps_ok) == 5 else None), c=c_t, tau=tau, peclet=peclet,
   133	                umax=[float(lv['umax']) for lv in levels], checks=checks, outcome=outcome)
