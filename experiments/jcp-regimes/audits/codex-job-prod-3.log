+               precision=os.environ['JAX_DEFAULT_MATMUL_PRECISION'], jax_version=jax.__version__,
+               model_sha256=model['sha'], rules_sha256=rules_sha, gates={}, rho={}, arms={}, fom={}, timing={},
+               microbench={}, sizes={}, complete=False,
