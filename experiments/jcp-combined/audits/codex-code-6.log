   100	def load_ref2d(ent, coh, c):
   101	    key = ent['dir']
   102	    if key not in _MAN:
   103	        man = json.loads((Path(ent['dir']) / ent['manifest']).read_text())
   104	        _MAN[key] = {(x['cohort'], x['case'], x['ref']): x for x in man['cases']}
   105	    out = {}
   106	    for tag, fn in ent['tags'].items():
   107	        z = np.load(Path(ent['dir']) / fn.format(cohort=coh, case=c))['f257']
   108	        m = _MAN[key][(coh, c, tag)]
   109	        assert m['accepted'] and sha(z) == m['f257_sha256'], ('reference file sha256', coh, c, tag)
   110	        out[tag] = z
   111	    for tag, comb in ent.get('derived', {}).items():
   112	        out[tag] = sum(w * out[t] for t, w in comb.items())
   113	    return out
