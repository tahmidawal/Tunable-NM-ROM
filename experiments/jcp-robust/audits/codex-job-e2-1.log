        z = _np.load(v256_out / f'R_R128_{lab}_{arm}.npz')
        rows[f'256|R128|{arm}'] = EA.reproduce(z['W'], [str(x) for x in z['case_ids']], [('p1', 'acc256', nm)], None, want)
    return dict(rows=rows, passed=all(v['passed'] for v in rows.values()))


