    81	def descriptors_2d(name, seed=None):
    82	    """(n, 5) array (cx, cy, w, a, nu)."""
    83	    if name in HISTORICAL[2]:
    84	        return np.concatenate([E2.params_draw(s, c) for s, c in HISTORICAL[2][name]])
