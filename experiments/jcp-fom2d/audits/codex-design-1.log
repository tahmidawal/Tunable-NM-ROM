   193	def ic_coefs_2d(desc, N, panels=256):
   194	    cx, cy, w, a, _ = [float(v) for v in desc]
   195	    X, W = composite_gl(panels)
   196	    gx = sine_integrals(np.exp(-(X - cx) ** 2 / (2 * w * w)), X, W, N)
   197	    gy = sine_integrals(np.exp(-(X - cy) ** 2 / (2 * w * w)), X, W, N)
   198	    return a * np.outer(gx, gy)
