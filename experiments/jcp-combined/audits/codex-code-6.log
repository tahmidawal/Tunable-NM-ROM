    43	def budget_runs(arms, conv='conv'):
    44	    """Deduplicated run list (role, form, scheme, dt, level) for one setting."""
    45	    R = []
    46	    add = lambda r: R.append(r) if r not in R else None
    47	    for x in arms:
    48	        f, s, h = x['form'], x['scheme'], DT0 * x['f']
    49	        add(('main', f, s, h, 'prod'))
    50	        add((conv, f, s, h, 'prod'))
    51	        add(('main', f, s, h, 'tight'))
    52	        if f == 'LSPG':
    53	            add(('main', 'GAL', s, h, 'tight'))
    54	        add(('main', f, 'BDF2', H8, 'prod'))
    55	        add(('main', f, s, h / 2, 'tight'))
    56	        add((conv, f, 'BDF2', H8, 'prod'))
    57	        add(('main', f, 'BDF2', H8, 'tight'))
    58	        if x.get('selected'):
    59	            add(('check', f, s, h, 'prod'))
    60	    for r in [(conv, 'GAL', 'BDF2', H8, 'tight'), (conv, 'GAL', 'BDF2', H16, 'tight'), (conv, 'GAL', 'BDF2', H8, 'tighter'),
    61	              (conv, 'GAL', 'BDF2', H16, 'tighter'), ('main', 'GAL', 'BDF2', H8, 'tight'), (conv, 'LSPG', 'BDF2', H8, 'tight')]:
    62	        add(r)
    63	    return R
