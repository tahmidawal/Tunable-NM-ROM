   205	def schedule(dt, scheme, ntol, ltol, horizon=0.25, spacing=0.05):
   206	    nstart, theta = SCHEMES[scheme]
   207	    steps, keep = int(round(horizon / dt)), int(round(spacing / dt))
   208	    assert abs(steps * dt - horizon) < 1e-12 and abs(keep * dt - spacing) < 1e-12, dt
   209	    assert n_stages(dt, scheme) <= NST
   210	    return dict(dt=jnp.float64(dt), nstart=jnp.int32(nstart), theta=jnp.float64(theta), steps=jnp.int32(steps),
   211	                keep_units=jnp.int32(2 * keep), ntol=jnp.float64(ntol), ltol=jnp.float64(ltol))
   212	
   213	
   214	def n_stages(dt, scheme):
   215	    nstart, _ = SCHEMES[scheme]
   216	    steps = int(round(0.25 / dt))
   217	    return nstart + steps - nstart // 2
