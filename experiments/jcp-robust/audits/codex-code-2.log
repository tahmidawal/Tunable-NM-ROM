     1	#!/bin/bash
     2	# jcp-robust (copied from jcp-dims; namespace jcp-robust, prefix jr_, reservation = GPUs x time limit): submit ONE staged attempt. Refuses if jr_<attempt> is queued or its remote dir exists, if the lane has
     3	# >= 3 jobs or the account >= 8 jobs (campaign cap), or if the atomic GPU-hour reservation (DESIGN A1.11, A2.6) fails.
     4	# The reserved hours are the sbatch --time limit read from run.sbatch (checked against RESERVATION.json).
     5	# squeue before and after (duplicate-submit rule).
     6	set -euo pipefail
     7	A="$1"; [[ "$A" =~ ^[a-zA-Z0-9]+$ ]]
     8	PY=/home/tahmid/Dev/.venv/bin/python
     9	LANE=$(cd "$(dirname "$0")/.." && pwd)
    10	NS=/cluster/tufts/paralab/tawal01/jcp-robust
    11	LOCAL="$LANE/runs/$A"
    12	[ -f "$LOCAL/run.sbatch" ]
    13	exec 9>"$LANE/runs/SUBMIT.lock"; flock 9          # one lane submission at a time: cap checks + reservation + sbatch
    14	TL=$(grep -oP '(?<=#SBATCH --time=)\S+' "$LOCAL/run.sbatch")
    15	NG=$(grep -oP '(?<=#SBATCH --gres=gpu:)\S+' "$LOCAL/run.sbatch" | awk -F: '{print $2}')
    16	HOURS=$("$PY" -c "h,m,s='$TL'.split(':');print((int(h)+int(m)/60+int(s)/3600)*int('$NG'))")
    17	RH=$("$PY" -c "import json;print(json.load(open('$LOCAL/RESERVATION.json'))['time_limit_hours'])")
    18	"$PY" -c "import sys; sys.exit(0 if abs($HOURS-$RH)<1e-9 else 1)" || { echo "time limit $HOURS != reservation $RH"; exit 7; }
    19	Q=$(timeout 60 ssh -o ConnectTimeout=20 tufts-login 'squeue -u $USER -h -o "%i %j %T"')
    20	NLANE=$(echo "$Q" | awk '$2 ~ /^jr_/' | grep -c . || true)
    21	NALL=$(echo "$Q" | grep -c . || true)
    22	echo "--- squeue before (lane=$NLANE account=$NALL)"; echo "$Q"
    23	if echo "$Q" | awk '{print $2}' | grep -qx "jr_$A"; then echo "jr_$A already queued: refusing"; exit 3; fi
    24	[ "$NLANE" -lt 3 ] || { echo "lane cap 3 reached"; exit 4; }
    25	[ "$NALL" -lt 8 ] || { echo "campaign cap 8 reached"; exit 5; }
    26	"$PY" "$LANE/ledger.py" reserve "$A" "$HOURS" || { echo "GPU-hour reservation refused"; exit 6; }
