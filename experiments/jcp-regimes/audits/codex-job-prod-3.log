diff --git a/experiments/jcp-regimes/runs/rom1024/experiments/jcp-regimes/vendor/quad3d/select_q.py b/experiments/jcp-regimes/runs/rom1024/experiments/jcp-regimes/vendor/quad3d/select_q.py
