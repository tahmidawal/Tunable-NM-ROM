   189	def V_clean(x):
   190	    if isinstance(x, dict):
   191	        return {str(k): V_clean(v) for k, v in x.items()}
   192	    if isinstance(x, (list, tuple)):
   193	        return [V_clean(v) for v in x]
   194	    if isinstance(x, (np.floating, float)):
   195	        return float(x) if np.isfinite(x) else None
   196	    if isinstance(x, (np.integer,)):
   197	        return int(x)
   198	    if isinstance(x, (np.bool_,)):
   199	        return bool(x)
   200	    if isinstance(x, np.ndarray):
   201	        return V_clean(x.tolist())
   202	    return x
