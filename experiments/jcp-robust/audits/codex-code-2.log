    43	def table_identity(cx, st, held, claimed):
    44	    """C-E1.2 / G-E1.1 (3D): the table built under `held` must carry the sha256 of the points of `claimed`."""
    45	    import rules3d_names as RN
    46	    X, w = cx.rules[claimed]
    47	    if st._d[held][1]['sha256'] != RN.sha_rule(X, w):
    48	        raise ValueError(f'rule identity mismatch: table {held} claimed as {claimed}')
    49	    return True
