   191	def write_case(outdir, arrays, meta, sealed, key, manifest):
   192	    stem = outdir / f"{meta['dim']}d" / meta['cohort'] / meta['kind'] / f"c{meta['case']:03d}"
   193	    stem.parent.mkdir(parents=True, exist_ok=True)
   194	    npz = SI.npz_bytes(**arrays)
   195	    js = json.dumps(V_clean(meta), indent=1).encode()
   196	    if sealed:
   197	        for suffix, data in (('.npz.enc', npz), ('.json.enc', js)):
   198	            blob = SI.encrypt(data, key)
   199	            assert SI.decrypt(blob, key) == data
   200	            atomic_write(str(stem) + suffix, blob)
   201	            manifest.append(dict(file=str(stem.relative_to(outdir)) + suffix, plain=SI.sha(data), cipher=SI.sha(blob)))
   202	    else:
   203	        atomic_write(str(stem) + '.npz', npz)
   204	        atomic_write(str(stem) + '.json', js)       # json last: its presence marks a completed case
   205	        manifest.append(dict(file=str(stem.relative_to(outdir)) + '.npz', sha256=SI.sha(npz)))
   206	        manifest.append(dict(file=str(stem.relative_to(outdir)) + '.json', sha256=SI.sha(js)))
