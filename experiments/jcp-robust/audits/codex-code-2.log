    78	def parse_key(k):
    79	    p = k.split('|')
    80	    if p[0] in ('fs', 'fsp'):
    81	        return (p[0], p[1], canon_dt(p[2]), int(p[3][1:]))
    82	    if p[0] == 'qn':
    83	        kr = 0 if p[3] == 'kinf' else int(p[3][1:])
    84	        return ('qn', p[1], canon_dt(p[2]), kr) + ((p[4],) if len(p) > 4 else ())
    85	    if p[0] == 'ad':
    86	        return ('ad', p[2], canon_dt(p[3]), p[4])
    87	    raise KeyError(k)
