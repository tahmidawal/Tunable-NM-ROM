    20	
    21	def make_ps_query(N, dt, Mc=32):
    22	    keep = int(round(0.05 / dt))
    23	    assert abs(keep * dt - 0.05) < 1e-12, dt
    24	    S_lat = PS.lattice_S(N, 64)
    25	
    26	    def step(v, co):
    27	        Nv, _ = PS.nonlinear(v, N, 3)
    28	        a = co['E2'] * v + co['Q'] * Nv
    29	        Na, _ = PS.nonlinear(a, N, 3)
    30	        b = co['E2'] * v + co['Q'] * Na
    31	        Nb, _ = PS.nonlinear(b, N, 3)
    32	        c = co['E2'] * a + co['Q'] * (2 * Nb - Nv)
    33	        Nc, _ = PS.nonlinear(c, N, 3)
    34	        return co['E'] * v + Nv * co['f1'] + 2 * (Na + Nb) * co['f2'] + Nc * co['f3']
    35	
    36	    def query(b0, nu, S):
    37	        co = PS.etdrk4_coefs(lin_eig_j(N, nu), dt, Mc)
    38	
    39	        def interval(v, _):
    40	            v = jax.lax.fori_loop(0, keep, lambda i, x: step(x, co), v)
    41	            return v, PS.synth_lattice(v, S, 3)
    42	        v, lats = jax.lax.scan(interval, b0, None, length=5)
    43	        return jnp.concatenate((PS.synth_lattice(b0, S, 3)[None], lats))     # (6, 63^3)
    44	    q = jax.jit(query)
    45	    return lambda b0, nu: q(b0, nu, S_lat)
    46	
    47	
    48	def ic(tab, j, N):
    49	    return jnp.asarray(PS.ic_coefs_3d(tab, j, N))
    50	
    51	
    52	def gate(tab, cases=(0, 1), N=32, dt=0.01):
    53	    out = {}
    54	    q = make_ps_query(N, dt)
    55	    q2 = make_ps_query(N, dt / 2)
    56	    ref = PS.make_ps(N, 3)
    57	    for j in cases:
    58	        b0, nu = ic(tab, j, N), float(tab['nu'][j])
    59	        a = np.asarray(q(b0, nu))
    60	        r = ref(np.asarray(b0), nu, dt, PS.lattice_S(N, 64))['lat']
    61	        h = np.asarray(q2(b0, nu))
    62	        out[j] = dict(rel=float(np.abs(a - r).max() / np.abs(r).max()), half_dt_diff=float(np.abs(h - a).max() / np.abs(r).max()))
    63	    out['pass'] = all(v['rel'] <= 1e-12 for k, v in out.items() if k != 'pass')
    64	    out['control_fires'] = all(v['half_dt_diff'] > 1e-9 for k, v in out.items() if k not in ('pass',))
    65	    return out

