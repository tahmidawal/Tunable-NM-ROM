@@ -0,0 +1,4796 @@
+{
+ "rule": "DESIGN.md sections 6-7, R1, R2 (select_q.py)",
+ "refined": "results/refined-val.json",
+ "frozen": true,
+ "cohort_seed": 923801,
+ "refined_sha256": "37266495dbe86becb79126f0eb9e00c5df47e176b00611711e00d1013d6d6589",
+ "meshes": {
+  "65": {
+   "job_id": "4732813",
+   "gpu": "NVIDIA H200",
+   "commit": "2c86213a6e345fe72b77ae723c73732a1b12f3f8",
+   "gates": {
+    "table": true,
+    "G1": true,
+    "G2": true,
+    "G3": true,
+    "reference": true,
+    "G4": true,
+    "timing": true,
+    "timing_neighbour_untested": []
+   },
+   "gate_values": {
+    "gram_condition": 1.000000000000512,
+    "tensor_vs_direct": 2.7053616460477073e-16,
+    "G1_derivative_vs_fd": 1.318580370885292e-07,
+    "G2_meshnodes_offmesh_vs_tensor": 7.95252248386576e-16,
+    "G3_jacobian_vs_jacfwd": 0.0,
+    "G3_adv_half_Jc": 1.0515025779005894e-15,
+    "G4_solver_vs_vendor_fields": 0.0,
+    "G4_solver_vs_vendor_coefs": 0.0,
+    "G4_iterations_reasons_equal": true,
+    "reference_residual": 9.900432652311435e-11,
+    "timing_drift_worst": 1.0238915517099672,
+    "timing_drift_pass": true,
+    "timing_neighbour_ratio": 1.0167971164360254,
