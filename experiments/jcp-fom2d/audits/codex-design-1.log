   177	def composite_gl(panels, pts=32):
   178	    """Composite Gauss-Legendre on [0, 1]: `panels` equal panels x `pts` points."""
   179	    x, w = np.polynomial.legendre.leggauss(pts)
   180	    edges = np.arange(panels) / panels
   181	    X = (edges[:, None] + (x[None, :] + 1) / (2 * panels)).ravel()
   182	    W = np.tile(w / (2 * panels), panels)
   183	    return X, W
